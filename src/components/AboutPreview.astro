---
import { aboutPreviewContent } from '../data/homepage';
---

<section id="about" class="about-section section-spacing" aria-labelledby="about-heading">
  <div class="container">
    <div class="about-panel">
      <div class="about-narrative">
        <span class="eyebrow">{aboutPreviewContent.eyebrow}</span>
        <h2 id="about-heading" class="about-heading">{aboutPreviewContent.heading}</h2>
        {aboutPreviewContent.paragraphs.map((p) => <p class="about-copy">{p}</p>)}
      </div>

      <div class="about-principles">
        <h3 class="principles-title">Our Approach</h3>
        <ul class="principles-list">
          {aboutPreviewContent.principles.map((item) => <li class="principle-item">{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-panel { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); background-color: var(--color-ivory-elevated); border: 1px solid var(--color-border-green); border-radius: var(--radius-lg); padding: clamp(1.5rem, 4vw, 3rem); box-shadow: var(--shadow-card); }
  .about-heading { font-size: var(--text-2xl); color: var(--color-forest-deep); margin-bottom: var(--space-sm); }
  .about-copy { font-size: var(--text-base); color: var(--color-charcoal); margin-bottom: var(--space-sm); }
  .about-copy:last-child { margin-bottom: 0; }
  .about-principles { background-color: var(--color-sage-card); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-md); padding: var(--space-md); align-self: center; }
  .principles-title { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-teal); margin-bottom: var(--space-sm); }
  .principles-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .principle-item { position: relative; padding-left: 1.15rem; font-size: var(--text-sm); color: var(--color-charcoal); }
  .principle-item::before { content: ''; position: absolute; left: 0; top: 0.55rem; width: 0.45rem; height: 0.45rem; border-radius: 999px; background-color: var(--color-amber); }

  @media (min-width: 54rem) {
    .about-panel { grid-template-columns: 1.35fr 0.95fr; gap: var(--space-xl); }
  }
</style>