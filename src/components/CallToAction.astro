---
import { Image } from 'astro:assets';
import { ctaContent } from '../data/homepage';
import ctaImage from '../assets/images/background/cta-sunset-bg.jpg';
---

<section id="plan-a-trip" class="cta-section section-spacing" aria-labelledby="cta-heading">
  <div class="container">
    <div class="cta-panel">
      <Image
        src={ctaImage}
        alt=""
        widths={[720, 1080, 1600]}
        sizes="(max-width: 768px) 92vw, 1180px"
        loading="lazy"
        decoding="async"
        class="cta-image"
      />
      <div class="cta-shade" aria-hidden="true"></div>
      <div class="cta-copy">
        <span class="eyebrow cta-eyebrow">{ctaContent.eyebrow}</span>
        <h2 id="cta-heading" class="cta-heading">{ctaContent.heading}</h2>
        <p class="cta-lead">{ctaContent.intro}</p>
        <a href="#destinations" class="btn btn-amber">Explore destinations <span aria-hidden="true">↗</span></a>
        <p class="channel-note">{ctaContent.unconfiguredChannelNotice}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section { padding-top: var(--space-xl); padding-bottom: var(--space-xl); background: var(--color-ivory); }
  .cta-panel { position: relative; min-height: 27rem; overflow: hidden; isolation: isolate; background: var(--color-forest-deep); color: var(--color-ivory); }
  .cta-image { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 56%; }
  .cta-shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(12, 39, 35, 0.83) 0%, rgba(12, 39, 35, 0.5) 48%, rgba(12, 39, 35, 0.08) 100%); }
  .cta-copy { max-width: 42rem; padding: clamp(1.5rem, 5vw, 4rem); }
  .cta-eyebrow { color: #f0d39e; }
  .cta-heading { max-width: 12ch; color: var(--color-ivory); font-size: clamp(2.4rem, 5vw, 4.25rem); line-height: 1; letter-spacing: -0.03em; margin-bottom: var(--space-sm); }
  .cta-lead { max-width: 45ch; color: rgba(255, 255, 255, 0.88); font-size: var(--text-base); margin-bottom: var(--space-md); }
  .btn-amber { background: var(--color-amber); color: #1b2826; border: 1px solid var(--color-amber); }
  .btn-amber:hover { background: #edb560; border-color: #edb560; }
  .channel-note { margin: 1rem 0 0; color: rgba(255, 255, 255, 0.77); font-size: 0.75rem; }

  @media (max-width: 42rem) {
    .cta-panel { min-height: 31rem; }
    .cta-image { object-position: 62% center; }
    .cta-shade { background: linear-gradient(180deg, rgba(12, 39, 35, 0.38) 0%, rgba(12, 39, 35, 0.88) 65%); }
    .cta-copy { padding-top: 8rem; }
  }
</style>
