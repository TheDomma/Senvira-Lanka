---
import { Image } from 'astro:assets';
import { heroContent } from '../data/homepage';
import ellaImage from '../assets/images/destinations/ella-panorama.jpg';
import sigiriyaImage from '../assets/images/destinations/sigiriya-rock-entrance.jpg';
import southCoastImage from '../assets/images/destinations/down-south-panorama.jpg';

const heroPlaces = [
  { name: 'Ella', region: 'Hill country', image: ellaImage, alt: 'A train winding through the misty green hills near Ella.' },
  { name: 'Sigiriya', region: 'Cultural Triangle', image: sigiriyaImage, alt: 'Sigiriya Rock rising above the surrounding forest.' },
  { name: 'South Coast', region: 'Ocean side', image: southCoastImage, alt: 'A quiet cove along Sri Lanka’s southern coast.' },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <Image
    src={heroContent.image}
    alt={heroContent.imageAlt}
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
    class="hero-image"
  />
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="hero-eyebrow">{heroContent.eyebrow}</span>
      <h1 id="hero-heading">Come find your <em>own Sri Lanka.</em></h1>
      <p class="hero-description">
        Tea-covered highlands, ancient kingdoms and warm southern shores—brought together with time to truly see them.
      </p>
      <div class="hero-actions">
        <a href="/journeys/" class="hero-button hero-button-primary">
          <span>Start planning</span><span class="button-arrow" aria-hidden="true">↗</span>
        </a>
        <a href="/destinations/" class="hero-button hero-button-glass">
          <span>Explore destinations</span><span class="button-down" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <aside class="hero-places" aria-label="A few places to begin">
      <span class="places-label">A few places to begin</span>
      {heroPlaces.map((place, index) => (
        <a href={`/destinations/#${place.name.toLowerCase().replaceAll(' ', '-')}`} class="place-card">
          <Image
            src={place.image}
            alt={place.alt}
            widths={[128, 192, 256]}
            sizes="(max-width: 54rem) 28vw, 150px"
            loading="lazy"
            decoding="async"
            class="place-image"
          />
          <span class="place-shade" aria-hidden="true"></span>
          <span class="place-index">0{index + 1}</span>
          <span class="place-copy"><strong>{place.name}</strong><small>{place.region}</small></span>
          <span class="place-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </aside>

    <div class="hero-footnote">
      <span class="footnote-dot" aria-hidden="true"></span>
      <span>One island. A thousand ways to feel at home.</span>
    </div>
    <a href="#landscapes" class="scroll-cue"><span>Scroll to explore</span><span class="scroll-line" aria-hidden="true"></span></a>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; display: flex; min-height: max(44rem, 100svh); align-items: stretch; overflow: hidden; background: #0b2d24; color: var(--color-ivory); }
  .hero-image { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 54%; }
  .hero-shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(3, 24, 19, 0.78) 0%, rgba(4, 27, 21, 0.46) 47%, rgba(5, 28, 23, 0.18) 100%), linear-gradient(0deg, rgba(4, 24, 19, 0.63) 0%, transparent 34%, rgba(4, 22, 18, 0.17) 100%); }
  .hero-inner { position: relative; display: grid; width: min(100%, 84rem); min-height: inherit; grid-template-columns: minmax(0, 1fr) 12rem; align-items: center; column-gap: clamp(2rem, 6vw, 7rem); padding-top: 8rem; padding-bottom: 7.25rem; }
  .hero-copy { max-width: 56rem; padding-top: 1rem; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 0.62rem; margin-bottom: clamp(1rem, 2vw, 1.6rem); color: var(--color-gold-light); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.15em; line-height: 1.4; text-transform: uppercase; }
  .hero-eyebrow::before { content: ''; width: 0.42rem; height: 0.42rem; border-radius: 50%; background: var(--color-gold-light); box-shadow: 0 0 0 0.28rem rgba(231, 193, 104, 0.13); }
  .hero h1 { max-width: 11.5ch; margin: 0 0 clamp(1.2rem, 2.5vw, 1.8rem); color: #fbf8f0; font-size: clamp(3.8rem, 7.45vw, 7.3rem); font-weight: 500; letter-spacing: -0.055em; line-height: 0.92; text-wrap: balance; }
  .hero h1 em { color: var(--color-gold-light); font-weight: 500; }
  .hero-description { max-width: 38rem; margin: 0; color: rgba(250, 248, 240, 0.83); font-size: clamp(1rem, 1.25vw, 1.15rem); line-height: 1.75; text-wrap: pretty; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: clamp(1.6rem, 3vw, 2.35rem); }
  .hero-button { display: inline-flex; min-height: 3.35rem; align-items: center; justify-content: center; gap: 1.1rem; padding: 0.42rem 0.48rem 0.42rem 1.2rem; border: 1px solid transparent; border-radius: 999px; font-size: 0.82rem; font-weight: 600; text-decoration: none; transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease; }
  .hero-button:hover { transform: translateY(-2px); }
  .hero-button-primary { background: var(--color-gold-light); color: #15271f; }
  .hero-button-primary:hover { background: #f1d88f; }
  .button-arrow, .button-down { display: grid; width: 2.3rem; height: 2.3rem; place-items: center; border-radius: 50%; font-size: 0.95rem; }
  .button-arrow { background: rgba(13, 43, 34, 0.12); }
  .hero-button-glass { padding-left: 1.2rem; border-color: rgba(246, 244, 235, 0.3); background: rgba(246, 244, 235, 0.1); color: var(--color-ivory); backdrop-filter: blur(10px); }
  .hero-button-glass:hover { border-color: rgba(246, 244, 235, 0.58); background: rgba(246, 244, 235, 0.17); }
  .button-down { border: 1px solid rgba(246, 244, 235, 0.25); }

  .hero-places { display: grid; gap: 0.65rem; align-self: center; padding-top: 2rem; }
  .places-label { margin: 0 0 0.15rem 0.15rem; color: rgba(250, 248, 240, 0.75); font-size: 0.63rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
  .place-card { position: relative; display: flex; min-height: 6.1rem; align-items: flex-end; overflow: hidden; padding: 0.85rem; border: 1px solid rgba(246, 244, 235, 0.29); border-radius: 1.1rem; color: white; text-decoration: none; box-shadow: 0 8px 28px rgba(0, 0, 0, 0.13), inset 0 1px 0 rgba(255,255,255,0.16); transition: transform 220ms ease, border-color 220ms ease; }
  .place-card:hover { transform: translateX(-4px); border-color: rgba(246, 244, 235, 0.7); }
  .place-image { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .place-shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(0deg, rgba(3, 23, 18, 0.8), rgba(3, 23, 18, 0.02) 75%); }
  .place-index { position: absolute; top: 0.58rem; right: 0.65rem; color: rgba(255,255,255,0.75); font-size: 0.58rem; font-weight: 600; letter-spacing: 0.1em; }
  .place-copy { display: grid; gap: 0.08rem; }
  .place-copy strong { font-family: var(--font-serif); font-size: 1.12rem; font-weight: 600; line-height: 1.1; }
  .place-copy small { color: rgba(255,255,255,0.8); font-size: 0.59rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .place-arrow { position: absolute; right: 0.75rem; bottom: 0.82rem; display: grid; width: 1.75rem; height: 1.75rem; place-items: center; border: 1px solid rgba(255,255,255,0.42); border-radius: 50%; background: rgba(7, 35, 28, 0.3); font-size: 0.8rem; backdrop-filter: blur(8px); }

  .hero-footnote { position: absolute; bottom: 2.2rem; left: 0; display: inline-flex; align-items: center; gap: 0.62rem; color: rgba(250, 248, 240, 0.78); font-size: 0.73rem; letter-spacing: 0.02em; }
  .footnote-dot { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: var(--color-gold-light); }
  .scroll-cue { position: absolute; right: 0; bottom: 2.05rem; display: inline-flex; align-items: center; gap: 0.9rem; color: rgba(250, 248, 240, 0.78); font-size: 0.7rem; text-decoration: none; }
  .scroll-line { position: relative; display: inline-block; width: 3.25rem; height: 1px; background: rgba(250, 248, 240, 0.55); }
  .scroll-line::after { position: absolute; top: -0.18rem; right: 0; width: 0.38rem; height: 0.38rem; border-right: 1px solid white; border-bottom: 1px solid white; content: ''; transform: rotate(45deg); }

  @media (max-width: 54rem) {
    .hero { min-height: max(48rem, 100svh); }
    .hero-image { object-position: 48% center; }
    .hero-shade { background: linear-gradient(90deg, rgba(3, 24, 19, 0.62), rgba(4, 27, 21, 0.22)), linear-gradient(0deg, rgba(4, 24, 19, 0.79), rgba(4, 22, 18, 0.08) 74%); }
    .hero-inner { grid-template-columns: minmax(0, 1fr); align-content: center; row-gap: 1.5rem; padding-top: 8.5rem; padding-bottom: 8rem; }
    .hero-copy { padding-top: 0; }
    .hero h1 { max-width: 10ch; font-size: clamp(3.8rem, 12vw, 6rem); }
    .hero-description { max-width: 34rem; }
    .hero-places { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; align-self: end; padding-top: 0.6rem; }
    .places-label { grid-column: 1 / -1; }
    .place-card { min-height: 5.6rem; padding: 0.6rem; border-radius: 0.8rem; }
    .place-copy strong { font-size: 0.95rem; }
    .place-copy small { font-size: 0.5rem; letter-spacing: 0.04em; }
    .place-index, .place-arrow { display: none; }
    .hero-footnote { bottom: 2rem; font-size: 0.67rem; }
    .scroll-cue { bottom: 1.9rem; font-size: 0; }
    .scroll-line { width: 2.5rem; }
  }

  @media (max-width: 34rem) {
    .hero { min-height: max(47rem, 100svh); }
    .hero-inner { padding-top: 8rem; padding-bottom: 7.4rem; }
    .hero-eyebrow { max-width: 24rem; font-size: 0.6rem; letter-spacing: 0.12em; }
    .hero h1 { font-size: clamp(3.5rem, 14vw, 4.7rem); }
    .hero-description { font-size: 0.95rem; line-height: 1.6; }
    .hero-actions { gap: 0.5rem; }
    .hero-button { min-height: 3.1rem; gap: 0.55rem; padding-left: 0.9rem; font-size: 0.73rem; }
    .button-arrow, .button-down { width: 2rem; height: 2rem; }
    .hero-places { gap: 0.38rem; }
    .place-card { min-height: 5.1rem; padding: 0.5rem; }
    .place-copy strong { font-size: 0.88rem; }
    .place-copy small { font-size: 0.46rem; }
    .hero-footnote { max-width: calc(100% - 3rem); font-size: 0.62rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-button, .place-card { transition: none; }
  }
</style>
