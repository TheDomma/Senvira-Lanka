---
import { getImage, Image } from 'astro:assets';
import { heroContent } from '../data/homepage';
import sigiriyaImage from '../assets/images/gallery/sigiriya-aerial.jpg';
import kandyImage from '../assets/images/destinations/kandy-panorama.jpg';
import ellaImage from '../assets/images/destinations/ella-panorama.jpg';
import coastImage from '../assets/images/destinations/down-south-panorama.jpg';
import wildlifeImage from '../assets/images/destinations/elephants-bathing.jpg';

const heroPlaces = [
  { id: 'sigiriya', name: 'Sigiriya', region: 'Cultural Triangle', image: sigiriyaImage, alt: 'Sigiriya Rock above a misty green forest.' },
  { id: 'kandy', name: 'Kandy', region: 'Hill Capital', image: kandyImage, alt: 'Kandy and the green hills around its lake.' },
  { id: 'ella', name: 'Ella', region: 'Hill Country', image: ellaImage, alt: 'A train crossing a stone viaduct in Ella’s green highlands.' },
  { id: 'south-coast', name: 'South Coast', region: 'Ocean side', image: coastImage, alt: 'The palm-lined southern coast of Sri Lanka.' },
  { id: 'wildlife', name: 'Wildlife', region: 'National parks', image: wildlifeImage, alt: 'An Asian elephant standing in an open grassland.' },
];

const heroBackground = await getImage({ src: heroContent.image, width: 1600, format: 'webp', quality: 80 });
const heroPlacesWithBackground = await Promise.all(
  heroPlaces.map(async (place) => ({
    ...place,
    background: (await getImage({ src: place.image, width: 1600, format: 'webp', quality: 80 })).src,
  })),
);
---

<section class="hero" aria-labelledby="hero-heading">
  <img
    src={heroBackground.src}
    alt={heroContent.imageAlt}
    width="1600"
    height="1067"
    decoding="async"
    fetchpriority="high"
    class="hero-image"
    data-hero-image
  />
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="hero-eyebrow">{heroContent.eyebrow}</span>
      <h1 id="hero-heading">Plan a journey that <em>feels like yours.</em></h1>
      <p class="hero-description">{heroContent.supportingCopy}</p>
      <div class="hero-actions">
        <a href="/destinations/" class="hero-button hero-button-primary">Explore places <span aria-hidden="true">↗</span></a>
        <a href="/journeys/" class="hero-button hero-button-secondary">Plan your trip <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="hero-place-picker" aria-label="Change the featured landscape">
      <span class="picker-heading">A few places to begin</span>
      <div class="hero-place-list">
        {heroPlacesWithBackground.map((place, index) => (
          <button
            type="button"
            class="hero-place"
            data-hero-select
            data-hero-src={place.background}
            data-hero-alt={place.alt}
            data-hero-region={`${place.region} · Sri Lanka`}
            aria-pressed="false"
          >
            <Image
              src={place.image}
              alt=""
              widths={[96, 144, 192]}
              sizes="(max-width: 54rem) 56px, 64px"
              loading="lazy"
              decoding="async"
              class="hero-place-image"
            />
            <span class="hero-place-copy"><small>{place.region}</small><strong>{place.name}</strong></span>
            <span class="hero-place-number" aria-hidden="true">0{index + 1}</span>
          </button>
        ))}
      </div>
    </aside>

    <div class="hero-footline">
      <span class="hero-location"><span class="location-mark" aria-hidden="true"></span><span data-hero-location>Central Highlands · Sri Lanka</span></span>
      <a href="#discover" class="scroll-cue">Discover the island <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<script>
  const heroImage = document.querySelector<HTMLImageElement>('[data-hero-image]');
  const heroLocation = document.querySelector<HTMLElement>('[data-hero-location]');
  const heroSelectors = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hero-select]'));

  const selectHeroPlace = (selector: HTMLButtonElement) => {
    const nextSrc = selector.dataset.heroSrc;
    if (!nextSrc || !heroImage) return;

    heroSelectors.forEach((item) => item.setAttribute('aria-pressed', String(item === selector)));
    heroImage.classList.add('is-transitioning');

    const nextImage = new window.Image();
    nextImage.onload = () => {
      heroImage.src = nextImage.src;
      heroImage.alt = selector.dataset.heroAlt || '';
      if (heroLocation && selector.dataset.heroRegion) heroLocation.textContent = selector.dataset.heroRegion;
      requestAnimationFrame(() => heroImage.classList.remove('is-transitioning'));
    };
    nextImage.onerror = () => heroImage.classList.remove('is-transitioning');
    nextImage.src = nextSrc;
  };

  heroSelectors.forEach((selector) => {
    selector.addEventListener('pointerenter', () => selectHeroPlace(selector));
    selector.addEventListener('focus', () => selectHeroPlace(selector));
    selector.addEventListener('click', () => selectHeroPlace(selector));
  });
</script>

<style>
  .hero { position: relative; isolation: isolate; min-height: max(42rem, 100svh); overflow: hidden; background: #10291f; color: var(--color-ivory); }
  .hero-image { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 54%; filter: saturate(0.78) brightness(0.84); opacity: 1; transition: opacity 260ms ease; }
  .hero-image.is-transitioning { opacity: 0.46; }
  .hero-shade { position: absolute; z-index: 1; inset: 0; background: linear-gradient(90deg, rgba(5, 25, 20, 0.78) 0%, rgba(5, 25, 20, 0.46) 49%, rgba(5, 25, 20, 0.13) 100%), linear-gradient(0deg, rgba(5, 25, 20, 0.68) 0%, transparent 32%, rgba(5, 25, 20, 0.19) 100%); }
  .hero-inner { position: relative; z-index: 2; display: grid; width: min(100%, 88rem); min-height: inherit; grid-template-columns: minmax(0, 1fr) minmax(10rem, 13rem); align-items: center; gap: clamp(1.5rem, 5vw, 5rem); padding-top: 8rem; padding-bottom: 7.5rem; }
  .hero-copy { max-width: 52rem; padding-top: 1.5rem; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 0.65rem; margin-bottom: clamp(1.1rem, 2vw, 1.6rem); color: #f0d48d; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; line-height: 1.4; text-transform: uppercase; }
  .hero-eyebrow::before { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: #e9c66f; content: ''; }
  .hero h1 { max-width: 10.5ch; margin: 0 0 clamp(1.15rem, 2.4vw, 1.8rem); color: #fbf8f0; font-size: clamp(3.65rem, 7.5vw, 7.1rem); font-weight: 500; letter-spacing: -0.055em; line-height: 0.94; text-wrap: balance; }
  .hero h1 em { color: #f0d48d; font-weight: 500; }
  .hero-description { max-width: 37rem; margin: 0; color: rgba(250, 248, 240, 0.86); font-size: clamp(1rem, 1.23vw, 1.13rem); line-height: 1.75; text-wrap: pretty; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: clamp(1.6rem, 3vw, 2.35rem); }
  .hero-button { display: inline-flex; min-height: 3.25rem; align-items: center; justify-content: center; gap: 1.3rem; padding: 0.6rem 1.1rem; border: 1px solid transparent; border-radius: 0.55rem; font-size: 0.8rem; font-weight: 650; text-decoration: none; transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease; }
  .hero-button:hover { transform: translateY(-2px); }
  .hero-button span { font-size: 1rem; }
  .hero-button-primary { background: var(--color-gold-light); color: #15271f; }
  .hero-button-primary:hover { background: #f1d88f; }
  .hero-button-secondary { border-color: rgba(246, 244, 235, 0.5); background: rgba(8, 31, 25, 0.24); color: var(--color-ivory); backdrop-filter: blur(8px); }
  .hero-button-secondary:hover { border-color: rgba(246, 244, 235, 0.8); background: rgba(8, 31, 25, 0.46); }

  .hero-place-picker { display: grid; gap: 0.55rem; align-self: center; padding-top: 2.5rem; }
  .hero-place-list { display: grid; gap: 0.55rem; }
  .picker-heading { margin: 0 0 0.18rem 0.15rem; color: rgba(250, 248, 240, 0.78); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
  .hero-place { display: grid; min-height: 4.45rem; grid-template-columns: 3.55rem minmax(0, 1fr) auto; align-items: center; gap: 0.65rem; padding: 0.38rem 0.58rem 0.38rem 0.38rem; border: 1px solid rgba(246, 244, 235, 0.26); border-radius: 1.05rem; background: rgba(9, 34, 28, 0.35); color: #fbf8f0; text-align: left; cursor: pointer; backdrop-filter: blur(12px) saturate(120%); transition: border-color 200ms ease, background-color 200ms ease, transform 200ms ease; }
  .hero-place:hover, .hero-place[aria-pressed="true"] { transform: translateX(-0.2rem); border-color: rgba(240, 212, 141, 0.88); background: rgba(11, 48, 39, 0.72); }
  .hero-place-image { width: 3.55rem; height: 3.55rem; border-radius: 0.78rem; object-fit: cover; }
  .hero-place-copy { display: grid; min-width: 0; gap: 0.15rem; }
  .hero-place-copy small { overflow: hidden; color: rgba(250, 248, 240, 0.67); font-size: 0.53rem; text-overflow: ellipsis; white-space: nowrap; }
  .hero-place-copy strong { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 600; line-height: 1.08; }
  .hero-place-number { align-self: start; padding-top: 0.2rem; color: #f0d48d; font-family: var(--font-serif); font-size: 0.68rem; }

  .hero-footline { position: absolute; right: clamp(1.125rem, 4vw, 2.5rem); bottom: 1.8rem; left: clamp(1.125rem, 4vw, 2.5rem); display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 1px solid rgba(250, 248, 240, 0.28); }
  .hero-location, .scroll-cue { display: inline-flex; align-items: center; gap: 0.55rem; color: rgba(250, 248, 240, 0.82); font-size: 0.68rem; letter-spacing: 0.06em; text-decoration: none; }
  .hero-location { text-transform: uppercase; }
  .location-mark { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: var(--color-gold-light); }
  .scroll-cue span { color: var(--color-gold-light); font-size: 0.95rem; transition: transform 180ms ease; }
  .scroll-cue:hover span { transform: translateY(3px); }

  @media (max-width: 64rem) {
    .hero-inner { grid-template-columns: minmax(0, 1fr) minmax(9rem, 11rem); gap: 1.5rem; }
    .hero-place { grid-template-columns: 3rem minmax(0, 1fr) auto; min-height: 3.9rem; gap: 0.5rem; }
    .hero-place-image { width: 3rem; height: 3rem; }
    .hero-place-copy strong { font-size: 0.95rem; }
  }

  @media (max-width: 54rem) {
    .hero { min-height: max(49rem, 100svh); }
    .hero-image { object-position: 55% center; }
    .hero-shade { background: linear-gradient(90deg, rgba(5, 25, 20, 0.68), rgba(5, 25, 20, 0.2)), linear-gradient(0deg, rgba(5, 25, 20, 0.79), rgba(5, 22, 18, 0.08) 80%); }
    .hero-inner { grid-template-columns: minmax(0, 1fr); align-content: center; gap: 1.5rem; padding-top: 8rem; padding-bottom: 7rem; }
    .hero-copy { padding-top: 0; }
    .hero h1 { max-width: 9.5ch; font-size: clamp(3.7rem, 11vw, 6rem); }
    .hero-place-picker { padding-top: 0; }
    .hero-place-list { grid-auto-columns: minmax(8.5rem, 1fr); grid-auto-flow: column; grid-template-rows: auto; gap: 0.5rem; overflow-x: auto; margin-inline: calc(-1 * clamp(1.125rem, 4vw, 2.5rem)); padding: 0.15rem clamp(1.125rem, 4vw, 2.5rem) 0.4rem; scroll-snap-type: x proximity; scrollbar-width: none; }
    .hero-place-list::-webkit-scrollbar { display: none; }
    .hero-place { min-height: 3.85rem; grid-template-columns: 2.75rem minmax(0, 1fr); scroll-snap-align: start; }
    .hero-place-image { width: 2.75rem; height: 2.75rem; border-radius: 0.65rem; }
    .hero-place-number { display: none; }
    .hero-place-copy small { font-size: 0.49rem; }
    .hero-place-copy strong { font-size: 0.88rem; }
  }

  @media (max-width: 34rem) {
    .hero { min-height: max(46rem, 100svh); }
    .hero-image { object-position: 58% center; }
    .hero-inner { padding-top: 7rem; padding-bottom: 6.25rem; }
    .hero-eyebrow { max-width: 22rem; font-size: 0.61rem; letter-spacing: 0.13em; }
    .hero h1 { max-width: 11.5ch; font-size: clamp(3rem, 11vw, 3.9rem); line-height: 0.98; }
    .hero-description { font-size: 0.94rem; line-height: 1.65; }
    .hero-actions { gap: 0.55rem; }
    .hero-button { min-height: 3rem; gap: 0.8rem; padding-inline: 0.85rem; font-size: 0.73rem; }
    .hero-place-picker { gap: 0.4rem; }
    .hero-footline { bottom: 1.25rem; align-items: flex-start; }
    .hero-location, .scroll-cue { font-size: 0.58rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-button, .scroll-cue span, .hero-image, .hero-place { transition: none; }
  }
</style>
