---
import { siteConfig } from '../config/site';

const { headerEmblem, headerWordmark } = siteConfig.logos;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-lockup" aria-label={`${siteConfig.brandName} — Home`}>
      <span class="brand-emblem-wrap">
        <img
          src={headerEmblem.src}
          alt=""
          width="42"
          height="40"
          decoding="async"
          class="brand-emblem"
        />
      </span>
      <img
        src={headerWordmark.src}
        alt="Senvira Lanka"
        width="132"
        height="44"
        decoding="async"
        class="brand-wordmark"
      />
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-navigation"
      aria-label="Open navigation menu"
    >
      <span class="nav-toggle-text">Menu</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    </button>

    <nav id="site-navigation" class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {siteConfig.navigation.map((item) => (
          <li><a href={item.href} class="nav-link">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <details class="language-switcher">
        <summary class="language-trigger" aria-label="Choose a language. English is currently active.">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
            <path d="M3.5 12h17M12 3c2.1 2.3 3.1 5.3 3.1 9s-1 6.7-3.1 9c-2.1-2.3-3.1-5.3-3.1-9s1-6.7 3.1-9Z" stroke="currentColor" stroke-width="1.35" />
          </svg>
          <span>EN</span>
          <svg class="language-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="language-menu">
          <span class="language-menu-label">Language</span>
          <span class="language-current" aria-current="true"><span>English</span><small>Selected</small></span>
          <span class="language-upcoming"><span>Deutsch</span><small>Coming soon</small></span>
          <span class="language-upcoming"><span>Français</span><small>Coming soon</small></span>
          <span class="language-upcoming"><span>Nederlands</span><small>Coming soon</small></span>
        </div>
      </details>

      <a href="#contact" class="header-cta" aria-label="Find Senvira’s WhatsApp contact details">
        <svg class="header-chat-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20 11.4a7.7 7.7 0 0 1-8 7.6 8.4 8.4 0 0 1-3.3-.7L4 19.5l1.2-3.3A7.3 7.3 0 0 1 4 11.4a7.7 7.7 0 0 1 8-7.5 7.7 7.7 0 0 1 8 7.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M8.4 10.1h7.2M8.4 13.1h4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span class="header-cta-label">WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleButton = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const siteNav = document.querySelector<HTMLElement>('#site-navigation');

  if (toggleButton && siteNav) {
    const closeMenu = () => {
      toggleButton.setAttribute('aria-expanded', 'false');
      toggleButton.setAttribute('aria-label', 'Open navigation menu');
      siteNav.classList.remove('is-open');
    };

    toggleButton.addEventListener('click', () => {
      const isOpen = toggleButton.getAttribute('aria-expanded') === 'true';
      toggleButton.setAttribute('aria-expanded', String(!isOpen));
      toggleButton.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
      siteNav.classList.toggle('is-open', !isOpen);
    });

    siteNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && siteNav.classList.contains('is-open')) {
        closeMenu();
        toggleButton.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    width: 100%;
    border-bottom: 1px solid rgba(237, 241, 227, 0.2);
    background: rgba(7, 36, 30, 0.68);
    box-shadow: 0 8px 32px rgba(4, 20, 16, 0.12);
    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 88rem);
    min-height: 5.1rem;
    margin-inline: auto;
    gap: clamp(0.75rem, 2vw, 2rem);
    padding: 0.55rem clamp(1.125rem, 4vw, 2.5rem);
    color: var(--color-ivory);
  }

  .brand-lockup {
    display: inline-flex;
    min-width: max-content;
    align-items: center;
    gap: 0.62rem;
    text-decoration: none;
  }

  .brand-emblem-wrap {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(237, 241, 227, 0.42);
    border-radius: 50%;
    background: var(--color-ivory);
  }

  .brand-emblem { width: 2.25rem; height: 2.12rem; object-fit: contain; }
  .brand-wordmark { display: block; width: clamp(6.6rem, 11vw, 8rem); height: auto; object-fit: contain; }

  .site-nav { display: block; margin-inline: auto; }
  .nav-list { display: flex; align-items: center; gap: clamp(0.8rem, 1.55vw, 1.55rem); list-style: none; margin: 0; padding: 0; }
  .nav-link { display: inline-block; color: rgba(246, 244, 235, 0.88); font-size: 0.77rem; font-weight: 500; text-decoration: none; white-space: nowrap; transition: color 180ms ease; }
  .nav-link:hover, .nav-link:focus-visible { color: var(--color-gold-light); }

  .header-actions { display: flex; flex: 0 0 auto; align-items: center; gap: 0.55rem; }
  .language-switcher { position: relative; }
  .language-trigger {
    display: inline-flex;
    min-height: 2.6rem;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    padding: 0.55rem 0.72rem;
    border: 1px solid rgba(246, 244, 235, 0.08);
    border-radius: 999px;
    background: rgba(246, 244, 235, 0.08);
    color: var(--color-ivory);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    list-style: none;
  }
  .language-trigger::-webkit-details-marker { display: none; }
  .language-switcher[open] .language-trigger { background: rgba(246, 244, 235, 0.15); }
  .language-chevron { transition: transform 180ms ease; }
  .language-switcher[open] .language-chevron { transform: rotate(180deg); }
  .language-menu {
    position: absolute;
    top: calc(100% + 0.7rem);
    right: 0;
    display: grid;
    width: 13rem;
    gap: 0.2rem;
    padding: 0.85rem;
    border: 1px solid rgba(246, 244, 235, 0.17);
    border-radius: 1.1rem;
    background: rgba(8, 37, 31, 0.96);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(18px);
  }
  .language-menu-label { padding: 0.15rem 0.45rem 0.4rem; color: var(--color-gold-light); font-size: 0.64rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
  .language-current, .language-upcoming { display: flex; justify-content: space-between; gap: 0.5rem; padding: 0.5rem 0.45rem; border-radius: 0.55rem; font-size: 0.8rem; }
  .language-current { background: rgba(246, 244, 235, 0.1); color: var(--color-ivory); }
  .language-upcoming { color: rgba(246, 244, 235, 0.55); }
  .language-menu small { color: rgba(246, 244, 235, 0.45); font-size: 0.64rem; }

  .header-cta {
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 0.55rem;
    background: #168b52;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 180ms ease, transform 180ms ease;
  }
  .header-cta:hover { background: #117342; transform: translateY(-1px); }
  .header-chat-icon { flex: 0 0 auto; }

  .nav-toggle {
    display: none;
    min-height: 2.6rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid rgba(246, 244, 235, 0.2);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ivory);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .nav-toggle svg { display: block; flex: 0 0 auto; }

  @media (max-width: 69rem) {
    .header-inner { gap: 0.8rem; }
    .site-nav { margin-right: auto; }
    .nav-list { gap: 0.8rem; }
    .nav-link { font-size: 0.7rem; }
    .brand-wordmark { width: 6.5rem; }
  }

  @media (max-width: 54rem) {
    .header-inner { min-height: 4.35rem; padding: 0.4rem 1rem; gap: 0.5rem; }
    .brand-emblem-wrap { width: 2.45rem; height: 2.45rem; }
    .brand-emblem { width: 1.95rem; height: 1.85rem; }
    .brand-lockup { gap: 0.45rem; }
    .brand-wordmark { width: 6.1rem; }
    .site-nav { display: none; position: absolute; top: calc(100% + 0.55rem); left: 0; right: 0; margin: 0; padding: 0.8rem; border: 1px solid rgba(246, 244, 235, 0.18); border-radius: 1.25rem; background: rgba(7, 36, 30, 0.96); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25); backdrop-filter: blur(20px); }
    .site-nav.is-open { display: block; }
    .nav-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.2rem; }
    .nav-link { display: block; padding: 0.72rem 0.8rem; border-radius: 0.65rem; font-size: 0.85rem; }
    .nav-link:hover { background: rgba(246, 244, 235, 0.08); }
    .nav-toggle { display: inline-flex; }
    .header-actions { margin-left: auto; }
    .header-cta { min-height: 2.6rem; width: 2.6rem; justify-content: center; padding: 0; }
    .header-cta-label { display: none; }
  }

  @media (max-width: 24rem) {
    .nav-toggle-text { display: none; }
    .nav-toggle { width: 2.7rem; height: 2.7rem; flex: 0 0 2.7rem; justify-content: center; padding: 0.4rem; }
    .language-trigger { width: 2.35rem; min-height: 2.4rem; padding-inline: 0; }
    .language-trigger svg:first-child { width: 16px; height: 16px; }
    .language-trigger > span, .language-chevron { display: none; }
    .brand-wordmark { width: 5.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link, .language-chevron, .header-cta { transition: none; }
  }
</style>
