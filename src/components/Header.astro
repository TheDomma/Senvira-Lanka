---
import { siteConfig } from '../config/site';
const { headerEmblem } = siteConfig.logos;
---

<header class="site-header liquid-glass-header">
  <div class="container header-inner">
    <a href="/" class="brand-lockup" aria-label={`${siteConfig.brandName} — Home`}>
      <img
        src={headerEmblem.src}
        alt=""
        width="44"
        height="42"
        decoding="async"
        class="brand-emblem"
      />
      <div class="brand-wordmark">
        <span class="brand-wordmark-main">SENVIRA</span>
        <span class="brand-wordmark-sub">LANKA</span>
      </div>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-navigation"
      aria-label="Toggle navigation menu"
    >
      <span class="nav-toggle-text">Menu</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>

    <nav id="site-navigation" class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          siteConfig.navigation.map((item) => (
            <li>
              <a href={item.href} class="nav-link">{item.label}</a>
            </li>
          ))
        }
      </ul>
      <a href="#plan-a-trip" class="btn btn-primary header-cta">Plan a Trip</a>
    </nav>
  </div>
</header>

<script>
  const toggleButton = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const siteNav = document.querySelector<HTMLElement>('#site-navigation');

  if (toggleButton && siteNav) {
    toggleButton.addEventListener('click', () => {
      const isOpen = toggleButton.getAttribute('aria-expanded') === 'true';
      toggleButton.setAttribute('aria-expanded', String(!isOpen));
      siteNav.classList.toggle('is-open', !isOpen);
    });

    siteNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleButton.setAttribute('aria-expanded', 'false');
        siteNav.classList.remove('is-open');
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && siteNav.classList.contains('is-open')) {
        toggleButton.setAttribute('aria-expanded', 'false');
        siteNav.classList.remove('is-open');
        toggleButton.focus();
      }
    });
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; gap: var(--space-md); }
  .brand-lockup { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--color-charcoal); }
  .brand-emblem { width: 2.65rem; height: auto; object-fit: contain; flex-shrink: 0; }
  .brand-wordmark { display: flex; flex-direction: column; line-height: 1; }
  .brand-wordmark-main { font-family: var(--font-serif); font-size: 1.375rem; font-weight: 700; letter-spacing: 0.04em; color: var(--color-canopy-green); }
  .brand-wordmark-sub { font-family: var(--font-sans); font-size: 0.625rem; font-weight: 600; letter-spacing: 0.28em; color: var(--color-charcoal-muted); margin-top: 0.18rem; }
  .nav-toggle { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.75rem; padding: 0.45rem 0.8rem; background: transparent; color: var(--color-charcoal); border: 1px solid var(--color-border-green); border-radius: var(--radius-sm); font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 600; cursor: pointer; }
  .site-nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background-color: var(--color-ivory-elevated); border-bottom: 1px solid var(--color-border-subtle); padding: var(--space-md) clamp(1.125rem, 4vw, 2.5rem); box-shadow: var(--shadow-card); }
  .site-nav.is-open { display: flex; flex-direction: column; gap: var(--space-md); }
  .nav-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .nav-link { display: inline-block; padding-block: 0.4rem; text-decoration: none; font-size: var(--text-base); font-weight: 500; color: var(--color-charcoal); }
  .nav-link:hover { color: var(--color-teal); }
  .header-cta { width: 100%; }

  @media (min-width: 48rem) {
    .nav-toggle { display: none; }
    .site-nav, .site-nav.is-open { position: static; display: flex; flex-direction: row; align-items: center; gap: var(--space-lg); background: transparent; border: 0; padding: 0; box-shadow: none; }
    .nav-list { flex-direction: row; align-items: center; gap: var(--space-lg); }
    .nav-link { font-size: var(--text-sm); }
    .header-cta { width: auto; }
  }
</style>