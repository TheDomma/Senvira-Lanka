---
import { siteConfig } from '../config/site';

const { headerEmblem, headerWordmark } = siteConfig.logos;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-identity">
      <a href="/" class="footer-brand" aria-label={`${siteConfig.brandName} — Home`}>
        <span class="footer-emblem-wrap"><img src={headerEmblem.src} alt="" width="42" height="40" loading="lazy" decoding="async" /></span>
        <img src={headerWordmark.src} alt="Senvira Lanka" width="132" height="44" loading="lazy" decoding="async" class="footer-wordmark" />
      </a>
      <p>{siteConfig.description}</p>
    </div>

    <nav class="footer-navigation" aria-label="Explore Senvira Lanka">
      <span class="footer-label">Explore</span>
      <ul>
        {siteConfig.navigation.slice(0, 4).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-contact">
      <span class="footer-label">Your journey starts here</span>
      <p>Tell us what you would love to discover.</p>
      <a href="/contact/" class="footer-contact-link">Get in touch <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {currentYear} {siteConfig.brandName}</span>
    <span>Thoughtfully planned in Sri Lanka</span>
    <a href="/contact/">Contact</a>
  </div>
</footer>

<style>
  .site-footer { padding-block: 3.5rem 1.4rem; border-top: 1px solid rgba(246, 244, 235, 0.12); background: #071a15; color: var(--color-ivory); }
  .footer-top { display: grid; grid-template-columns: minmax(14rem, 1.6fr) minmax(8rem, 0.8fr) minmax(12rem, 1fr); gap: clamp(2rem, 5vw, 5rem); padding-bottom: 2.6rem; }
  .footer-brand { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; }
  .footer-emblem-wrap { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; overflow: hidden; border: 1px solid rgba(237, 241, 227, 0.38); border-radius: 50%; background: var(--color-ivory); }
  .footer-emblem-wrap img { width: 2rem; height: 1.9rem; object-fit: contain; }
  .footer-wordmark { width: 7.4rem; height: auto; }
  .footer-identity p, .footer-contact p { max-width: 31ch; margin: 1rem 0 0; color: rgba(246, 244, 235, 0.64); font-size: 0.82rem; line-height: 1.75; }
  .footer-label { display: block; margin-bottom: 0.9rem; color: var(--color-gold-light); font-size: 0.64rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .footer-navigation ul { display: grid; gap: 0.58rem; list-style: none; margin: 0; padding: 0; }
  .footer-navigation a, .footer-bottom a { color: rgba(246, 244, 235, 0.82); font-size: 0.78rem; text-decoration: none; }
  .footer-navigation a:hover, .footer-bottom a:hover { color: white; text-decoration: underline; }
  .footer-contact p { margin: 0 0 0.85rem; }
  .footer-contact-link { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-ivory); font-size: 0.8rem; font-weight: 600; text-decoration: none; }
  .footer-contact-link span { color: var(--color-gold-light); font-size: 1rem; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.1rem; border-top: 1px solid rgba(246, 244, 235, 0.12); color: rgba(246, 244, 235, 0.52); font-size: 0.7rem; }

  @media (max-width: 48rem) {
    .footer-top { grid-template-columns: 1fr 1fr; }
    .footer-identity { grid-column: 1 / -1; }
    .footer-bottom { flex-wrap: wrap; }
  }

  @media (max-width: 34rem) {
    .footer-top { grid-template-columns: 1fr; gap: 1.75rem; }
    .footer-identity { grid-column: auto; }
    .footer-bottom { display: grid; grid-template-columns: 1fr auto; }
    .footer-bottom span:nth-child(2) { grid-row: 2; grid-column: 1 / -1; }
  }
</style>
