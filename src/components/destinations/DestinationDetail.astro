---
import { Image } from 'astro:assets';
import { destinationRegions, type Destination } from '../../data/destinations';

interface Props {
  destination: Destination;
}

const { destination } = Astro.props;
const photos = destination.images ?? [];
const regionMap = new Map(destinationRegions.map((r) => [r.id, r.shortName || r.name]));
const regionLabel = regionMap.get(destination.regionId) ?? 'Sri Lanka';
---

<article class="detail-card" aria-labelledby={`detail-${destination.id}`}>
  <div class="detail-media">
    {
      photos.length > 0 ? (
        photos.map((image, index) => (
          <Image
            src={image.src}
            alt={image.alt}
            width={image.src.width}
            height={image.src.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="detail-photo"
          />
        ))
      ) : (
        <div
          class="detail-photo-fallback"
          role="img"
          aria-label={`${destination.name} in ${destination.provinceArea}`}
        >
          <div class="fallback-pattern" aria-hidden="true"></div>
          <span class="fallback-note">Verified documentary photograph being curated</span>
        </div>
      )
    }

    <div class="media-shade" aria-hidden="true"></div>

    <div class="media-top-badges">
      <span class="pill-badge pill-badge-light">{destination.badge}</span>
      <span class="pill-badge pill-badge-amber">{destination.categoryLabel}</span>
      <span class="pill-index">{destination.number} / 15</span>
    </div>

    <div class="media-bottom-title">
      <p class="media-kicker">{regionLabel} · {destination.provinceArea}</p>
      <h2 id={`detail-${destination.id}`}>{destination.name}</h2>
    </div>
  </div>

  <div class="detail-body">
    <p class="detail-summary">{destination.summary}</p>

    <div class="highlights-block">
      <h3 class="block-label">Highlights & Key Experiences</h3>
      <div class="highlight-chips">
        {destination.highlights.map((item) => (
          <span class="highlight-chip">{item}</span>
        ))}
      </div>
    </div>

    <div class="detail-columns">
      <section class="info-box" aria-labelledby={`activities-${destination.id}`}>
        <h3 id={`activities-${destination.id}`} class="block-label">Make time for</h3>
        <p class="activity-line">{destination.activities.join(' · ')}</p>
      </section>

      <section class="info-box" aria-labelledby={`nearby-${destination.id}`}>
        <h3 id={`nearby-${destination.id}`} class="block-label">Nearby in this region</h3>
        <div class="nearby-chips">
          {destination.nearbyAttractions.map((place) => (
            <span class="nearby-chip">{place}</span>
          ))}
        </div>
      </section>
    </div>

    <div class="season-banner">
      <span class="season-dot" aria-hidden="true">✦</span>
      <p>{destination.seasonNote}</p>
    </div>

    <div class="detail-actions">
      <a class="cta-primary" href="/journeys/">
        <span>Plan a journey with {destination.shortName}</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a
        class="cta-secondary"
        href="#island-catalogue"
        data-jump-region={destination.regionId}
      >
        <span>Browse {regionLabel} directory</span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    {
      photos.length > 0 && (
        <div class="credits" aria-label="Photo credits">
          {photos.map((image) => (
            <p class="credit">
              Photo: {image.credit} ·{' '}
              <a href={image.sourceUrl} target="_blank" rel="noreferrer">
                Source
              </a>
              {image.license.includes('CC BY 3.0') && (
                <>
                  {' '}
                  ·{' '}
                  <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noreferrer">
                    CC BY 3.0
                  </a>
                </>
              )}
            </p>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .detail-card {
    overflow: hidden;
    border: 1px solid rgba(20, 91, 89, 0.22);
    border-radius: 1.15rem;
    background: linear-gradient(180deg, rgba(255, 252, 245, 0.94), rgba(246, 241, 231, 0.92));
    color: var(--color-forest-deep);
    box-shadow:
      0 18px 40px -22px rgba(7, 48, 46, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
  }

  .detail-media {
    position: relative;
    height: 15.25rem;
    overflow: hidden;
    background: var(--color-forest-deep);
    isolation: isolate;
  }

  .detail-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    filter: saturate(0.92) contrast(1.02);
  }

  .detail-photo-fallback {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 78% 22%, rgba(217, 154, 69, 0.34), transparent 52%),
      linear-gradient(135deg, #0a302e 0%, #145b59 58%, #1e4d42 100%);
  }

  .fallback-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image: radial-gradient(rgba(246, 241, 231, 0.7) 1px, transparent 1px);
    background-size: 18px 18px;
  }

  .fallback-note {
    position: relative;
    z-index: 1;
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(246, 241, 231, 0.25);
    border-radius: 999px;
    background: rgba(7, 36, 30, 0.55);
    color: rgba(246, 241, 231, 0.82);
    font-size: 0.68rem;
    backdrop-filter: blur(8px);
  }

  .media-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(6, 26, 23, 0.46) 0%, rgba(6, 26, 23, 0.08) 42%, rgba(6, 26, 23, 0.88) 100%);
  }

  .media-top-badges {
    position: absolute;
    top: 0.85rem;
    right: 0.9rem;
    left: 0.9rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.72rem;
    border-radius: 999px;
    font: 750 0.64rem/1.1 var(--font-sans);
    letter-spacing: 0.06em;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
  }

  .pill-badge-light {
    background: rgba(255, 252, 245, 0.95);
    color: var(--color-forest-deep);
  }

  .pill-badge-amber {
    background: linear-gradient(135deg, #d98238, #c76b24);
    color: #fffdf8;
    text-transform: uppercase;
  }

  .pill-index {
    margin-left: auto;
    padding: 0.28rem 0.6rem;
    border: 1px solid rgba(246, 241, 231, 0.34);
    border-radius: 999px;
    background: rgba(8, 36, 33, 0.62);
    color: var(--color-gold-light);
    font: 600 0.68rem/1 var(--font-serif);
    backdrop-filter: blur(8px);
  }

  .media-bottom-title {
    position: absolute;
    right: 1.1rem;
    bottom: 0.95rem;
    left: 1.1rem;
    z-index: 2;
  }

  .media-kicker {
    margin: 0 0 0.22rem;
    color: var(--color-gold-light);
    font: 750 0.64rem/1.2 var(--font-sans);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .media-bottom-title h2 {
    margin: 0;
    color: #fffdf7;
    font: 600 clamp(1.65rem, 2.6vw, 2.3rem)/1.02 var(--font-serif);
    letter-spacing: -0.02em;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.38);
  }

  .detail-body {
    display: grid;
    gap: 0.95rem;
    padding: 1.1rem 1.2rem 1.2rem;
  }

  .detail-summary {
    max-width: 64ch;
    margin: 0;
    color: var(--color-charcoal);
    font-size: 0.86rem;
    line-height: 1.62;
  }

  .block-label {
    margin: 0 0 0.45rem;
    color: var(--color-teal);
    font: 750 0.65rem/1.2 var(--font-sans);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .highlight-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .highlight-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.34rem 0.68rem;
    border: 1px solid rgba(20, 91, 89, 0.22);
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 2px 6px rgba(10, 48, 46, 0.05);
    color: var(--color-forest-deep);
    font: 600 0.73rem/1.2 var(--font-sans);
  }

  .detail-columns {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 0.85rem;
  }

  .info-box {
    padding: 0.75rem 0.85rem;
    border: 1px solid rgba(20, 91, 89, 0.15);
    border-radius: 0.8rem;
    background: rgba(232, 239, 235, 0.52);
  }

  .activity-list {
    margin: 0;
    padding-left: 1rem;
    color: var(--color-charcoal);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .activity-list li + li {
    margin-top: 0.25rem;
  }

  .activity-list li::marker {
    color: var(--color-amber);
  }

  .nearby-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
  }

  .nearby-chip {
    display: inline-flex;
    padding: 0.24rem 0.52rem;
    border: 1px solid rgba(217, 154, 69, 0.38);
    border-radius: 999px;
    background: rgba(255, 252, 245, 0.86);
    color: var(--color-forest-deep);
    font: 600 0.68rem/1.2 var(--font-sans);
  }

  .season-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.55rem 0.78rem;
    border: 1px solid rgba(217, 154, 69, 0.36);
    border-radius: 0.7rem;
    background: rgba(217, 154, 69, 0.11);
    color: var(--color-forest-deep);
  }

  .season-dot {
    color: #b87726;
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .season-banner p {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding-top: 0.15rem;
  }

  .cta-primary {
    display: inline-flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--color-teal);
    border-radius: 0.65rem;
    background: var(--color-teal);
    box-shadow: 0 8px 20px -8px rgba(10, 48, 46, 0.45);
    color: var(--color-ivory);
    font: 700 0.8rem/1.1 var(--font-sans);
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .cta-primary:hover {
    background: var(--color-forest-deep);
    transform: translateY(-1px);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid rgba(20, 91, 89, 0.28);
    border-radius: 0.65rem;
    background: rgba(255, 252, 245, 0.85);
    color: var(--color-teal);
    font: 650 0.76rem/1.1 var(--font-sans);
    text-decoration: none;
    transition: background-color 180ms ease, border-color 180ms ease;
  }

  .cta-secondary:hover {
    border-color: var(--color-teal);
    background: #ffffff;
  }

  .credits {
    padding-top: 0.5rem;
    border-top: 1px solid rgba(20, 91, 89, 0.12);
  }

  .credit {
    margin: 0;
    color: var(--color-charcoal-muted);
    font-size: 0.64rem;
    line-height: 1.4;
  }

  .credit a {
    color: var(--color-teal);
  }

  @media (max-width: 40rem) {
    .detail-media {
      height: 12rem;
    }

    .detail-columns {
      grid-template-columns: 1fr;
    }

    .detail-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Dark liquid-glass theme */
  .detail-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid rgba(233, 199, 121, 0.2);
    background: linear-gradient(180deg, rgba(8, 52, 49, 0.5), rgba(3, 24, 22, 0.7));
    color: var(--color-ivory);
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
  }
  .detail-media { flex: 0 0 auto; height: 14rem; }
  .detail-photo { filter: saturate(1) contrast(1.03); object-position: center 45%; }
  .detail-body { flex: 1 1 auto; align-content: space-between; gap: 0.8rem; padding: 1rem 1.1rem 1.05rem; }
  .detail-summary { color: rgba(246, 241, 231, 0.88); font-size: 0.84rem; line-height: 1.58; }
  .block-label { color: var(--color-gold-light); margin-bottom: 0.4rem; }
  .highlight-chip {
    border-color: rgba(246, 241, 231, 0.18);
    background: rgba(246, 241, 231, 0.08);
    box-shadow: none;
    color: var(--color-ivory);
  }
  .detail-columns { grid-template-columns: 1fr 1fr; }
  .info-box { border-color: rgba(246, 241, 231, 0.12); background: rgba(2, 20, 19, 0.38); }
  .activity-line { margin: 0; color: rgba(246, 241, 231, 0.84); font-size: 0.75rem; line-height: 1.55; }
  .nearby-chip { border-color: rgba(233, 199, 121, 0.35); background: rgba(217, 154, 69, 0.1); color: #fbe9c3; }
  .season-banner { border-color: rgba(233, 199, 121, 0.3); background: rgba(217, 154, 69, 0.1); color: var(--color-ivory); }
  .season-dot { color: var(--color-gold-light); }
  .cta-primary { border-color: rgba(233, 199, 121, 0.7); background: linear-gradient(135deg, #d99a45, #b87726); color: #1a1208; box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.5); }
  .cta-primary:hover { background: linear-gradient(135deg, #e9b565, #c9862f); }
  .cta-secondary { border-color: rgba(246, 241, 231, 0.24); background: rgba(246, 241, 231, 0.07); color: var(--color-ivory); }
  .cta-secondary:hover { border-color: var(--color-gold-light); background: rgba(246, 241, 231, 0.14); }
  .credits { border-top-color: rgba(246, 241, 231, 0.12); padding-top: 0.4rem; }
  .credit { color: rgba(246, 241, 231, 0.55); }
  .credit a { color: var(--color-gold-light); }
</style>
