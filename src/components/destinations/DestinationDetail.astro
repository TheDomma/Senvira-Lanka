---
import { Image } from 'astro:assets';
import type { Destination } from '../../data/destinations';

interface Props { destination: Destination }
const { destination } = Astro.props;
const photos = destination.images ?? [];
---

<article class="detail" aria-labelledby={`detail-${destination.id}`}>
  <div class="photo">
    {photos.length > 0 ? photos.map((image, index) => (
      <Image src={image.src} alt={image.alt} width={image.src.width} height={image.src.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
    )) : <div class="photo-placeholder" role="img" aria-label={`No photographs available for ${destination.name}`}><span aria-hidden="true">✦</span><p>Photos coming soon</p></div>}
    {photos.length > 0 && <span class="photo-count">{photos.length} {photos.length === 1 ? 'photo' : 'photos'}</span>}
  </div>
  <div class="copy">
    <p class="eyebrow">A closer look</p>
    <h2 id={`detail-${destination.id}`}>{destination.name}</h2>
    <p class="summary">{destination.summary}</p>
    <div class="lists">
      <section aria-labelledby={`highlights-${destination.id}`}>
        <h3 id={`highlights-${destination.id}`}>Highlights</h3>
        <ul>{destination.highlights.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section aria-labelledby={`activities-${destination.id}`}>
        <h3 id={`activities-${destination.id}`}>Make time for</h3>
        <ul>{destination.activities.map((item) => <li>{item}</li>)}</ul>
      </section>
    </div>
    <a class="journey-link" href="/journeys/">Plan a journey here <span aria-hidden="true">→</span></a>
    {photos.length > 0 && <div class="credits" aria-label="Photo credits">{photos.map((image, index) => <p class="credit">Photo {index + 1}: {image.credit}. <a href={image.sourceUrl} target="_blank" rel="noreferrer">Image source</a>{image.license.includes('CC BY 3.0') && <> · <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noreferrer">CC BY 3.0</a></>}</p>)}</div>}
  </div>
</article>

<style>
  .detail { overflow: hidden; border: 1px solid rgba(20, 91, 89, .16); border-radius: var(--radius-lg); background: rgba(255, 252, 245, .86); color: var(--color-forest-deep); box-shadow: 0 16px 38px -22px rgba(7, 48, 46, .3); }
  .photo { position: relative; display: grid; grid-template-columns: 1fr; gap: .35rem; max-height: 19rem; overflow: hidden; background: var(--color-sage-surface); }
  .photo:has(img:nth-child(2)) { grid-template-columns: 1.4fr 1fr; }
  .photo img { width: 100%; height: 19rem; object-fit: cover; }
  .photo-placeholder { display: grid; min-height: 19rem; place-content: center; justify-items: center; width: 100%; background: linear-gradient(145deg, var(--color-sage-surface), var(--color-ivory)); color: var(--color-teal); }
  .photo-placeholder span { font-size: 1.5rem; }
  .photo-placeholder p { margin: .25rem 0 0; color: var(--color-charcoal-muted); font-size: .8rem; }
  .photo:has(img:nth-child(2)) img { height: 13rem; }
  .photo:has(img:nth-child(2)) img:first-child { grid-row: span 2; height: 100%; min-height: 13rem; }
  .photo-count { position: absolute; right: .8rem; bottom: .75rem; padding: .3rem .58rem; border: 1px solid rgba(255,255,255,.36); border-radius: 999px; background: rgba(10, 48, 46, .7); color: white; font-size: .68rem; font-weight: 650; backdrop-filter: blur(8px); }
  .copy { padding: clamp(1.1rem, 3vw, 1.65rem); }
  .eyebrow { margin: 0 0 .15rem; color: var(--color-teal); font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--color-forest-deep); font-size: var(--text-2xl); }
  .summary { margin: .5rem 0 1.15rem; color: var(--color-charcoal-muted); font-size: .9rem; line-height: 1.65; }
  .lists { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .lists h3 { margin: 0 0 .4rem; color: var(--color-forest-deep); font: 700 .72rem/1.3 var(--font-sans); letter-spacing: .07em; text-transform: uppercase; }
  .lists ul { margin: 0; padding-left: 1.05rem; color: var(--color-charcoal); font-size: .78rem; line-height: 1.55; }
  .lists li + li { margin-top: .22rem; }
  .lists li::marker { color: var(--color-amber); }
  .journey-link { display: inline-flex; align-items: center; gap: .65rem; min-height: 2.8rem; margin-top: 1.25rem; padding: .65rem 1rem; border-radius: var(--radius-sm); background: var(--color-teal); color: var(--color-ivory); font-size: .82rem; font-weight: 700; text-decoration: none; transition: background-color .18s ease; }
  .journey-link:hover { background: var(--color-canopy-green); }
  .journey-link span { font-size: 1rem; }
  .credits { margin-top: .8rem; }
  .credit { margin: .25rem 0 0; color: var(--color-charcoal-muted); font-size: .65rem; line-height: 1.5; }
  .credit a { color: var(--color-teal); }
  @media (max-width: 36rem) { .photo, .photo img, .photo-placeholder { max-height: 14rem; height: 14rem; min-height: 14rem; } .photo:has(img:nth-child(2)) img { height: 6.8rem; } .photo:has(img:nth-child(2)) img:first-child { min-height: 13.8rem; } .lists { grid-template-columns: 1fr; gap: .85rem; } }
</style>
