---
import {
  destinationCategories,
  type Destination,
  type DestinationRegion,
} from '../../data/destinations';

interface Props {
  destinations: Destination[];
  regions: DestinationRegion[];
  selectedId: string;
}

const { destinations, regions, selectedId } = Astro.props;
const featuredHubs = destinations.filter((d) => d.isHub !== false);
const otherDestinations = destinations.filter((d) => d.isHub === false);
---

<section class="directory-controls" aria-labelledby="directory-title" data-destination-directory>
  <div class="controls-header">
    <div>
      <span class="eyebrow-tag">Island Destinations</span>
      <h2 id="directory-title">Select a destination</h2>
    </div>
    <p class="result-badge" data-result-count aria-live="polite">15 featured hubs</p>
  </div>

  <div class="search-box">
    <label class="sr-only" for="destination-search">Search destinations</label>
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
      <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <input
      id="destination-search"
      class="search-input"
      type="search"
      placeholder="Search Sigiriya, Galle, Kandy, wildlife..."
      autocomplete="off"
      data-search
    />
  </div>

  <div class="filter-dropdowns">
    <div class="select-field">
      <label class="sr-only" for="region-filter-select">Filter by region</label>
      <select id="region-filter-select" class="glass-select" data-region-select aria-label="Filter by region">
        <option value="all">All Regions</option>
        {regions.map((region) => (
          <option value={region.id}>{region.shortName || region.name}</option>
        ))}
      </select>
      <span class="select-arrow" aria-hidden="true">⌄</span>
    </div>

    <div class="select-field">
      <label class="sr-only" for="category-filter-select">Filter by category</label>
      <select id="category-filter-select" class="glass-select" data-category-select aria-label="Filter by category">
        <option value="all">All Categories</option>
        {destinationCategories.map((cat) => (
          <option value={cat.id}>{cat.label}</option>
        ))}
      </select>
      <span class="select-arrow" aria-hidden="true">⌄</span>
    </div>

    <div class="select-field select-field-place">
      <label class="sr-only" for="destination-choice">Choose a destination</label>
      <select
        id="destination-choice"
        class="glass-select glass-select-accent"
        data-destination-choice
        data-select
        aria-label="Choose a destination"
      >
        <optgroup label="Featured Hubs (15)" data-option-group-hubs>
          {featuredHubs.map((destination) => {
            const allCats = destination.categories?.length
              ? destination.categories
              : [destination.categoryId, ...(destination.alsoCategoryIds ?? [])];
            return (
              <option
                value={destination.id}
                data-destination-item
                data-region={destination.regionId}
                data-category={destination.categoryId}
                data-categories={allCats.join(' ')}
                data-is-hub="true"
                data-search-text={`${destination.name} ${destination.shortName} ${destination.badge} ${destination.provinceArea} ${destination.highlights.join(' ')}`.toLowerCase()}
                selected={destination.id === selectedId}
              >
                {destination.number} · {destination.shortName} (Featured Hub)
              </option>
            );
          })}
        </optgroup>
        {regions.map((region) => {
          const places = otherDestinations.filter((d) => d.regionId === region.id);
          return (
            places.length > 0 && (
              <optgroup label={`${region.name} (${places.length})`} data-option-region={region.id}>
                {places.map((destination) => {
                  const allCats = destination.categories?.length
                    ? destination.categories
                    : [destination.categoryId, ...(destination.alsoCategoryIds ?? [])];
                  return (
                    <option
                      value={destination.id}
                      data-destination-item
                      data-region={destination.regionId}
                      data-category={destination.categoryId}
                      data-categories={allCats.join(' ')}
                      data-is-hub="false"
                      data-search-text={`${destination.name} ${destination.shortName} ${destination.badge} ${destination.provinceArea} ${destination.highlights.join(' ')}`.toLowerCase()}
                      selected={destination.id === selectedId}
                    >
                      {destination.name}
                    </option>
                  );
                })}
              </optgroup>
            )
          );
        })}
      </select>
      <span class="select-arrow" aria-hidden="true">⌄</span>
    </div>
  </div>

  <div class="featured-strip-wrap">
    <div class="featured-strip" role="toolbar" aria-label="Destination browser" data-slider-strip>
      {destinations.map((destination) => {
        const isHub = destination.isHub !== false;
        const allCats = destination.categories?.length
          ? destination.categories
          : [destination.categoryId, ...(destination.alsoCategoryIds ?? [])];
        return (
          <button
            type="button"
            class:list={[
              'featured-chip',
              isHub ? 'is-hub-chip' : 'is-catalogue-chip',
              { active: destination.id === selectedId }
            ]}
            data-destination-id={destination.id}
            data-chip-item
            data-region={destination.regionId}
            data-category={destination.categoryId}
            data-categories={allCats.join(' ')}
            data-is-hub={String(isHub)}
            data-search-text={`${destination.name} ${destination.shortName} ${destination.badge} ${destination.provinceArea} ${destination.highlights.join(' ')}`.toLowerCase()}
            aria-pressed={destination.id === selectedId}
            title={destination.name}
            hidden={!isHub}
          >
            {isHub ? (
              <span class="chip-num">{destination.number}</span>
            ) : (
              <span class="chip-dot" aria-hidden="true"></span>
            )}
            <span class="chip-name">{destination.shortName}</span>
          </button>
        );
      })}
    </div>
  </div>

  <div class="empty-filter-state" data-empty hidden>
    <p>No destinations match that filter combination.</p>
    <button class="reset-btn" type="button" data-reset>Reset search & filters</button>
  </div>
</section>

<script>
  const directories = document.querySelectorAll<HTMLElement>('[data-destination-directory]');
  directories.forEach((directory) => {
    const search = directory.querySelector<HTMLInputElement>('[data-search]')!;
    const regionSelect = directory.querySelector<HTMLSelectElement>('[data-region-select]')!;
    const categorySelect = directory.querySelector<HTMLSelectElement>('[data-category-select]')!;
    const choice = directory.querySelector<HTMLSelectElement>('[data-destination-choice]')!;
    const options = [...directory.querySelectorAll<HTMLOptionElement>('[data-destination-item]')];
    const optgroups = [...directory.querySelectorAll<HTMLOptGroupElement>('optgroup')];
    const chips = [...directory.querySelectorAll<HTMLButtonElement>('[data-chip-item]')];
    const empty = directory.querySelector<HTMLElement>('[data-empty]')!;
    const count = directory.querySelector<HTMLElement>('[data-result-count]')!;
    const strip = directory.querySelector<HTMLElement>('[data-slider-strip]');

    // Slow edge scrolling for mouse pointer inside narrow zones on left/right edges
    if (strip) {
      let scrollAnimFrame: number | null = null;
      let scrollSpeed = 0; // px per frame
      const EDGE_ZONE_WIDTH = 48; // px threshold from left or right edge
      const MAX_SPEED = 3.5; // Controlled slow scrolling speed (px per frame)

      const stopEdgeScrolling = () => {
        if (scrollAnimFrame !== null) {
          cancelAnimationFrame(scrollAnimFrame);
          scrollAnimFrame = null;
        }
        scrollSpeed = 0;
      };

      const stepEdgeScroll = () => {
        if (scrollSpeed !== 0 && strip) {
          strip.scrollLeft += scrollSpeed;
          scrollAnimFrame = requestAnimationFrame(stepEdgeScroll);
        } else {
          stopEdgeScrolling();
        }
      };

      strip.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse') return;
      });

      strip.addEventListener('pointermove', (event) => {
        // Only trigger for mouse pointer
        if (event.pointerType !== 'mouse') {
          stopEdgeScrolling();
          return;
        }

        const rect = strip.getBoundingClientRect();
        const mouseX = event.clientX - rect.left;

        if (mouseX >= 0 && mouseX <= EDGE_ZONE_WIDTH) {
          // Inside left edge zone: scroll left
          const factor = Math.max(0.2, (EDGE_ZONE_WIDTH - mouseX) / EDGE_ZONE_WIDTH);
          scrollSpeed = -MAX_SPEED * factor;
          if (scrollAnimFrame === null) {
            scrollAnimFrame = requestAnimationFrame(stepEdgeScroll);
          }
        } else if (mouseX >= rect.width - EDGE_ZONE_WIDTH && mouseX <= rect.width) {
          // Inside right edge zone: scroll right
          const distFromRight = rect.width - mouseX;
          const factor = Math.max(0.2, (EDGE_ZONE_WIDTH - distFromRight) / EDGE_ZONE_WIDTH);
          scrollSpeed = MAX_SPEED * factor;
          if (scrollAnimFrame === null) {
            scrollAnimFrame = requestAnimationFrame(stepEdgeScroll);
          }
        } else {
          // Center deadzone: do NOT scroll
          stopEdgeScrolling();
        }
      });

      strip.addEventListener('pointerleave', stopEdgeScrolling);
      strip.addEventListener('pointerdown', stopEdgeScrolling);
      window.addEventListener('pointerup', stopEdgeScrolling);

      // Preserve native horizontal trackpad and mouse-wheel scrolling
      strip.addEventListener('wheel', (event) => {
        if (Math.abs(event.deltaY) > Math.abs(event.deltaX) && strip.scrollWidth > strip.clientWidth) {
          strip.scrollLeft += event.deltaY * 0.85;
          event.preventDefault();
        }
      }, { passive: false });
    }

    const applyFilters = () => {
      const region = regionSelect.value;
      const category = categorySelect.value;
      const query = search.value.trim().toLowerCase();
      const hasActiveFilters = region !== 'all' || category !== 'all' || Boolean(query);
      let visibleOptionsCount = 0;
      let visibleChipsCount = 0;

      // 1. Dropdown options always filter matching entries across the full 204 catalogue
      options.forEach((item) => {
        const itemCategories = (item.dataset.categories ?? item.dataset.category ?? '').split(' ');
        const matchesRegion = region === 'all' || item.dataset.region === region;
        const matchesCategory = category === 'all' || itemCategories.includes(category);
        const matchesSearch = !query || (item.dataset.searchText ?? '').includes(query);
        const visible = matchesRegion && matchesCategory && matchesSearch;
        item.hidden = !visible;
        item.disabled = !visible;
        if (visible) visibleOptionsCount += 1;
      });

      optgroups.forEach((group) => {
        const groupOptions = [...group.querySelectorAll<HTMLOptionElement>('option')];
        const hasVisible = groupOptions.some((opt) => !opt.disabled);
        group.hidden = !hasVisible;
        group.disabled = !hasVisible;
      });

      // 2. Slider chips:
      // When NO filters/search are active: show ONLY the 15 featured hubs
      // When filters/search ARE active: show all matching catalogue entries
      chips.forEach((chip) => {
        const isHub = chip.dataset.isHub === 'true';
        if (!hasActiveFilters) {
          chip.hidden = !isHub;
          if (isHub) visibleChipsCount += 1;
        } else {
          const chipCategories = (chip.dataset.categories ?? chip.dataset.category ?? '').split(' ');
          const matchesRegion = region === 'all' || chip.dataset.region === region;
          const matchesCategory = category === 'all' || chipCategories.includes(category);
          const matchesSearch = !query || (chip.dataset.searchText ?? '').includes(query);
          const visible = matchesRegion && matchesCategory && matchesSearch;
          chip.hidden = !visible;
          if (visible) visibleChipsCount += 1;
        }
      });

      if (!hasActiveFilters) {
        empty.hidden = true;
        count.textContent = '15 featured hubs';
      } else {
        empty.hidden = visibleOptionsCount > 0;
        count.textContent = `${visibleOptionsCount} ${visibleOptionsCount === 1 ? 'matching place' : 'matching places'}`;
      }

      directory.dispatchEvent(
        new CustomEvent('explorer-filters-change', {
          bubbles: true,
          detail: { region, category, query, hasActiveFilters },
        }),
      );

      if (hasActiveFilters && visibleOptionsCount > 0 && (choice.selectedOptions[0]?.hidden || choice.selectedOptions[0]?.disabled)) {
        const next = options.find((item) => !item.hidden && !item.disabled);
        if (next) {
          choice.value = next.value;
          choice.dispatchEvent(new CustomEvent('destination-select', { bubbles: true, detail: { id: next.value } }));
        }
      }
    };

    regionSelect.addEventListener('change', applyFilters);
    categorySelect.addEventListener('change', applyFilters);
    search.addEventListener('input', applyFilters);

    choice.addEventListener('change', () => {
      choice.dispatchEvent(new CustomEvent('destination-select', { bubbles: true, detail: { id: choice.value } }));
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.destinationId;
        if (id) {
          chip.dispatchEvent(new CustomEvent('destination-select', { bubbles: true, detail: { id } }));
        }
      });
    });

    directory.querySelector('[data-reset]')?.addEventListener('click', () => {
      search.value = '';
      regionSelect.value = 'all';
      categorySelect.value = 'all';
      applyFilters();
      search.focus();
    });

    document.addEventListener('map-category-filter', (event) => {
      const cat = (event as CustomEvent<{ category?: string }>).detail?.category ?? 'all';
      if (categorySelect.value !== cat) {
        categorySelect.value = cat;
        applyFilters();
      }
    });

    document.addEventListener('map-reset', () => {
      search.value = '';
      regionSelect.value = 'all';
      categorySelect.value = 'all';
      applyFilters();
    });
  });
</script>

<style>
  .directory-controls {
    display: grid;
    gap: 0.7rem;
    color: var(--color-forest-deep);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .controls-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .eyebrow-tag {
    display: block;
    margin-bottom: 0.1rem;
    color: var(--color-teal);
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .controls-header h2 {
    margin: 0;
    color: var(--color-forest-deep);
    font: 600 clamp(1.3rem, 2vw, 1.65rem)/1.08 var(--font-serif);
  }

  .result-badge {
    margin: 0;
    padding: 0.28rem 0.65rem;
    border: 1px solid rgba(20, 91, 89, 0.2);
    border-radius: 999px;
    background: rgba(20, 91, 89, 0.08);
    color: var(--color-teal);
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.9rem;
    color: var(--color-teal);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.9rem 0.55rem 2.45rem;
    border: 1px solid rgba(20, 91, 89, 0.24);
    border-radius: 999px;
    background: rgba(255, 252, 245, 0.9);
    box-shadow: inset 0 1px 2px rgba(10, 48, 46, 0.05);
    color: var(--color-forest-deep);
    font: 500 0.84rem/1.3 var(--font-sans);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .search-input::placeholder {
    color: #6b7c79;
  }

  .search-input:focus-visible,
  .glass-select:focus-visible,
  .featured-chip:focus-visible,
  .reset-btn:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .filter-dropdowns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .select-field {
    position: relative;
    min-width: 0;
  }

  .glass-select {
    width: 100%;
    min-height: 2.55rem;
    appearance: none;
    padding: 0.48rem 2rem 0.48rem 0.8rem;
    border: 1px solid rgba(20, 91, 89, 0.24);
    border-radius: 999px;
    background: rgba(255, 252, 245, 0.88);
    color: var(--color-forest-deep);
    font: 600 0.76rem/1.2 var(--font-sans);
    cursor: pointer;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .glass-select:hover {
    border-color: var(--color-teal);
    background: #ffffff;
  }

  .glass-select-accent {
    border-color: rgba(217, 154, 69, 0.55);
    background: linear-gradient(135deg, rgba(255, 250, 238, 0.95), rgba(246, 241, 231, 0.92));
    color: var(--color-forest-deep);
    font-weight: 700;
  }

  .select-arrow {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    color: var(--color-teal);
    font-size: 0.95rem;
    pointer-events: none;
    transform: translateY(-58%);
  }

  .featured-strip-wrap {
    min-width: 0;
  }

  .featured-strip {
    display: flex;
    gap: 0.38rem;
    overflow-x: auto;
    padding: 0.15rem 0.05rem 0.35rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(20, 91, 89, 0.3) transparent;
  }

  .featured-chip {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding: 0.28rem 0.65rem 0.28rem 0.36rem;
    border: 1px solid rgba(20, 91, 89, 0.2);
    border-radius: 999px;
    background: rgba(255, 252, 245, 0.76);
    color: var(--color-forest-deep);
    font: 600 0.72rem/1 var(--font-sans);
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .featured-chip.is-catalogue-chip {
    padding-left: 0.55rem;
  }

  .featured-chip:hover {
    border-color: var(--color-teal);
    background: #ffffff;
    transform: translateY(-1px);
  }

  .featured-chip.active {
    border-color: var(--color-teal);
    background: var(--color-teal);
    color: var(--color-ivory);
    box-shadow: 0 4px 12px rgba(10, 48, 46, 0.2);
  }

  .chip-num {
    display: inline-grid;
    width: 1.3rem;
    height: 1.3rem;
    place-items: center;
    border-radius: 50%;
    background: rgba(20, 91, 89, 0.12);
    color: var(--color-teal);
    font-family: var(--font-serif);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .chip-dot {
    width: 0.44rem;
    height: 0.44rem;
    border-radius: 50%;
    background: rgba(233, 199, 121, 0.7);
    flex: 0 0 0.44rem;
  }

  .featured-chip.active .chip-num {
    background: var(--color-amber);
    color: var(--color-charcoal);
  }

  .featured-chip.active .chip-dot {
    background: #fffdf7;
    box-shadow: 0 0 0 2px rgba(14, 58, 55, 0.4);
  }

  .empty-filter-state {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border: 1px dashed rgba(20, 91, 89, 0.35);
    border-radius: 0.75rem;
    background: rgba(255, 252, 245, 0.72);
    font-size: 0.78rem;
  }

  .empty-filter-state p {
    margin: 0;
    color: var(--color-charcoal-muted);
  }

  .reset-btn {
    border: 0;
    background: none;
    color: var(--color-teal);
    font: 700 0.76rem var(--font-sans);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
    white-space: nowrap;
  }

  /* Dark liquid-glass theme */
  .directory-controls { color: var(--color-ivory); }
  .eyebrow-tag { color: var(--color-gold-light); }
  .controls-header h2 { color: #fbf8f0; }
  .result-badge {
    border-color: rgba(233, 199, 121, 0.3);
    background: rgba(217, 154, 69, 0.14);
    color: var(--color-gold-light);
  }
  .search-icon { color: var(--color-gold-light); }
  .search-input,
  .glass-select {
    border-color: rgba(246, 241, 231, 0.16);
    background: rgba(2, 20, 19, 0.5);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    color: var(--color-ivory);
    backdrop-filter: blur(10px);
  }
  .search-input::placeholder { color: rgba(246, 241, 231, 0.5); }
  .glass-select option,
  .glass-select optgroup { background: #06201f; color: #f6f1e7; }
  .glass-select:hover { border-color: rgba(233, 199, 121, 0.55); background: rgba(8, 56, 52, 0.6); }
  .glass-select-accent { border-color: rgba(233, 199, 121, 0.5); background: rgba(217, 154, 69, 0.14); color: #fbe9c3; }
  .select-arrow { color: var(--color-gold-light); }
  .search-input:focus-visible,
  .glass-select:focus-visible,
  .featured-chip:focus-visible,
  .reset-btn:focus-visible { outline-color: var(--color-gold-light); }
  .featured-strip { scrollbar-color: rgba(233, 199, 121, 0.4) transparent; }
  .featured-chip {
    border-color: rgba(246, 241, 231, 0.16);
    background: rgba(246, 241, 231, 0.06);
    color: var(--color-ivory);
    backdrop-filter: blur(8px);
  }
  .featured-chip.is-hub-chip {
    border-color: rgba(233, 199, 121, 0.32);
    background: rgba(246, 241, 231, 0.09);
  }
  .featured-chip:hover { border-color: rgba(233, 199, 121, 0.6); background: rgba(246, 241, 231, 0.12); }
  .featured-chip.active {
    border-color: rgba(233, 199, 121, 0.8);
    background: rgba(217, 154, 69, 0.28);
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }
  .chip-num { background: rgba(246, 241, 231, 0.12); color: var(--color-gold-light); }
  .featured-chip.active .chip-num { background: var(--color-amber); color: #1b1b1b; }
  .empty-filter-state { border-color: rgba(233, 199, 121, 0.35); background: rgba(2, 20, 19, 0.5); color: var(--color-ivory); }
  .empty-filter-state p { color: rgba(246, 241, 231, 0.75); }
  .reset-btn { color: var(--color-gold-light); }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 38rem) {
    .filter-dropdowns {
      grid-template-columns: 1fr 1fr;
    }

    .select-field-place {
      grid-column: 1 / -1;
    }
  }
</style>
