---
import type { Destination, DestinationRegion } from '../../data/destinations';

interface Props {
  destinations: Destination[];
  regions: DestinationRegion[];
  selectedId: string;
}

const { destinations, regions, selectedId } = Astro.props;
---

<section class="directory" aria-labelledby="directory-title" data-destination-directory>
  <div class="directory-heading">
    <div><p class="eyebrow">Find your island moment</p><h2 id="directory-title">Choose a place</h2></div>
    <p class="count" data-result-count aria-live="polite">{destinations.length} places</p>
  </div>

  <label class="search-label" for="destination-search">Search destinations</label>
  <input id="destination-search" class="search" type="search" placeholder="Try Ella or the coast…" autocomplete="off" data-search />

  <div class="filters" role="group" aria-label="Filter destinations by region">
    <button class="filter active" type="button" data-region-filter="all" aria-pressed="true">All regions</button>
    {regions.map((region) => <button class="filter" type="button" data-region-filter={region.id} aria-pressed="false">{region.name}</button>)}
  </div>

  <label class="destination-label" for="destination-choice">Destination</label>
  <div class="select-wrap">
    <select class="destination-select" id="destination-choice" data-destination-choice data-select aria-label="Choose a destination">
      {regions.map((region) => {
        const places = destinations.filter((destination) => destination.regionId === region.id);
        return places.length > 0 && (
          <optgroup label={region.name} data-option-region={region.id}>
            {places.map((destination) => <option value={destination.id} data-destination-item data-region={destination.regionId} data-name={destination.name.toLowerCase()} selected={destination.id === selectedId}>{destination.name}</option>)}
          </optgroup>
        );
      })}
    </select>
    <span class="select-chevron" aria-hidden="true">⌄</span>
  </div>

  <p class="selection-hint">Choose a place to see its highlights, map location and a locally sourced photograph.</p>
  <div class="results" data-results aria-live="polite">
    <div class="empty" data-empty hidden>
      <p>No destinations match those filters.</p>
      <button class="reset" type="button" data-reset>Clear search and filters</button>
    </div>
  </div>
</section>

<script>
  const directories = document.querySelectorAll<HTMLElement>('[data-destination-directory]');
  directories.forEach((directory) => {
    const search = directory.querySelector<HTMLInputElement>('[data-search]')!;
    const filters = [...directory.querySelectorAll<HTMLButtonElement>('[data-region-filter]')];
    const items = [...directory.querySelectorAll<HTMLOptionElement>('[data-destination-item]')];
    const choice = directory.querySelector<HTMLSelectElement>('[data-destination-choice]')!;
    const empty = directory.querySelector<HTMLElement>('[data-empty]')!;
    const count = directory.querySelector<HTMLElement>('[data-result-count]')!;
    let region = 'all';

    const applyFilters = () => {
      let visibleCount = 0;
      items.forEach((item) => {
        const visible = (region === 'all' || item.dataset.region === region)
          && (item.dataset.name ?? '').includes(search.value.trim().toLocaleLowerCase());
        item.hidden = !visible;
        item.disabled = !visible;
        if (visible) visibleCount += 1;
      });
      empty.hidden = visibleCount > 0;
      count.textContent = `${visibleCount} ${visibleCount === 1 ? 'place' : 'places'}`;
      if (visibleCount > 0 && (choice.selectedOptions[0]?.hidden || choice.selectedOptions[0]?.disabled)) {
        const next = items.find((item) => !item.hidden && !item.disabled);
        if (next) {
          choice.value = next.value;
          choice.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    };

    filters.forEach((button) => button.addEventListener('click', () => {
      region = button.dataset.regionFilter ?? 'all';
      filters.forEach((filter) => {
        const active = filter === button;
        filter.classList.toggle('active', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      applyFilters();
    }));
    search.addEventListener('input', applyFilters);
    choice.addEventListener('change', () => {
      choice.dispatchEvent(new CustomEvent('destination-select', { bubbles: true, detail: { id: choice.value } }));
    });
    directory.querySelector('[data-reset]')?.addEventListener('click', () => {
      search.value = '';
      region = 'all';
      filters.forEach((filter) => {
        const active = filter.dataset.regionFilter === 'all';
        filter.classList.toggle('active', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      applyFilters();
      search.focus();
    });
    document.addEventListener('destination-select', (event) => {
      const id = (event as CustomEvent<{ id: string }>).detail?.id;
      if (id && items.some((item) => item.value === id)) choice.value = id;
    });
  });
</script>

<style>
  .directory { color: var(--color-forest-deep); }
  .directory-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.15rem; }
  .directory-heading h2 { margin: 0; color: var(--color-forest-deep); font-size: var(--text-2xl); }
  .eyebrow { margin: 0 0 .2rem; color: var(--color-teal); font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .count { margin: 0; color: var(--color-charcoal-muted); font-size: .8rem; white-space: nowrap; }
  .search-label { display: block; margin-bottom: .35rem; color: var(--color-charcoal); font-size: .78rem; font-weight: 650; }
  .search { width: 100%; min-height: 2.9rem; padding: .65rem .85rem; border: 1px solid var(--color-border-green); border-radius: var(--radius-sm); background: var(--color-ivory-elevated); color: var(--color-forest-deep); font: inherit; }
  .search:focus-visible, .filter:focus-visible, .destination-select:focus-visible, .reset:focus-visible { outline: 2px solid var(--color-teal); outline-offset: 2px; }
  .filters { display: flex; gap: .45rem; margin: .8rem 0 1.25rem; padding: .1rem .1rem .35rem; overflow-x: auto; scrollbar-width: thin; }
  .filter { flex: 0 0 auto; min-height: 2.3rem; padding: .45rem .72rem; border: 1px solid var(--color-border-green); border-radius: 999px; background: rgba(255, 252, 245, .74); color: var(--color-forest-deep); font: 600 .72rem/1.2 var(--font-sans); cursor: pointer; }
  .filter:hover { background: var(--color-sage-surface); }
  .filter.active { border-color: var(--color-teal); background: var(--color-teal); color: var(--color-ivory); box-shadow: 0 3px 10px rgba(7, 48, 46, .13); }
  .destination-label { display: block; margin-bottom: .4rem; color: var(--color-charcoal); font-size: .78rem; font-weight: 650; }
  .select-wrap { position: relative; }
  .destination-select { width: 100%; min-height: 3.1rem; appearance: none; padding: .7rem 2.6rem .7rem .85rem; border: 1px solid var(--color-border-green); border-radius: var(--radius-md); background: var(--color-ivory-elevated); color: var(--color-forest-deep); font: 650 .88rem/1.3 var(--font-sans); cursor: pointer; box-shadow: 0 8px 20px -16px rgba(7, 48, 46, .6); }
  .destination-select:hover { border-color: var(--color-teal); }
  .destination-select option, .destination-select optgroup { color: var(--color-forest-deep); background: var(--color-ivory-elevated); }
  .select-chevron { position: absolute; top: 50%; right: .9rem; color: var(--color-teal); font-size: 1.15rem; pointer-events: none; transform: translateY(-58%); }
  .selection-hint { margin: .75rem 0 0; color: var(--color-charcoal-muted); font-size: .76rem; line-height: 1.55; }
  .empty { padding: 1.5rem 1rem; border: 1px dashed var(--color-border-green); border-radius: var(--radius-md); background: rgba(255, 252, 245, .58); text-align: center; }
  .empty p { margin: 0 0 .5rem; color: var(--color-charcoal-muted); }
  .reset { min-height: 2.5rem; border: 0; background: none; color: var(--color-teal); font: 700 .8rem var(--font-sans); text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
  [hidden] { display: none !important; }
</style>
