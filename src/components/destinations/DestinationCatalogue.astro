---
import { Image } from 'astro:assets';
import {
  catalogueEntries,
  catalogueThemes,
  destinationRegions,
  destinations,
} from '../../data/destinations';
import { catalogueCardImages } from '../../data/catalogueCardImages';

const featuredByRegion = new Map(
  destinationRegions.map((region) => [
    region.id,
    destinations.filter((d) => d.regionId === region.id),
  ]),
);

const hubImageById = new Map(
  destinations.map((d) => [
    d.id,
    d.images[0]
      ? {
          src: d.images[0].src,
          alt: d.images[0].alt,
          credit: d.images[0].credit,
          objectPosition: 'center 45%',
        }
      : null,
  ]),
);

const featuredCount = catalogueEntries.filter((e) => e.tier === 'featured').length;
const coreCount = catalogueEntries.filter((e) => e.tier === 'core').length;
const extendedCount = catalogueEntries.filter((e) => e.tier === 'extended').length;
const attractionCount = catalogueEntries.filter((e) => e.tier === 'attraction').length;
---

<section class="featured-showcase-section" id="featured-hubs" aria-labelledby="featured-showcase-title">
  <div class="catalogue-container">
    <div class="showcase-header">
      <div>
        <span class="section-kicker-light">15 Signature Starting Points</span>
        <h2 id="featured-showcase-title">Featured destinations across the island.</h2>
        <p class="showcase-lead">
          Each of these fifteen hubs anchors a wider travel region. Select any card to highlight its location and full regional notes in the interactive map above.
        </p>
      </div>
      <div class="showcase-stat-pills">
        <span>15 Featured Hubs</span>
        <span>7 Distinct Regions</span>
        <span>Real Sourced Photography</span>
      </div>
    </div>

    <div class="featured-cards-grid">
      {
        destinations.map((place) => {
          const firstPhoto = place.images[0];
          return (
            <article class="reise-featured-card" data-featured-card={place.id}>
              <div class="reise-card-media">
                {firstPhoto ? (
                  <Image
                    src={firstPhoto.src}
                    alt={firstPhoto.alt}
                    widths={[360, 560, 760]}
                    sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw"
                    loading="lazy"
                    decoding="async"
                    class="reise-card-img"
                  />
                ) : (
                  <div class="reise-card-fallback" aria-hidden="true">
                    <span>{place.shortName}</span>
                  </div>
                )}
                <div class="reise-card-shade" aria-hidden="true"></div>
                <span class="reise-card-number">{place.number}</span>
                <span class="reise-card-badge">{place.badge}</span>
                <div class="reise-card-media-title">
                  <small>{place.provinceArea}</small>
                  <h3>{place.name}</h3>
                </div>
              </div>

              <div class="reise-card-body">
                <p class="reise-card-why">{place.whyFeatureIt}</p>
                <div class="reise-card-chips">
                  {place.highlights.slice(0, 3).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <div class="reise-card-footer">
                  <button
                    type="button"
                    class="inspect-map-btn"
                    data-inspect-destination={place.id}
                  >
                    <span>Show on Map & Details</span>
                    <span aria-hidden="true">↑</span>
                  </button>
                  <a href="/journeys/" class="plan-mini-link">
                    Plan route <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<section class="catalogue-section" id="island-catalogue" aria-labelledby="catalogue-heading" data-island-catalogue>
  <div class="catalogue-container">
    <div class="catalogue-intro">
      <div>
        <span class="section-kicker-dark">Islandwide Destination Directory · {catalogueEntries.length} Entries</span>
        <h2 id="catalogue-heading">Explore every corner of Sri Lanka.</h2>
        <p class="catalogue-lead">
          Spanning all 25 administrative districts, our directory unites {featuredCount} flagship regional hubs, {coreCount} core destinations and district capitals, {extendedCount} hidden gems, and {attractionCount} cultural, coastal, and waterfall landmarks.
        </p>
      </div>
      <div class="catalogue-counter-box">
        <strong data-catalogue-count>{catalogueEntries.length}</strong>
        <span>places matching filters</span>
      </div>
    </div>

    <div class="catalogue-filter-panel" aria-label="Filter the islandwide destination directory">
      <div class="tier-tabs" role="group" aria-label="Filter by catalogue tier">
        <button type="button" class="tier-tab active" data-tier-filter="all" aria-pressed="true">
          <span>All Directory</span>
          <small>{catalogueEntries.length}</small>
        </button>
        <button type="button" class="tier-tab" data-tier-filter="featured" aria-pressed="false">
          <span>Featured Hubs</span>
          <small>{featuredCount}</small>
        </button>
        <button type="button" class="tier-tab" data-tier-filter="core" aria-pressed="false">
          <span>Main Directory</span>
          <small>{coreCount}</small>
        </button>
        <button type="button" class="tier-tab" data-tier-filter="extended" aria-pressed="false">
          <span>Hidden Gems</span>
          <small>{extendedCount}</small>
        </button>
        <button type="button" class="tier-tab" data-tier-filter="attraction" aria-pressed="false">
          <span>Regional Attractions</span>
          <small>{attractionCount}</small>
        </button>
      </div>

      <div class="catalogue-controls-row">
        <div class="catalogue-search-wrap">
          <label class="sr-only" for="catalogue-search-input">Search all destinations and attractions</label>
          <svg class="cat-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
            <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            id="catalogue-search-input"
            type="search"
            class="catalogue-search"
            placeholder="Search 25 district cities, waterfalls, beaches, national parks, temples..."
            autocomplete="off"
            data-catalogue-search
          />
        </div>

        <div class="catalogue-category-pills" role="group" aria-label="Filter directory by theme">
          <button type="button" class="cat-theme-pill active" data-cat-theme="all" aria-pressed="true">
            All Themes
          </button>
          {
            catalogueThemes.map((cat) => (
              <button type="button" class="cat-theme-pill" data-cat-theme={cat.id} aria-pressed="false">
                {cat.shortLabel}
              </button>
            ))
          }
        </div>
      </div>

      <div class="catalogue-region-pills" role="group" aria-label="Filter directory by region">
        <button type="button" class="cat-region-pill active" data-cat-region="all" aria-pressed="true">
          All 7 Regions
        </button>
        {
          destinationRegions.map((region) => (
            <button type="button" class="cat-region-pill" data-cat-region={region.id} aria-pressed="false">
              {region.shortName}
            </button>
          ))
        }
      </div>
    </div>

    <div class="catalogue-empty" data-catalogue-empty hidden>
      <p>No destinations or attractions match your current filter selection.</p>
      <button type="button" class="catalogue-reset-btn" data-catalogue-reset>
        Reset all directory filters
      </button>
    </div>

    <div class="regional-sections">
      {
        destinationRegions.map((region) => {
          const regionEntries = catalogueEntries.filter((entry) => entry.regionId === region.id);
          const regionHubs = featuredByRegion.get(region.id) ?? [];
          const anchorPhoto = regionHubs.find((h) => h.images.length > 0)?.images[0];

          return (
            <section
              class="region-cluster-section"
              data-region-section={region.id}
              aria-labelledby={`region-heading-${region.id}`}
            >
              <div class="region-banner">
                {anchorPhoto && (
                  <Image
                    src={anchorPhoto.src}
                    alt={anchorPhoto.alt}
                    widths={[640, 1024]}
                    sizes="(max-width: 900px) 94vw, 86rem"
                    loading="lazy"
                    decoding="async"
                    class="region-banner-img"
                  />
                )}
                <div class="region-banner-shade" aria-hidden="true"></div>
                <div class="region-banner-content">
                  <div class="region-banner-copy">
                    <span class="region-kicker">Regional Travel Cluster</span>
                    <h3 id={`region-heading-${region.id}`}>{region.name}</h3>
                    <p>{region.description}</p>
                  </div>
                  <div class="region-hub-pills">
                    <span class="hub-pills-label">Featured Map Hubs:</span>
                    <div class="hub-pills-row">
                      {regionHubs.map((hub) => (
                        <button
                          type="button"
                          class="region-hub-btn"
                          data-inspect-destination={hub.id}
                        >
                          <span>{hub.number} · {hub.shortName}</span>
                          <span aria-hidden="true">↑</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <div class="catalogue-cards-grid">
                {regionEntries.map((entry) => {
                  const allCategories = [entry.categoryId, ...(entry.alsoCategoryIds ?? [])].join(' ');
                  const cardPhoto = catalogueCardImages[entry.id] ?? (entry.tier === 'featured' ? hubImageById.get(entry.id) : null);
                  return (
                    <article
                      class:list={[
                        'catalogue-card',
                        `tier-${entry.tier}`,
                        `cat-${entry.categoryId}`,
                        cardPhoto ? 'has-card-photo' : 'no-card-photo',
                      ]}
                      data-catalogue-item
                      data-item-tier={entry.tier}
                      data-item-region={entry.regionId}
                      data-item-category={entry.categoryId}
                      data-item-categories={allCategories}
                      data-item-search={`${entry.name} ${entry.provinceArea} ${entry.categoryLabel} ${entry.description} ${entry.tags.join(' ')} ${entry.hubName}`.toLowerCase()}
                    >
                      {cardPhoto && (
                        <div class="catalogue-card-media">
                          <Image
                            src={cardPhoto.src}
                            alt={cardPhoto.alt}
                            widths={[360, 540, 720]}
                            sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw"
                            loading="lazy"
                            decoding="async"
                            class="catalogue-card-img"
                            style={`object-position: ${cardPhoto.objectPosition || 'center 45%'};`}
                          />
                          <div class="catalogue-card-shade" aria-hidden="true" />
                          {cardPhoto.credit && (
                            <span class="catalogue-card-credit" title={`Photo: ${cardPhoto.credit}`}>
                              {cardPhoto.credit}
                            </span>
                          )}
                        </div>
                      )}

                      <div class="catalogue-card-content">
                        <div class="card-top-meta">
                          <span class={`tier-pill tier-pill-${entry.tier}`}>{entry.tierLabel}</span>
                          <span class="cat-pill">{entry.categoryLabel}</span>
                        </div>

                        <p class="card-province">{entry.provinceArea}</p>
                        <h4 class="card-title">{entry.name}</h4>
                        <p class="card-description">{entry.description}</p>

                        <div class="card-tags">
                          {entry.tags.map((tag) => (
                            <span class="card-tag">{tag}</span>
                          ))}
                        </div>

                        <div class="card-bottom-bar">
                          <button
                            type="button"
                            class="hub-jump-btn"
                            data-inspect-destination={entry.hubId}
                            title={`Highlight ${entry.hubName} on the interactive island map`}
                          >
                            <span>{entry.tier === 'featured' ? 'Show on Map:' : 'Hub:'} <strong>{entry.hubName}</strong></span>
                            <span aria-hidden="true">↑ Map</span>
                          </button>
                          <a href="/journeys/" class="card-plan-link">
                            Add to trip <span aria-hidden="true">→</span>
                          </a>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const inspectButtons = document.querySelectorAll<HTMLButtonElement>('[data-inspect-destination]');
  inspectButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.inspectDestination;
      if (!id) return;
      btn.dispatchEvent(new CustomEvent('destination-select', { bubbles: true, detail: { id } }));
      const explorer = document.getElementById('interactive-explorer');
      explorer?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-island-catalogue]').forEach((catalogue) => {
    const tierButtons = [...catalogue.querySelectorAll<HTMLButtonElement>('[data-tier-filter]')];
    const themeButtons = [...catalogue.querySelectorAll<HTMLButtonElement>('[data-cat-theme]')];
    const regionButtons = [...catalogue.querySelectorAll<HTMLButtonElement>('[data-cat-region]')];
    const searchInput = catalogue.querySelector<HTMLInputElement>('[data-catalogue-search]')!;
    const cards = [...catalogue.querySelectorAll<HTMLElement>('[data-catalogue-item]')];
    const sections = [...catalogue.querySelectorAll<HTMLElement>('[data-region-section]')];
    const countEl = catalogue.querySelector<HTMLElement>('[data-catalogue-count]')!;
    const emptyEl = catalogue.querySelector<HTMLElement>('[data-catalogue-empty]')!;
    const resetBtn = catalogue.querySelector<HTMLButtonElement>('[data-catalogue-reset]');

    let activeTier = 'all';
    let activeTheme = 'all';
    let activeRegion = 'all';

    const updateCatalogue = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visibleTotal = 0;

      cards.forEach((card) => {
        const matchTier = activeTier === 'all' || card.dataset.itemTier === activeTier;
        const itemCats = (card.dataset.itemCategories ?? card.dataset.itemCategory ?? '').split(' ');
        const matchTheme = activeTheme === 'all' || itemCats.includes(activeTheme);
        const matchRegion = activeRegion === 'all' || card.dataset.itemRegion === activeRegion;
        const matchQuery = !query || (card.dataset.itemSearch ?? '').includes(query);
        const visible = matchTier && matchTheme && matchRegion && matchQuery;
        card.hidden = !visible;
        if (visible) visibleTotal += 1;
      });

      sections.forEach((section) => {
        const sectionCards = [...section.querySelectorAll<HTMLElement>('[data-catalogue-item]')];
        const hasVisibleCard = sectionCards.some((c) => !c.hidden);
        section.hidden = !hasVisibleCard;
      });

      countEl.textContent = String(visibleTotal);
      emptyEl.hidden = visibleTotal > 0;
    };

    tierButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTier = btn.dataset.tierFilter ?? 'all';
        tierButtons.forEach((b) => {
          const isSelected = b === btn;
          b.classList.toggle('active', isSelected);
          b.setAttribute('aria-pressed', String(isSelected));
        });
        updateCatalogue();
      });
    });

    themeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTheme = btn.dataset.catTheme ?? 'all';
        themeButtons.forEach((b) => {
          const isSelected = b === btn;
          b.classList.toggle('active', isSelected);
          b.setAttribute('aria-pressed', String(isSelected));
        });
        updateCatalogue();
      });
    });

    regionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeRegion = btn.dataset.catRegion ?? 'all';
        regionButtons.forEach((b) => {
          const isSelected = b === btn;
          b.classList.toggle('active', isSelected);
          b.setAttribute('aria-pressed', String(isSelected));
        });
        updateCatalogue();
      });
    });

    searchInput.addEventListener('input', updateCatalogue);

    resetBtn?.addEventListener('click', () => {
      activeTier = 'all';
      activeTheme = 'all';
      activeRegion = 'all';
      searchInput.value = '';
      tierButtons.forEach((b) => {
        const isAll = b.dataset.tierFilter === 'all';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-pressed', String(isAll));
      });
      themeButtons.forEach((b) => {
        const isAll = b.dataset.catTheme === 'all';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-pressed', String(isAll));
      });
      regionButtons.forEach((b) => {
        const isAll = b.dataset.catRegion === 'all';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-pressed', String(isAll));
      });
      updateCatalogue();
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-jump-region]').forEach((link) => {
      link.addEventListener('click', () => {
        const targetRegion = link.dataset.jumpRegion;
        if (!targetRegion) return;
        const matchingBtn = regionButtons.find((b) => b.dataset.catRegion === targetRegion);
        if (matchingBtn) matchingBtn.click();
      });
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .catalogue-container {
    width: min(100%, 88rem);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  /* ==========================================================================
     PART 1: FEATURED DESTINATIONS SHOWCASE (REISE CEYLON PHOTO CARDS)
     ========================================================================== */
  .featured-showcase-section {
    scroll-margin-top: 5.5rem;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    background:
      radial-gradient(ellipse at 15% 10%, rgba(217, 154, 69, 0.16), transparent 36rem),
      radial-gradient(ellipse at 85% 90%, rgba(20, 91, 89, 0.45), transparent 40rem),
      linear-gradient(180deg, #0c3835 0%, #114744 50%, #0d3634 100%);
    color: var(--color-ivory);
    border-top: 1px solid rgba(246, 241, 231, 0.14);
    border-bottom: 1px solid rgba(246, 241, 231, 0.14);
  }

  .showcase-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-kicker-light {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
    color: var(--color-gold-light);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .section-kicker-light::before {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-amber);
    content: '';
  }

  .showcase-header h2 {
    margin: 0;
    color: var(--color-ivory);
    font: 500 clamp(2.1rem, 4vw, 3.4rem)/1.02 var(--font-serif);
    letter-spacing: -0.03em;
  }

  .showcase-lead {
    max-width: 56ch;
    margin: 0.65rem 0 0;
    color: rgba(246, 241, 231, 0.8);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .showcase-stat-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .showcase-stat-pills span {
    padding: 0.4rem 0.78rem;
    border: 1px solid rgba(246, 241, 231, 0.24);
    border-radius: 999px;
    background: rgba(246, 241, 231, 0.08);
    color: var(--color-gold-light);
    font-size: 0.7rem;
    font-weight: 650;
    backdrop-filter: blur(10px);
  }

  .featured-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .reise-featured-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(246, 241, 231, 0.22);
    border-radius: 1.2rem;
    background: rgba(255, 252, 245, 0.09);
    box-shadow:
      0 18px 38px rgba(4, 22, 20, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(16px) saturate(125%);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .reise-featured-card:hover {
    transform: translateY(-4px);
    border-color: rgba(233, 199, 121, 0.65);
    box-shadow:
      0 24px 46px rgba(4, 22, 20, 0.46),
      inset 0 1px 0 rgba(255, 255, 255, 0.32);
  }

  .reise-card-media {
    position: relative;
    height: 13.5rem;
    overflow: hidden;
    background: #0a302e;
    isolation: isolate;
  }

  .reise-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) brightness(0.92);
    transition: transform 600ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  .reise-featured-card:hover .reise-card-img {
    transform: scale(1.045);
  }

  .reise-card-fallback {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    background:
      radial-gradient(circle at 75% 25%, rgba(217, 154, 69, 0.32), transparent 55%),
      linear-gradient(135deg, #104542, #1b5e55);
    color: var(--color-gold-light);
    font: 600 1.6rem var(--font-serif);
  }

  .reise-card-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(6, 26, 24, 0.35) 0%, transparent 38%, rgba(6, 26, 24, 0.9) 100%);
  }

  .reise-card-number {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    display: grid;
    min-width: 2rem;
    min-height: 2rem;
    place-items: center;
    padding: 0.15rem 0.45rem;
    border: 1px solid rgba(246, 241, 231, 0.36);
    border-radius: 999px;
    background: rgba(7, 36, 33, 0.65);
    color: var(--color-gold-light);
    font: 600 0.85rem var(--font-serif);
    backdrop-filter: blur(10px);
  }

  .reise-card-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    padding: 0.28rem 0.62rem;
    border: 1px solid rgba(246, 241, 231, 0.34);
    border-radius: 999px;
    background: rgba(20, 91, 89, 0.72);
    color: var(--color-ivory);
    font: 650 0.62rem/1.1 var(--font-sans);
    letter-spacing: 0.04em;
    backdrop-filter: blur(10px);
  }

  .reise-card-media-title {
    position: absolute;
    right: 0.95rem;
    bottom: 0.85rem;
    left: 0.95rem;
    z-index: 2;
  }

  .reise-card-media-title small {
    display: block;
    margin-bottom: 0.18rem;
    color: var(--color-gold-light);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .reise-card-media-title h3 {
    margin: 0;
    color: #ffffff;
    font: 600 clamp(1.35rem, 1.9vw, 1.65rem)/1.05 var(--font-serif);
  }

  .reise-card-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 1rem 1rem 1.05rem;
  }

  .reise-card-why {
    margin: 0;
    color: rgba(246, 241, 231, 0.88);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .reise-card-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .reise-card-chips span {
    padding: 0.24rem 0.55rem;
    border: 1px solid rgba(246, 241, 231, 0.2);
    border-radius: 999px;
    background: rgba(246, 241, 231, 0.08);
    color: rgba(246, 241, 231, 0.92);
