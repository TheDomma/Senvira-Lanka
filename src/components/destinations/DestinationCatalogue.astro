  /* Liquid Glass Cards */
  .reise-featured-card,
  .catalogue-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 1.25rem;
    background: linear-gradient(165deg, rgba(14, 58, 55, 0.44), rgba(4, 25, 23, 0.68));
    box-shadow:
      0 20px 45px -14px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.26),
      inset 0 0 20px rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(28px) saturate(140%);
    -webkit-backdrop-filter: blur(28px) saturate(140%);
    transition: transform 220ms cubic-bezier(0.2, 0.65, 0.3, 1), border-color 220ms ease, box-shadow 220ms ease;
  }

  .reise-featured-card:hover,
  .reise-featured-card.is-selected-hub,
  .catalogue-card:hover {
    transform: translateY(-4px);
    border-color: rgba(233, 199, 121, 0.65);
    box-shadow:
      0 26px 52px -12px rgba(0, 0, 0, 0.75),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.42),
      inset 0 0 24px rgba(233, 199, 121, 0.08);
  }

  .reise-card-media {
    position: relative;
    height: auto;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #06201e;
    flex: 0 0 auto;
    isolation: isolate;
  }

  .reise-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    filter: saturate(1.02) brightness(0.96);
    transition: transform 550ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  .reise-featured-card:hover .reise-card-img {
    transform: scale(1.045);
  }

  .reise-card-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.8rem;
    padding: 1.05rem 1.15rem 1.15rem;
    background: transparent;
