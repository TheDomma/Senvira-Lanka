---
import { getImage, Image } from 'astro:assets';
import Hero from './Hero.astro';
import sigiriyaImage from '../assets/images/background/sigiriya1.jpg';
import anuradhapuraImage from '../assets/images/destinations/anuradhapura-panorama.jpg';
import ellaImage from '../assets/images/destinations/ella-nine-arch-licensed.webp';
import coastImage from '../assets/images/destinations/south-coast-tangalle-drone.webp';
import safariImage from '../assets/images/experiences/elephant-safari.jpg';
import railImage from '../assets/images/destinations/ella-nine-arch-train.png';
import peraheraImage from '../assets/images/experiences/kandy-esala-perahera.jpg';
import oceanImage from '../assets/images/destinations/mirissa-beach-entrance.jpg';
import kandyImage from '../assets/images/destinations/kandy-temple-lake.webp';
import yalaImage from '../assets/images/destinations/yala.jpg';
import nuwaraEliyaImage from '../assets/images/destinations/nuwara-eliya-tea-entrance.jpg';
import galleImage from '../assets/images/destinations/galle.jpg';
import mirissaImage from '../assets/images/destinations/mirissa-coastline.webp';
import bentotaImage from '../assets/images/destinations/bentota-aerial.webp';

const startingPoints = [
  {
    id: 'sigiriya',
    number: '01',
    title: 'Sigiriya',
    places: 'UNESCO Citadel',
    region: 'Cultural Triangle · North Central Province',
    featuredName: 'Sigiriya',
    description: 'A stone citadel rising above forest, gardens and the broad plains of the island’s ancient heartland.',
    image: sigiriyaImage,
    alt: 'Sigiriya Rock rising above a misty green forest.',
    href: '/destinations/#sigiriya',
  },
  {
    id: 'kandy',
    number: '02',
    title: 'Kandy',
    places: 'Royal Cultural Capital',
    region: 'Hill Capital · Central Province',
    featuredName: 'Kandy',
    description: 'A lakeside city of sacred heritage, evening light and green hills at the gateway to the highlands.',
    image: kandyImage,
    alt: 'The Temple of the Tooth glowing beside the water in Kandy at dusk.',
    href: '/destinations/#kandy',
  },
  {
    id: 'ella',
    number: '03',
    title: 'Ella',
    places: 'Highland Paradise',
    region: 'Uva Highlands · Hill Country',
    featuredName: 'Ella',
    description: 'Tea-covered slopes, wooded ridgelines and a much-loved railway crossing through the hills.',
    image: ellaImage,
    alt: 'A blue train crossing the Nine Arch Bridge in Ella, framed by forest.',
    href: '/destinations/#ella',
  },
  {
    id: 'nuwara-eliya',
    number: '04',
    title: 'Nuwara Eliya',
    places: 'Little England',
    region: 'Central Highlands · Central Province',
    featuredName: 'Nuwara Eliya',
    description: 'Cool air, tea-covered hills and quiet walks around Gregory Lake give this highland town its own pace.',
    image: nuwaraEliyaImage,
    alt: 'Green tea slopes and misty mountain ridges in Sri Lanka’s highlands near Nuwara Eliya.',
    href: '/destinations/#nuwara-eliya',
  },
  {
    id: 'yala-national-park',
    number: '05',
    title: 'Yala National Park',
    places: 'Leopard Country',
    region: 'National parks · Southern Province',
    featuredName: 'Yala National Park',
    description: 'Dry-zone forest, lagoons and open plains shape one of the island’s most distinctive wildlife regions.',
    image: yalaImage,
    alt: 'Two Asian elephants crossing the open grassland in Yala National Park.',
    href: '/destinations/#yala-national-park',
  },
  {
    id: 'galle-fort',
    number: '06',
    title: 'Galle Fort',
    places: 'Colonial Ocean Fort',
    region: 'Southern Coast · Galle District',
    featuredName: 'Galle Fort',
    description: 'Walk the old ramparts above the ocean, then follow the lanes through the fort’s layered history.',
    image: galleImage,
    alt: 'The Galle Fort lighthouse and old town walls above the Indian Ocean at sunset.',
    href: '/destinations/#galle-fort',
  },
  {
    id: 'mirissa',
    number: '07',
    title: 'Mirissa',
    places: 'Whales & Palms',
    region: 'Southern Coast · Indian Ocean',
    featuredName: 'Mirissa',
    description: 'Palm-framed coves, early whale-watching departures and unhurried afternoons by the sea.',
    image: mirissaImage,
    alt: 'Palm-lined coastline and ocean water at Mirissa in southern Sri Lanka.',
    href: '/destinations/#mirissa',
  },
  {
    id: 'bentota',
    number: '08',
    title: 'Bentota',
    places: 'Golden Coast',
    region: 'Western Coast · Indian Ocean',
    featuredName: 'Bentota',
    description: 'Open beaches, bright shallows and a broad sandy coast made for slower days by the water.',
    image: bentotaImage,
    alt: 'Aerial view of the wide sandy beach at Bentota with small umbrellas along the shore.',
    href: '/destinations/#bentota',
  },
];

const discoverPlaces = await Promise.all(
  startingPoints.map(async (place) => ({
    ...place,
    background: (await getImage({ src: place.image, width: 1200, format: 'webp', quality: 78 })).src,
  })),
);

const experienceCards = [
  {
    number: '01',
    label: 'Wildlife · Udawalawe & Yala',
    title: 'Safari mornings',
    summary: 'Set out early for a closer look at Sri Lanka’s wildlife and wide-open park landscapes.',
    image: safariImage,
    alt: 'An elephant in a Sri Lankan wildlife park.',
  },
  {
    number: '02',
    label: 'Hill Country · Kandy to Ella',
    title: 'The railway through the hills',
    summary: 'Follow the highland line past tea slopes, forest and stone railway bridges.',
    image: railImage,
    alt: 'A blue train travelling over the Nine Arch Bridge in Ella.',
  },
  {
    number: '03',
    label: 'Kandy · Seasonal',
    title: 'Festival nights',
    summary: 'Kandyan drumming, dance and the colour of Esala Perahera in the hill capital.',
    image: peraheraImage,
    alt: 'A ceremonial elephant and dancers during Kandy Esala Perahera.',
  },
  {
    number: '04',
    label: 'Southern Coast · East Coast',
    title: 'Days on the water',
    summary: 'Make room for the ocean, from a slow swim to a day built around the waves.',
    image: oceanImage,
    alt: 'A sandy beach and palm trees beside the Indian Ocean in Sri Lanka.',
  },
];

const packageIdeas = [
  {
    id: 'cultural-triangle-kandy',
    type: 'Heritage & culture',
    title: 'Cultural Triangle & Kandy',
    route: 'Sigiriya · Dambulla · Kandy',
    summary: 'Ancient rock sites, cave temples and time in Sri Lanka’s hill capital.',
    image: anuradhapuraImage,
    alt: 'The white Ruwanwelisaya stupa and garden grounds in Anuradhapura.',
  },
  {
    id: 'tea-country-rail',
    type: 'Highlands & rail',
    title: 'Tea Country by Rail',
    route: 'Kandy · Nuwara Eliya · Ella',
    summary: 'Tea-growing landscapes, cool highland air and the railway to Ella.',
    image: railImage,
    alt: 'The highland train crossing the Nine Arch Bridge in Ella.',
  },
  {
    id: 'wildlife-south-coast',
    type: 'Wildlife & coast',
    title: 'Wildlife & the South Coast',
    route: 'Udawalawe · Yala · Tangalle',
    summary: 'Wildlife park mornings followed by a few days beside the sea.',
    image: coastImage,
    alt: 'Aerial view of Tangalle’s green coastline meeting the Indian Ocean.',
  },
  {
    id: 'island-highlights',
    type: 'A little of everything',
    title: 'Sri Lanka Highlights',
    route: 'Sigiriya · Ella · Galle',
    summary: 'A first look at ancient places, green hills and the southern coast.',
    image: kandyImage,
    alt: 'Kandy Lake and the green hills around the city.',
  },
];

const planningSteps = [
  { number: '01', title: 'Share your trip details', copy: 'Tell us when you hope to travel, who is coming and what you would love to see.' },
  { number: '02', title: 'Meet a local expert', copy: 'Talk through your ideas in a free online consultation.' },
  { number: '03', title: 'Receive a tailored proposal', copy: 'Review a suggested itinerary and a clear travel quotation.' },
  { number: '04', title: 'Refine and confirm', copy: 'Discuss the details, then move ahead with the bookings that suit you.' },
];
---

<Hero />

<section class="philosophy-section" aria-labelledby="philosophy-heading">
  <div class="container philosophy-layout">
    <div class="philosophy-copy" data-reveal>
      <span class="section-kicker">The Senvira way</span>
      <h2 id="philosophy-heading">A journey should feel like time well spent.</h2>
      <p class="philosophy-lead">Sri Lanka has many sides. We help you find the right rhythm between them.</p>
      <p>Rather than rushing from one landmark to the next, we shape thoughtful routes around the places, people and moments that draw you here, from an early walk through ancient gardens to a quiet evening in the hills.</p>
      <a href="/our-story/" class="philosophy-link">Get to know our approach <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="philosophy-image-wrap" data-reveal>
      <Image
        src={anuradhapuraImage}
        alt="The white Ruwanwelisaya stupa and garden grounds in Anuradhapura."
        widths={[480, 720, 960]}
        sizes="(max-width: 800px) 90vw, 42vw"
        loading="lazy"
        decoding="async"
        class="philosophy-image"
      />
      <figcaption><span>Made for a slower look</span><strong>Time among the ancient cities.</strong></figcaption>
    </figure>
  </div>
</section>

<section id="discover" class="discover-section" aria-labelledby="discover-heading">
  <div class="container discover-container">
    <div class="discover-layout">
      <div class="discover-choices" aria-label="Choose a destination to preview">
        <div class="discover-section-heading" data-reveal>
          <span class="section-kicker">A first glimpse of the island</span>
          <h2 id="discover-heading">Choose a place to preview.</h2>
          <p class="section-lead">Move between ancient stones, highland air, wildlife and the coast.</p>
          <a href="/destinations/" class="section-link">All destinations <span aria-hidden="true">↗</span></a>
        </div>
        <div class="discover-selectors">
        {discoverPlaces.map((place, index) => (
          <button
            type="button"
            class="discover-select"
            data-reveal
            style={`--reveal-delay: ${index * 55}ms`}
            data-discover-select
            data-discover-src={place.background}
            data-discover-alt={place.alt}
            data-place-region={place.region}
            data-place-name={place.featuredName}
            data-place-description={place.description}
            data-place-href={place.href}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span class="discover-select-number">{place.number}</span>
            <span class="discover-select-copy"><strong>{place.title}</strong><small>{place.places}</small></span>
            <span class="discover-select-arrow" aria-hidden="true">↗</span>
          </button>
        ))}
        </div>
        <a href={discoverPlaces[0].href} class="discover-details-link" data-discover-link data-reveal>
          <span>View full details for <strong data-discover-link-name>{discoverPlaces[0].featuredName}</strong></span><span aria-hidden="true">↗</span>
        </a>
      </div>

      <figure class="discover-feature" data-reveal>
        <img
          src={discoverPlaces[0].background}
          alt={discoverPlaces[0].alt}
          width="1200"
          height="800"
          decoding="async"
          loading="lazy"
          class="discover-image"
          data-discover-image
        />
        <figcaption class="discover-caption">
          <span data-discover-region>{discoverPlaces[0].region}</span>
          <strong data-discover-name>{discoverPlaces[0].featuredName}</strong>
          <p data-discover-description>{discoverPlaces[0].description}</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section id="experiences" class="experiences-section" aria-labelledby="experiences-heading">
  <div class="container experiences-container">
    <div class="section-heading section-heading-light" data-reveal>
      <div>
        <span class="section-kicker">Beyond the landmarks</span>
        <h2 id="experiences-heading">Find your kind of island day.</h2>
      </div>
      <a href="/experiences/" class="section-link">Explore experiences <span aria-hidden="true">↗</span></a>
    </div>

    <div class="experience-grid">
      {experienceCards.map((experience, index) => (
        <a href="/experiences/" class="experience-card" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
          <Image
            src={experience.image}
            alt={experience.alt}
            widths={[320, 480, 720]}
            sizes="(max-width: 600px) 78vw, (max-width: 1000px) 44vw, 22vw"
            loading="lazy"
            decoding="async"
            class="experience-image"
          />
          <span class="experience-shade" aria-hidden="true"></span>
          <span class="experience-number">{experience.number}</span>
          <span class="experience-copy">
            <small>{experience.label}</small>
            <strong>{experience.title}</strong>
            <span>{experience.summary}</span>
          </span>
          <span class="experience-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <div class="experience-tags" data-reveal>
      <span>More to explore</span>
      <a href="/experiences/#rafting">White-water rafting</a>
      <a href="/experiences/#whale-watching">Whale watching</a>
      <a href="/experiences/#surfing">Surfing</a>
      <a href="/experiences/#scuba-diving">Scuba diving</a>
      <a href="/experiences/#festival-nights">Festival nights</a>
    </div>
  </div>
</section>

<section id="packages" class="packages-section" aria-labelledby="packages-heading">
  <div class="container packages-container">
    <div class="section-heading" data-reveal>
      <div>
        <span class="section-kicker">Package previews · sample itineraries</span>
        <h2 id="packages-heading">Choose a starting point.</h2>
        <p class="section-lead">A few trip styles to picture what your time in Sri Lanka could look like.</p>
      </div>
      <a href="/packages/" class="section-link">All packages <span aria-hidden="true">↗</span></a>
    </div>

    <div class="package-grid">
      {packageIdeas.map((packageIdea, index) => (
        <a href={`/packages/#${packageIdea.id}`} class="package-card" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
          <div class="package-photo">
            <Image
              src={packageIdea.image}
              alt={packageIdea.alt}
              widths={[360, 560, 760]}
              sizes="(max-width: 600px) 88vw, (max-width: 1000px) 44vw, 23vw"
              loading="lazy"
              decoding="async"
              class="package-image"
            />
            <span class="package-type">{packageIdea.type}</span>
            <span class="package-index">0{index + 1}</span>
          </div>
          <span class="package-copy">
            <strong>{packageIdea.title}</strong>
            <small>{packageIdea.route}</small>
            <span>{packageIdea.summary}</span>
            <span class="package-link">View itinerary <span aria-hidden="true">↗</span></span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<section id="planning" class="planning-section" aria-labelledby="planning-heading">
  <div class="container planning-container">
    <div class="planning-heading" data-reveal>
      <span class="section-kicker">How it works</span>
      <h2 id="planning-heading">From first idea to a trip you can look forward to.</h2>
      <p>Get clear on the places, the pace and the practical details before you decide what to book.</p>
    </div>

    <ol class="planning-steps">
      {planningSteps.map((step, index) => (
        <li class="planning-step" data-reveal style={`--reveal-delay: ${index * 110}ms`}>
          <span class="planning-step-number">{step.number}</span>
          <strong>
            {index === 0 && <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M8 3.5v3M16 3.5v3M4 9.5h16M8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>}
            {index === 1 && <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 11.2a7.5 7.5 0 0 1-7.8 7.5 8.2 8.2 0 0 1-3.2-.7L4 19.4l1.2-3.2A7.1 7.1 0 0 1 4.2 11a7.5 7.5 0 0 1 7.8-7.4 7.7 7.7 0 0 1 8 7.6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 10h8M8 13.5h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>}
            {index === 2 && <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 3.5h8l4 4v13H6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3.8v4h4M9 12h6M9 15h3M13.5 18l1.4 1.4 3.1-3.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {index === 3 && <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="m8 12.2 2.6 2.6 5.6-5.7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {step.title}
          </strong>
          <p>{step.copy}</p>
        </li>
      ))}
    </ol>

    <div class="planning-footer" data-reveal>
      <span>Ready to start shaping your trip?</span>
      <div class="planning-actions">
        <a href="/journeys/" class="planning-primary">Plan your trip <span aria-hidden="true">↗</span></a>
        <a href="#contact" class="planning-contact">Ask about a free call</a>
      </div>
    </div>
  </div>
</section>

<a href="#contact" class="floating-chat" aria-label="Jump to Senvira’s contact details" title="Contact Senvira">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M20 11.4a7.7 7.7 0 0 1-8 7.6 8.4 8.4 0 0 1-3.3-.7L4 19.5l1.2-3.3A7.3 7.3 0 0 1 4 11.4a7.7 7.7 0 0 1 8-7.5 7.7 7.7 0 0 1 8 7.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M8.4 10.1h7.2M8.4 13.1h4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
</a>

<script>
  const discoverImage = document.querySelector<HTMLImageElement>('[data-discover-image]');
  const discoverRegion = document.querySelector<HTMLElement>('[data-discover-region]');
  const discoverName = document.querySelector<HTMLElement>('[data-discover-name]');
  const discoverDescription = document.querySelector<HTMLElement>('[data-discover-description]');
  const discoverLink = document.querySelector<HTMLAnchorElement>('[data-discover-link]');
  const discoverLinkName = document.querySelector<HTMLElement>('[data-discover-link-name]');
  const discoverSelectors = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-discover-select]'));

  const selectDiscoverPlace = (selector: HTMLButtonElement) => {
    const nextSrc = selector.dataset.discoverSrc;
    if (!nextSrc || !discoverImage) return;

    discoverSelectors.forEach((item) => item.setAttribute('aria-pressed', String(item === selector)));
    discoverImage.classList.add('is-transitioning');

    const nextImage = new window.Image();
    nextImage.onload = () => {
      discoverImage.src = nextImage.src;
      discoverImage.alt = selector.dataset.discoverAlt || '';
      if (discoverRegion) discoverRegion.textContent = selector.dataset.placeRegion || '';
      if (discoverName) discoverName.textContent = selector.dataset.placeName || '';
      if (discoverDescription) discoverDescription.textContent = selector.dataset.placeDescription || '';
      if (discoverLink) discoverLink.href = selector.dataset.placeHref || '/destinations/';
      if (discoverLinkName) discoverLinkName.textContent = selector.dataset.placeName || '';
      requestAnimationFrame(() => discoverImage.classList.remove('is-transitioning'));
    };
    nextImage.onerror = () => discoverImage.classList.remove('is-transitioning');
    nextImage.src = nextSrc;
  };

  discoverSelectors.forEach((selector) => {
    selector.addEventListener('pointerenter', () => selectDiscoverPlace(selector));
    selector.addEventListener('focus', () => selectDiscoverPlace(selector));
    selector.addEventListener('click', () => selectDiscoverPlace(selector));
  });

  const revealTargets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion && 'IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

    revealTargets.forEach((target) => {
      target.classList.add('reveal-ready');
      revealObserver.observe(target);
    });
  }
</script>

<style>
  .philosophy-section { padding-block: clamp(4rem, 7vw, 6.5rem); background: #f9f6ee; color: #15382e; }
  .philosophy-layout { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(21rem, 1.05fr); align-items: center; gap: clamp(2.5rem, 7vw, 7rem); }
  .philosophy-copy { max-width: 39rem; }
  .philosophy-copy h2 { max-width: 12ch; margin: 0; color: #15382e; font-size: clamp(2.7rem, 5vw, 4.3rem); font-weight: 500; letter-spacing: -0.045em; line-height: 0.99; text-wrap: balance; }
  .philosophy-copy p { max-width: 54ch; margin: 1.15rem 0 0; color: #5d7166; font-size: 0.91rem; line-height: 1.8; }
  .philosophy-copy .philosophy-lead { margin-top: 1.4rem; color: #244e40; font-family: var(--font-serif); font-size: clamp(1.35rem, 2vw, 1.7rem); line-height: 1.35; }
  .philosophy-link { display: inline-flex; align-items: center; gap: 0.65rem; margin-top: 1.55rem; color: #214b3d; font-size: 0.76rem; font-weight: 650; text-decoration: none; }
  .philosophy-link span { color: #9b7133; font-size: 1rem; transition: transform 180ms ease; }
  .philosophy-link:hover span { transform: translate(2px, -2px); }
  .philosophy-image-wrap { position: relative; min-height: 26rem; margin: 0; overflow: hidden; border-radius: 1.15rem; background: #183c30; }
  .philosophy-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 46%; filter: saturate(0.82) brightness(0.9); }
  .philosophy-image-wrap::after { position: absolute; inset: 35% 0 0; background: linear-gradient(0deg, rgba(8, 27, 21, 0.82), transparent); content: ''; }
  .philosophy-image-wrap figcaption { position: absolute; z-index: 1; right: 1.35rem; bottom: 1.35rem; left: 1.35rem; display: grid; gap: 0.35rem; color: #fbf8f0; }
  .philosophy-image-wrap figcaption span { color: #f0d48d; font-size: 0.61rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .philosophy-image-wrap figcaption strong { font-family: var(--font-serif); font-size: clamp(1.5rem, 2.7vw, 2.2rem); font-weight: 500; }

  .discover-section { scroll-margin-top: 5.5rem; padding-block: clamp(3.5rem, 5.5vw, 5.25rem); background: var(--color-ivory); color: var(--color-charcoal); }
  .discover-container, .packages-container { max-width: 88rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: clamp(2rem, 4vw, 3.2rem); }
  .section-kicker { display: block; margin-bottom: 0.78rem; color: var(--color-teal); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
