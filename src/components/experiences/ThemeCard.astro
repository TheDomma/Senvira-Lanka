---
import { Image } from 'astro:assets';
import type { ExperienceTheme } from '../../data/experiences';
import { getExperiencesByTheme } from '../../data/experiences';

export interface Props {
  theme: ExperienceTheme;
}

const { theme } = Astro.props;
const themeExperiences = getExperiencesByTheme(theme.id);
const totalCount = themeExperiences.length;
const topLocations = theme.featuredDestinations.slice(0, 3).map((d) => d.name).join(' · ');
---

<article
  class="theme-card"
  data-theme-card
  data-theme-id={theme.id}
  data-browse-path={theme.browsePath}
>
  <a href={`/experiences/${theme.id}/`} class="theme-card-link" aria-label={`Explore ${theme.title}`}>
    <div class="theme-card-media">
      <Image
        src={theme.image}
        alt={theme.imageAlt}
        class="theme-card-image"
        widths={[400, 640]}
        sizes="(max-width: 767px) 100vw, (max-width: 1120px) 50vw, 33vw"
      />
      <div class="theme-card-overlay" aria-hidden="true"></div>
      <div class="theme-card-badges">
        <span class="theme-number-pill">Theme {theme.number}</span>
        <span class="theme-count-pill">
          {totalCount} {totalCount === 1 ? 'guide' : 'guides'}
        </span>
      </div>
    </div>

    <div class="theme-card-body">
      <h3 class="theme-card-title">{theme.title}</h3>
      <p class="theme-card-summary">{theme.promise}</p>

      <div class="theme-card-footer">
        <span class="theme-card-locations">{topLocations}</span>
        <span class="theme-card-cta">
          Explore
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .theme-card {
    display: flex;
    background: #ffffff;
    border: 1px solid rgba(20, 38, 28, 0.09);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(17, 29, 23, 0.04);
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 220ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 220ms ease;
  }

  .theme-card[hidden] {
    display: none !important;
  }

  .theme-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 34px rgba(17, 29, 23, 0.09);
    border-color: rgba(15, 118, 110, 0.28);
  }

  .theme-card-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .theme-card-link:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: -2px;
  }

  .theme-card-media {
    position: relative;
    aspect-ratio: 16 / 9.5;
    overflow: hidden;
    background: #13251d;
  }

  .theme-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-card:hover .theme-card-image {
    transform: scale(1.04);
  }

  .theme-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(9, 20, 15, 0.38) 0%,
      rgba(9, 20, 15, 0.04) 45%,
      rgba(9, 20, 15, 0.52) 100%
    );
    pointer-events: none;
  }

  .theme-card-badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    z-index: 2;
  }

  .theme-number-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.58rem;
    border-radius: 999px;
    background: rgba(11, 27, 20, 0.74);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #f0d48d;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .theme-count-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.24rem 0.58rem;
    border-radius: 999px;
    background: rgba(251, 248, 240, 0.92);
    color: #14261c;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .theme-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.2rem 1.15rem;
    gap: 0.45rem;
  }

  .theme-card-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.18rem, 1.45vw, 1.35rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: #14261c;
    transition: color 160ms ease;
  }

  .theme-card:hover .theme-card-title {
    color: #0f766e;
  }

  .theme-card-summary {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: #4a5a50;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .theme-card-footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(20, 38, 28, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .theme-card-locations {
    font-size: 0.75rem;
    font-weight: 500;
    color: #5c6c62;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .theme-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #0f766e;
    flex-shrink: 0;
  }

  .theme-card:hover .theme-card-cta svg {
    transform: translateX(2px);
  }

  .theme-card-cta svg {
    transition: transform 160ms ease;
  }
</style>
