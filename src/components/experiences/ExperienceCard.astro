---
import { Image } from 'astro:assets';
import type { ExperienceRecord } from '../../data/experiences';

export interface Props {
  experience: ExperienceRecord;
  context?: 'hub' | 'theme';
}

const { experience, context = 'hub' } = Astro.props;

const allDestinationsString = experience.allDestinationIds.join(',');
const searchIndexText = [
  experience.title,
  experience.summary,
  experience.themeLabel,
  experience.subtypeLabel,
  experience.primaryDestinationName,
  experience.primaryDestinationRegion,
  ...(experience.relatedDestinations?.map((d) => d.name) ?? []),
  experience.seasonSummary,
]
  .join(' ')
  .toLowerCase();

const primaryHref = experience.hasDetailGuide
  ? `/experiences/${experience.themeId}/${experience.id}/`
  : context === 'hub'
    ? `/experiences/${experience.themeId}/#${experience.id}`
    : `/destinations/#${experience.primaryDestinationId}`;

const primaryLinkLabel = experience.hasDetailGuide
  ? 'Read activity guide'
  : context === 'hub'
    ? `Explore ${experience.themeLabel}`
    : `View ${experience.primaryDestinationName} in Destinations`;

const isUnverified = experience.editorialStatus !== 'reviewed';
const editorialLabel =
  experience.editorialStatus === 'proposed'
    ? 'Proposed · Verify locally'
    : experience.editorialStatus === 'research-needed'
      ? 'Research needed'
      : null;
---

<article
  id={experience.id}
  class:list={['exp-card', { 'is-unverified': isUnverified }]}
  data-experience-card
  data-id={experience.id}
  data-browse-path={experience.browsePath}
  data-theme={experience.themeId}
  data-subtype={experience.subtypeId}
  data-destination={experience.primaryDestinationId}
  data-all-destinations={allDestinationsString}
  data-region={experience.regionId}
  data-status={experience.editorialStatus}
  data-search-text={searchIndexText}
>
  <a href={primaryHref} class="exp-card-media" tabindex="-1" aria-hidden="true">
    <Image
      src={experience.image}
      alt={experience.imageAlt}
      class="exp-card-image"
      widths={[400, 680]}
      sizes="(max-width: 767px) 100vw, (max-width: 1180px) 50vw, 33vw"
    />
    <div class="exp-card-scrim"></div>
    <span class="exp-card-tag">{experience.subtypeLabel}</span>
    {editorialLabel && (
      <span class="exp-card-editorial-flag">{editorialLabel}</span>
    )}
  </a>

  <div class="exp-card-body">
    <div class="exp-card-kicker">
      <a href={`/destinations/#${experience.primaryDestinationId}`} class="exp-card-destination">
        {experience.primaryDestinationName}
      </a>
      <span class="exp-card-dot" aria-hidden="true">·</span>
      <span class="exp-card-effort">{experience.effort}</span>
    </div>

    <h3 class="exp-card-title">
      <a href={primaryHref}>{experience.title}</a>
    </h3>

    <p class="exp-card-summary">{experience.summary}</p>

    <p class="exp-card-detail">
      <strong>Season:</strong> {experience.seasonSummary}
    </p>

    <div class="exp-card-footer">
      <a href={primaryHref} class="exp-card-cta">
        <span>{primaryLinkLabel}</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .exp-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid rgba(20, 38, 28, 0.09);
    border-radius: 0.95rem;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(17, 29, 23, 0.035);
    transition:
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 200ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 200ms ease;
    scroll-margin-top: 6rem;
  }

  .exp-card.is-unverified {
    background: #faf7f0;
    border-style: dashed;
    border-color: rgba(146, 98, 24, 0.28);
  }

  .exp-card[hidden] {
    display: none !important;
  }

  .exp-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(17, 29, 23, 0.075);
    border-color: rgba(15, 118, 110, 0.26);
  }

  .exp-card-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #13251d;
    text-decoration: none;
  }

  .exp-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .exp-card:hover .exp-card-image {
    transform: scale(1.03);
  }

  .exp-card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 19, 15, 0.38) 0%,
      rgba(8, 19, 15, 0) 48%,
      rgba(8, 19, 15, 0.28) 100%
    );
    pointer-events: none;
  }

  .exp-card-tag {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.58rem;
    border-radius: 999px;
    background: rgba(10, 26, 20, 0.76);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #f8f5ec;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    max-width: calc(100% - 1.4rem);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .exp-card-editorial-flag {
    position: absolute;
    bottom: 0.65rem;
    left: 0.7rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.52rem;
    border-radius: 999px;
    background: rgba(254, 243, 199, 0.94);
    color: #78350f;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .exp-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 1.15rem 1.05rem;
    gap: 0.45rem;
  }

  .exp-card-kicker {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.74rem;
    line-height: 1.3;
    color: #5a6b60;
  }

  .exp-card-destination {
    font-weight: 700;
    color: #0f766e;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .exp-card-destination:hover {
    text-decoration: underline;
  }

  .exp-card-dot {
    color: #95a39a;
  }

  .exp-card-effort {
    font-weight: 500;
    color: #5a6b60;
    flex-shrink: 0;
  }

  .exp-card-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.14rem, 1.3vw, 1.26rem);
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.015em;
    color: #14261c;
  }

  .exp-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .exp-card-title a:hover {
    color: #0f766e;
  }

  .exp-card-summary {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.54;
    color: #48584e;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .exp-card-detail {
    margin: 0.15rem 0 0;
    font-size: 0.76rem;
    line-height: 1.42;
    color: #526258;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .exp-card-detail strong {
    color: #1c3024;
    font-weight: 600;
  }

  .exp-card-footer {
    margin-top: auto;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(20, 38, 28, 0.07);
    display: flex;
    align-items: center;
  }

  .exp-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #0f766e;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .exp-card-cta:hover {
    color: #0b5852;
  }

  .exp-card-cta svg {
    transition: transform 150ms ease;
  }

  .exp-card-cta:hover svg {
    transform: translateX(2px);
  }
</style>
