---
import { Image } from 'astro:assets';
import type { ExperienceRecord } from '../../data/experiences';

export interface Props {
  experience: ExperienceRecord;
  context?: 'hub' | 'theme';
}

const { experience, context: _context = 'hub' } = Astro.props;

const allDestinationsString = experience.allDestinationIds.join(',');
const searchIndexText = [
  experience.title,
  experience.summary,
  experience.themeLabel,
  experience.subtypeLabel,
  experience.primaryDestinationName,
  experience.primaryDestinationRegion,
  ...(experience.relatedDestinations?.map((d) => d.name) ?? []),
  experience.seasonSummary,
]
  .join(' ')
  .toLowerCase();

const guideHref = `/experiences/${experience.themeId}/${experience.id}/`;
const destinationHref = `/destinations/#${experience.primaryDestinationId}`;

const isUnverified = experience.editorialStatus !== 'reviewed';
const editorialLabel =
  experience.editorialStatus === 'proposed'
    ? 'Proposed · Verify locally'
    : experience.editorialStatus === 'research-needed'
      ? 'Research needed'
      : null;
---

<article
  id={experience.id}
  class:list={['exp-card', { 'is-unverified': isUnverified }]}
  data-experience-card
  data-id={experience.id}
  data-browse-path={experience.browsePath}
  data-theme={experience.themeId}
  data-subtype={experience.subtypeId}
  data-destination={experience.primaryDestinationId}
  data-all-destinations={allDestinationsString}
  data-region={experience.regionId}
  data-status={experience.editorialStatus}
  data-search-text={searchIndexText}
>
  <a href={guideHref} class="exp-card-media" tabindex="-1" aria-hidden="true">
    <Image
      src={experience.image}
      alt={experience.imageAlt}
      class="exp-card-image"
      widths={[400, 680]}
      sizes="(max-width: 767px) 100vw, (max-width: 1180px) 50vw, 33vw"
    />
    <div class="exp-card-scrim"></div>
    <span class="exp-card-tag">{experience.subtypeLabel}</span>
    {editorialLabel && (
      <span class="exp-card-editorial-flag">{editorialLabel}</span>
    )}
  </a>

  <div class="exp-card-body">
    <div class="exp-card-kicker">
      <a href={destinationHref} class="exp-card-destination" title={`View ${experience.primaryDestinationName} in Destinations directory`}>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        <span>{experience.primaryDestinationName}</span>
      </a>
      <span class="exp-card-dot" aria-hidden="true">·</span>
      <span class="exp-card-effort">{experience.effort}</span>
    </div>

    <h3 class="exp-card-title">
      <a href={guideHref}>{experience.title}</a>
    </h3>

    <p class="exp-card-summary">{experience.summary}</p>

    <div class="exp-card-meta">
      <p class="exp-card-detail">
        <strong class="meta-label">Season:</strong>
        <span>{experience.seasonSummary}</span>
      </p>

      {experience.relatedDestinations && experience.relatedDestinations.length > 0 && (
        <div class="exp-card-related">
          <span class="related-label">Also:</span>
          <div class="related-pills">
            {experience.relatedDestinations.slice(0, 2).map((rel) => (
              <a href={`/destinations/#${rel.id}`} class="related-pill" title={`${rel.name}: ${rel.relationship}`}>
                {rel.name}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="exp-card-footer">
      <a href={guideHref} class="exp-card-cta-primary">
        <span>Read activity guide</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>

      <a href={destinationHref} class="exp-card-cta-secondary" title={`View ${experience.primaryDestinationName} on the island map`}>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>
        </svg>
        <span>Map</span>
      </a>
    </div>
  </div>
</article>

<style>
  .exp-card {
    display: flex;
    flex-direction: column;
    background: #072623;
    background: linear-gradient(178deg, rgba(8, 42, 38, 0.82) 0%, rgba(5, 30, 27, 0.90) 100%);
    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
    border: 1px solid rgba(246, 241, 231, 0.16);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow:
      0 14px 34px rgba(3, 20, 18, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    color: #fbf8f0;
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 220ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 200ms ease;
    scroll-margin-top: 6rem;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .exp-card {
      background: linear-gradient(178deg, #092f2b 0%, #05211f 100%);
    }
  }

  .exp-card.is-unverified {
    border-style: dashed;
    border-color: rgba(217, 154, 69, 0.55);
  }

  .exp-card[hidden] {
    display: none !important;
  }

  .exp-card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 22px 46px rgba(3, 20, 18, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
    border-color: rgba(240, 212, 141, 0.50);
  }

  .exp-card-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #062320;
    text-decoration: none;
  }

  .exp-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .exp-card:hover .exp-card-image {
    transform: scale(1.03);
  }

  .exp-card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(4, 22, 20, 0.45) 0%,
      rgba(4, 22, 20, 0.05) 50%,
      rgba(4, 22, 20, 0.55) 100%
    );
    pointer-events: none;
  }

  .exp-card-tag {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 0.24rem 0.6rem;
    border-radius: 999px;
    background: rgba(4, 24, 22, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(240, 212, 141, 0.38);
    color: #f0d48d;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    max-width: calc(100% - 1.4rem);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .exp-card-editorial-flag {
    position: absolute;
    bottom: 0.65rem;
    left: 0.7rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.52rem;
    border-radius: 999px;
    background: rgba(45, 28, 6, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(240, 180, 70, 0.5);
    color: #fef3c7;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .exp-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.05rem 1.15rem 1.1rem;
    gap: 0.45rem;
  }

  .exp-card-kicker {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.74rem;
    line-height: 1.3;
    color: #99f6e4;
  }

  .exp-card-destination {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 700;
    color: #5eead4;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .exp-card-destination:hover {
    color: #f0d48d;
    text-decoration: underline;
  }

  .exp-card-dot {
    color: rgba(246, 241, 231, 0.45);
  }

  .exp-card-effort {
    font-weight: 600;
    color: rgba(246, 241, 231, 0.78);
    flex-shrink: 0;
  }

  .exp-card-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.3vw, 1.28rem);
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.015em;
    color: #fbf8f0;
  }

  .exp-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .exp-card-title a:hover {
    color: #f0d48d;
  }

  .exp-card-summary {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.54;
    color: rgba(246, 241, 231, 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .exp-card-meta {
    margin-top: 0.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .exp-card-detail {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.42;
    color: rgba(246, 241, 231, 0.75);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .exp-card-detail strong {
    color: #f0d48d;
    font-weight: 600;
    margin-right: 0.25rem;
  }

  .exp-card-related {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
  }

  .related-label {
    color: rgba(246, 241, 231, 0.6);
    font-weight: 600;
  }

  .related-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .related-pill {
    display: inline-block;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    background: rgba(20, 91, 89, 0.42);
    border: 1px solid rgba(246, 241, 231, 0.18);
    color: #99f6e4;
    font-size: 0.68rem;
    text-decoration: none;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .related-pill:hover {
    background: rgba(20, 91, 89, 0.75);
    border-color: rgba(240, 212, 141, 0.5);
    color: #f0d48d;
  }

  .exp-card-footer {
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(246, 241, 231, 0.14);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .exp-card-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #f0d48d;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .exp-card-cta-primary:hover {
    color: #fef08a;
  }

  .exp-card-cta-primary svg {
    transition: transform 150ms ease;
  }

  .exp-card-cta-primary:hover svg {
    transform: translateX(2px);
  }

  .exp-card-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: rgba(246, 241, 231, 0.08);
    border: 1px solid rgba(246, 241, 231, 0.2);
    color: rgba(246, 241, 231, 0.85);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .exp-card-cta-secondary:hover {
    background: rgba(246, 241, 231, 0.16);
    border-color: rgba(240, 212, 141, 0.45);
    color: #f0d48d;
  }
</style>
