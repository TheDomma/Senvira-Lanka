---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationDirectory from '../components/destinations/DestinationDirectory.astro';
import DestinationDetail from '../components/destinations/DestinationDetail.astro';
import SriLankaMap from '../components/destinations/SriLankaMap.astro';
import DestinationCatalogue from '../components/destinations/DestinationCatalogue.astro';
import { catalogueEntries, destinations, destinationRegions, mappedDestinations } from '../data/destinations';
import heroBgImage from '../assets/images/gallery/pidurangala.jpg';

const initialDestination = mappedDestinations[0];
const aliasEntries = mappedDestinations.flatMap((d) => [
  [d.id, d.id],
  ...(d.aliases ?? []).map((alias) => [alias, d.id]),
]);
const aliasMapJson = JSON.stringify(Object.fromEntries(aliasEntries));

const totalCatalogueCount = catalogueEntries.length;
const coreCount = catalogueEntries.filter((e) => e.tier === 'core').length;
const extendedCount = catalogueEntries.filter((e) => e.tier === 'extended').length;
const attractionCount = catalogueEntries.filter((e) => e.tier === 'attraction').length;
---

<BaseLayout
  title="Explore Sri Lanka's Destinations | Senvira Lanka"
  description={`Browse ${totalCatalogueCount} Sri Lankan destinations and attractions across all 25 districts, explore our interactive island map, and start shaping a journey that feels like yours.`}
>
  <div class="destinations-page" data-destination-page data-alias-map={aliasMapJson}>
    <header class="destinations-hero" aria-labelledby="page-title">
      <div class="hero-bg-media" aria-hidden="true">
        <Image
          src={heroBgImage}
          alt=""
          widths={[960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          decoding="async"
          class="hero-bg-image"
        />
        <div class="hero-bg-veil"></div>
      </div>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-container">
        <div class="hero-intro">
          <p class="hero-eyebrow">Senvira Lanka · Islandwide Directory</p>
          <h1 id="page-title">Find your place in <em>Sri Lanka.</em></h1>
          <p class="hero-copy">
            From northern lagoons and ancient stone capitals to misty tea ridges, waterfalls, and southern coves, explore {totalCatalogueCount} curated places across all 25 districts and seven distinct regions of the island.
          </p>
        </div>

        <nav class="hero-tier-nav" aria-label="Jump to directory sections">
          <a href="#interactive-explorer" class="tier-nav-pill">
            <strong>{destinations.length}</strong>
            <span>Interactive Map Hubs</span>
          </a>
          <a href="#featured-hubs" class="tier-nav-pill">
            <strong>{destinations.length}</strong>
            <span>Featured Photo Cards</span>
          </a>
          <a href="#island-catalogue" class="tier-nav-pill">
            <strong>{coreCount}</strong>
            <span>Core Destinations</span>
          </a>
          <a href="#island-catalogue" class="tier-nav-pill">
            <strong>{extendedCount}</strong>
            <span>Hidden Gems</span>
          </a>
          <a href="#island-catalogue" class="tier-nav-pill">
            <strong>{attractionCount}</strong>
            <span>Regional Attractions</span>
          </a>
        </nav>
      </div>
    </header>

    <section
      id="interactive-explorer"
      class="explorer-section"
      aria-label="Interactive Sri Lanka destination explorer"
    >
      <div class="explorer-container">
        <div class="explorer-layout">
          <aside class="map-column" aria-labelledby="map-heading">
            <SriLankaMap
              destinations={mappedDestinations}
              regions={destinationRegions}
              selectedId={initialDestination.id}
            />
          </aside>

          <div class="selector-detail-column">
            <div class="directory-controls-wrap">
              <DestinationDirectory
                destinations={mappedDestinations}
                regions={destinationRegions}
                selectedId={initialDestination.id}
              />
            </div>

            <div class="detail-panels" aria-live="polite" aria-atomic="true" data-detail-panels>
              {
                mappedDestinations.map((destination, index) => (
                  <div data-detail-panel={destination.id} hidden={index !== 0}>
                    <DestinationDetail destination={destination} />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <DestinationCatalogue />

    <button
      type="button"
      class="back-to-top-btn"
      aria-label="Back to top"
      title="Back to top"
      data-back-to-top
      hidden
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 19V5M12 5l-6 6M12 5l6 6"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
</BaseLayout>

<script>
  const pages = document.querySelectorAll<HTMLElement>('[data-destination-page]');
  pages.forEach((page) => {
    const backToTopBtn = page.querySelector<HTMLButtonElement>('[data-back-to-top]');
    if (backToTopBtn) {
      const toggleBackToTop = () => {
        backToTopBtn.hidden = window.scrollY < 380;
      };
      window.addEventListener('scroll', toggleBackToTop, { passive: true });
      toggleBackToTop();
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    let aliasMap: Record<string, string> = {};
    try {
      aliasMap = JSON.parse(page.dataset.aliasMap || '{}');
    } catch {
      aliasMap = {};
    }

    const panels = [...page.querySelectorAll<HTMLElement>('[data-detail-panel]')];
    const validIds = new Set(
      panels.map((panel) => panel.dataset.detailPanel).filter((id): id is string => Boolean(id)),
    );
    const firstId = panels[0]?.dataset.detailPanel;
    if (!firstId) return;

    const resolveId = (rawId: string): string | undefined => {
      const normalized = rawId.trim().toLowerCase();
      if (validIds.has(normalized)) return normalized;
      const mapped = aliasMap[normalized];
      if (mapped && validIds.has(mapped)) return mapped;
      return undefined;
    };

    const mapSection = page.querySelector<HTMLElement>('[data-sri-lanka-map]');

    const setMapActiveSelection = (activeId: string | null) => {
      const hasPin = Boolean(activeId);
      mapSection?.classList.toggle('has-active-selection', hasPin);
      page.querySelectorAll<HTMLButtonElement>('.map-marker[data-destination-id]').forEach((marker) => {
        const isSelected = Boolean(activeId && marker.dataset.destinationId === activeId);
        marker.classList.toggle('active', isSelected);
        marker.setAttribute('aria-pressed', String(isSelected));
      });
    };

    const select = (
      rawId: string,
      updateFragment = false,
      revealOnMap = true,
      scrollChipInStrip = false,
    ) => {
      const id = resolveId(rawId);
      if (!id) return;

      if (revealOnMap) {
        setMapActiveSelection(id);
      } else {
        setMapActiveSelection(null);
      }

      page.querySelectorAll<HTMLButtonElement>('[data-chip-item][data-destination-id]').forEach((button) => {
        const selected = button.dataset.destinationId === id;
        button.classList.toggle('active', selected);
        button.setAttribute('aria-pressed', String(selected));
        // Never call button.scrollIntoView: it scrolls the window and causes mobile viewport jumps.
        // Instead, smoothly scroll only the horizontal chip strip container if requested during user interaction.
        if (selected && scrollChipInStrip) {
          const strip = button.closest<HTMLElement>('[data-slider-strip]');
          if (strip) {
            const chipLeft = button.offsetLeft;
            const chipWidth = button.offsetWidth;
            const stripScroll = strip.scrollLeft;
            const stripWidth = strip.clientWidth;
            if (chipLeft < stripScroll) {
              strip.scrollTo({ left: Math.max(0, chipLeft - 16), behavior: 'smooth' });
            } else if (chipLeft + chipWidth > stripScroll + stripWidth) {
              strip.scrollTo({ left: chipLeft + chipWidth - stripWidth + 16, behavior: 'smooth' });
            }
          }
        }
      });

      const choice = page.querySelector<HTMLSelectElement>('[data-select]');
      if (choice && choice.value !== id) {
        choice.value = id;
      }

      panels.forEach((panel) => {
        const selected = panel.dataset.detailPanel === id;
        panel.hidden = !selected;
        panel.setAttribute('aria-hidden', String(!selected));
      });

      page.querySelectorAll<HTMLElement>('[data-featured-card]').forEach((card) => {
        card.classList.toggle('is-selected-hub', revealOnMap && card.dataset.featuredCard === id);
      });

      page.querySelectorAll<HTMLElement>('[data-mapped-card]').forEach((card) => {
        card.classList.toggle('is-selected-card', revealOnMap && card.dataset.mappedCard === id);
      });

      if (updateFragment && window.location.hash !== `#${id}`) {
        window.history.replaceState(null, '', `${window.location.pathname}${window.location.search}#${id}`);
      }
    };

    page.addEventListener('destination-select', (event) => {
      const detail = (event as CustomEvent<{ id?: string; solo?: boolean; scrollToMap?: boolean }>).detail;
      if (detail?.id) {
        select(detail.id, true, true, true);
      }
    });

    page.addEventListener('map-reset', () => {
      select(firstId, true, true, true);
    });

    page.addEventListener('explorer-filters-change', (event) => {
      const detail = (event as CustomEvent<{ region: string; category: string; query: string }>).detail;
      if (!detail) return;
      const { region, category } = detail;

      mapSection?.classList.toggle('has-category-filter', region !== 'all' || category !== 'all');
      page.querySelectorAll<HTMLButtonElement>('.map-marker.is-hub').forEach((marker) => {
        const markerRegion = marker.dataset.markerRegion ?? '';
        const markerCats = (marker.dataset.markerCategories ?? marker.dataset.markerCategory ?? '').split(' ');
        const matchRegion = region === 'all' || markerRegion === region;
        const matchCategory = category === 'all' || markerCats.includes(category);
        marker.classList.toggle('is-dimmed', !(matchRegion && matchCategory));
      });
    });

    window.addEventListener('hashchange', () => {
      try {
        const currentHash = decodeURIComponent(window.location.hash.slice(1));
        const resolved = currentHash ? resolveId(currentHash) : undefined;
        if (resolved) {
          select(resolved, false, true, true);
          const explorer = document.getElementById('interactive-explorer');
          explorer?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch {
        // Ignore malformed URI
      }
    });

    let fragmentId = '';
    try {
      fragmentId = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      fragmentId = '';
    }
    const resolvedFragment = fragmentId ? resolveId(fragmentId) : undefined;
    if (resolvedFragment) {
      // Intentional navigation to a specific destination via URL/hash (e.g. from homepage starting points)
      select(resolvedFragment, false, true, true);
      const explorer = document.getElementById('interactive-explorer');
      explorer?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      // Clean initial visit or section anchor: default selection without scroll or hash overwrite
      select(firstId, false, true, false);
    }
  });
</script>

<style>
  .destinations-page {
    --dp-bg: #031413;
    --dp-bg-2: #052320;
    --dp-teal-deep: #073835;
    --dp-teal: #0c4d49;
    --dp-glass: rgba(8, 44, 40, 0.52);
    --dp-glass-strong: rgba(4, 26, 24, 0.78);
    --dp-glass-border: rgba(246, 241, 231, 0.14);
    --dp-glass-edge: rgba(255, 255, 255, 0.08);
    --dp-text: #f6f1e7;
    --dp-text-soft: rgba(246, 241, 231, 0.78);
    min-height: 100vh;
    background:
      radial-gradient(ellipse at 10% 0%, rgba(11, 79, 75, 0.35), transparent 42rem),
      radial-gradient(ellipse at 100% 30%, rgba(217, 154, 69, 0.05), transparent 36rem),
      linear-gradient(180deg, var(--dp-bg) 0%, var(--dp-bg-2) 50%, var(--dp-bg) 100%);
    color: var(--dp-text);
  }

  /* HERO */
  .destinations-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: calc(5.2rem + clamp(2.5rem, 5vw, 4rem)) clamp(1.125rem, 4vw, 2.5rem) clamp(2.5rem, 4.5vw, 3.5rem);
    background: #031514;
    color: var(--color-ivory);
    border-bottom: 1px solid rgba(246, 241, 231, 0.12);
  }

  .hero-bg-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    filter: saturate(0.96) contrast(1.02) brightness(0.82);
    transform: scale(1.02);
  }

  .hero-bg-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 82% 18%, rgba(217, 154, 69, 0.14), transparent 34rem),
      linear-gradient(96deg, rgba(2, 16, 15, 0.9) 0%, rgba(4, 28, 26, 0.76) 52%, rgba(3, 20, 19, 0.62) 100%),
      linear-gradient(180deg, rgba(2, 14, 13, 0.6) 0%, transparent 38%, rgba(3, 20, 19, 0.94) 100%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: min(100%, 88rem);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.75rem;
  }

  .hero-intro { max-width: 44rem; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 0.85rem;
    color: #f0d48d;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-eyebrow::before {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #e9c66f;
    content: '';
  }

  .destinations-hero h1 {
    margin: 0;
    color: #fbf8f0;
    font: 500 var(--text-hero-subpage, clamp(2.15rem, 3.8vw, 3.25rem))/1.1 var(--font-serif);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .destinations-hero h1 em { color: #f0d48d; font-weight: 500; }

  .hero-copy {
    max-width: 52ch;
    margin: 1rem 0 0;
    color: rgba(250, 248, 240, 0.82);
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    line-height: 1.7;
  }

  .hero-tier-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .tier-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid rgba(246, 241, 231, 0.16);
    border-radius: 999px;
    background: rgba(7, 36, 32, 0.55);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    color: var(--color-ivory);
    font-size: 0.72rem;
    text-decoration: none;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .tier-nav-pill:hover {
    border-color: rgba(240, 212, 141, 0.5);
    background: rgba(14, 58, 52, 0.7);
    transform: translateY(-1px);
  }

  .tier-nav-pill strong {
    color: #f0d48d;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* EXPLORER */
  .explorer-section {
    scroll-margin-top: 5.2rem;
    padding: clamp(2rem, 3.5vw, 3rem) clamp(1.125rem, 4vw, 2.5rem) clamp(2.5rem, 4vw, 3.5rem);
    background:
      radial-gradient(ellipse at 15% 25%, rgba(11, 79, 75, 0.3), transparent 34rem),
      radial-gradient(ellipse at 90% 10%, rgba(217, 154, 69, 0.05), transparent 28rem);
  }

  .explorer-container { width: min(100%, 88rem); margin-inline: auto; }

  .explorer-layout {
    display: grid;
    grid-template-columns: minmax(21rem, 29rem) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(1rem, 1.8vw, 1.35rem);
  }

  .map-column,
  .selector-detail-column {
    min-width: 0;
    border: 1px solid rgba(246, 241, 231, 0.12);
    border-radius: 1.25rem;
    background:
      linear-gradient(165deg, rgba(8, 42, 39, 0.65), rgba(4, 24, 22, 0.82));
    box-shadow:
      0 18px 40px -18px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px) saturate(130%);
    -webkit-backdrop-filter: blur(20px) saturate(130%);
  }

  .map-column {
    display: flex;
    flex-direction: column;
    padding: clamp(0.95rem, 1.6vw, 1.25rem);
  }

  .selector-detail-column {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(0.95rem, 1.6vw, 1.25rem);
  }

  .directory-controls-wrap {
    padding-bottom: 0.95rem;
    border-bottom: 1px solid rgba(246, 241, 231, 0.1);
  }

  .detail-panels { flex: 1 1 auto; min-width: 0; display: flex; }
  .detail-panels > [data-detail-panel] { flex: 1 1 auto; display: flex; min-width: 0; }
  .detail-panels > [hidden] { display: none !important; }

  .back-to-top-btn {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 45;
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(246, 241, 231, 0.18);
    border-radius: 999px;
    background: rgba(7, 34, 31, 0.75);
    box-shadow:
      0 14px 32px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    color: #f0d48d;
    cursor: pointer;
    backdrop-filter: blur(24px) saturate(135%);
    -webkit-backdrop-filter: blur(24px) saturate(135%);
    transition: transform 200ms cubic-bezier(0.2, 0.65, 0.3, 1), background-color 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 200ms ease;
  }

  .back-to-top-btn[hidden] {
    display: none !important;
  }

  .back-to-top-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(240, 212, 141, 0.6);
    background: rgba(14, 58, 52, 0.88);
    color: #ffffff;
    box-shadow:
      0 18px 38px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  @media (max-width: 60rem) {
    .explorer-layout { grid-template-columns: minmax(0, 1fr); }
    .map-column { max-width: 32rem; width: 100%; margin-inline: auto; }
  }

  @media (max-width: 54rem) {
    .destinations-hero { padding-top: calc(4.35rem + 1.75rem); }
    .destinations-hero h1 {
      font-size: var(--text-hero-subpage-mobile, clamp(1.95rem, 6.8vw, 2.75rem));
      line-height: 1.08;
    }
  }

  @media (max-width: 34rem) {
    .destinations-hero h1 {
      font-size: var(--text-hero-subpage-narrow, clamp(1.8rem, 6.2vw, 2.35rem));
      line-height: 1.1;
    }
  }

  @media (max-width: 40rem) {
    .destinations-hero,
    .explorer-section { padding-inline: 0.95rem; }
    .selector-detail-column { padding: 0.85rem; }
  }
</style>
