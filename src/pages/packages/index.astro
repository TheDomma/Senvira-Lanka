---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageCard from '../../components/packages/PackageCard.astro';
import PackageEnquiryForm from '../../components/packages/PackageEnquiryForm.astro';
import {
  bands,
  costStatusLabel,
  formatRange,
  getBand,
  getPackageImage,
  getPackagesByBand,
  getPackagesByTheme,
  hubFaq,
  launchPackages,
  officialLinks,
  plannedPackages,
  PRICE_BASIS_POINTS,
  PRICE_BASIS_SHORT,
  PRICE_DISCLAIMER,
  PRICE_LABEL,
  REVIEW_DATE,
  standardCosts,
  themes,
  TIER_NOTE,
  TIERS,
} from '../../data/packages';

const pageTitle = 'Sri Lanka Tour Packages & Sample Itineraries | Senvira Lanka';
const pageDescription =
  'Browse 12 thoughtfully paced Sri Lanka itinerary starting points from 4 to 21 days, plus 12 custom-quoted draft routes. Compare durations, travel styles, seasonal notes, and transparent land-only planning budgets.';

const heroImage = getPackageImage('nuwara-eliya-tea');

const durationBudgetMatrix = [
  { band: '4–5 days', budget: 'US$250–450', comfort: 'US$450–850', premium: 'US$1,000–1,900+' },
  { band: '6–7 days', budget: 'US$350–650', comfort: 'US$650–1,250', premium: 'US$1,500–3,000+' },
  { band: '8–10 days', budget: 'US$500–900', comfort: 'US$900–1,850', premium: 'US$2,000–4,300+' },
  { band: '12–14 days', budget: 'US$750–1,250', comfort: 'US$1,350–2,600', premium: 'US$3,000–6,000+' },
  { band: '15–16 days', budget: 'US$900–1,450', comfort: 'US$1,650–3,000', premium: 'US$3,600–6,800+' },
  { band: '20–22 days', budget: 'US$1,200–2,000', comfort: 'US$2,200–4,100', premium: 'US$5,000–9,000+' },
  { band: '28–30 days', budget: 'US$1,700–2,800', comfort: 'US$3,200–5,800', premium: 'US$7,000–13,000+' },
];

const launchBands = bands.filter((b) => b.id !== 'twenty-eight-thirty');
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="packages-hub">
    <!-- 1. Editorial Hero -->
    <header class="hub-hero" data-hero-surface aria-labelledby="hub-title">
      <div class="hub-hero-bg" aria-hidden="true">
        <Image
          src={heroImage.src}
          alt={heroImage.alt}
          class="hub-hero-img"
          widths={[960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          decoding="async"
        />
        <div class="hub-hero-overlay"></div>
      </div>

      <div class="container hub-hero-inner">
        <div class="hero-intro">
          <p class="hero-eyebrow">Senvira Lanka · Private Land-Only Itineraries</p>
          <h1 id="hub-title">
            Choose a journey by time, then shape it around your <em>travel month.</em>
          </h1>
          <p class="hero-copy">
            Every route below is a practical starting point for a private Sri Lankan trip—built with realistic road pacing, multi-night bases, and honest seasonal caveats. Compare 12 launch itineraries from 4 to 21 days, or ask us to adapt any route to your dates and party.
          </p>

          <div class="hero-actions">
            <a href="#catalogue" class="hero-btn hero-btn-primary">
              <span>Browse 12 launch itineraries</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
            <a href="#enquiry" class="hero-btn hero-btn-secondary">
              <span>Request a confirmed quote</span>
            </a>
          </div>

          <div class="hero-basis-strip" role="note" aria-label="Pricing and planning status">
            <strong>{PRICE_LABEL}:</strong> {PRICE_BASIS_SHORT} · Reviewed {REVIEW_DATE}. Accommodation/breakfast and core private ground transport assumed; most entry, safari/jeep, rail and optional activity fees excluded unless confirmed in a written quote.
          </div>
        </div>
      </div>
    </header>

    <!-- 2. Browse by Duration, Theme & Budget Tier Controls + Catalogue -->
    <section id="catalogue" class="hub-section" aria-labelledby="catalogue-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-eyebrow">01 · Curated Starting Points</p>
            <h2 id="catalogue-heading">Explore itineraries by duration, style &amp; budget basis</h2>
          </div>
          <p class="section-subcopy">
            We keep multiple distinct choices at each trip length rather than forcing every visitor onto a single loop.
          </p>
        </div>

        <!-- Filter & Budget Tier Panel -->
        <div class="hub-controls" role="region" aria-label="Filter packages by duration, travel style and planning tier">
          <div class="filter-block">
            <span class="filter-label" id="duration-filter-label">1. Trip duration</span>
            <div class="pill-row" role="group" aria-labelledby="duration-filter-label">
              <button
                type="button"
                class="filter-pill is-active"
                data-filter-band="all"
                aria-pressed="true"
              >
                All launch lengths ({launchPackages.length})
              </button>
              {launchBands.map((band) => {
                const count = getPackagesByBand(band.id).length;
                return (
                  <button
                    type="button"
                    class="filter-pill"
                    data-filter-band={band.id}
                    aria-pressed="false"
                  >
                    {band.label} · {band.range} ({count})
                  </button>
                );
              })}
              <a href="#draft-portfolio" class="filter-pill filter-pill-link">
                28–30 days &amp; draft routes (12) &darr;
              </a>
            </div>
          </div>

          <div class="filter-block">
            <span class="filter-label" id="theme-filter-label">2. Travel style &amp; focus</span>
            <div class="pill-row" role="group" aria-labelledby="theme-filter-label">
              <button
                type="button"
                class="filter-pill is-active"
                data-filter-theme="all"
                aria-pressed="true"
              >
                All styles ({launchPackages.length})
              </button>
              {themes.map((t) => {
                const count = getPackagesByTheme(t.id).length;
                return (
                  <button
                    type="button"
                    class="filter-pill"
                    data-filter-theme={t.id}
                    aria-pressed="false"
                  >
                    {t.label} ({count})
                  </button>
                );
              })}
            </div>
          </div>

          <div class="tier-selector-bar">
            <div class="tier-selector-left">
              <span class="filter-label" id="tier-selector-label">3. Highlighted planning tier on cards</span>
              <div class="tier-buttons" role="group" aria-labelledby="tier-selector-label">
                {TIERS.map((tier) => (
                  <button
                    type="button"
                    class:list={['tier-btn', { 'is-active': tier.id === 'comfort' }]}
                    data-select-tier={tier.id}
                    aria-pressed={tier.id === 'comfort' ? 'true' : 'false'}
                  >
                    <strong>{tier.label}</strong>
                    <span>{tier.assumption}</span>
                  </button>
                ))}
              </div>
            </div>
            <p class="tier-assumption-note">
              <strong>Basis beside every range:</strong> {PRICE_BASIS_SHORT} (reviewed {REVIEW_DATE}). {TIER_NOTE}
            </p>
          </div>

          <div class="hub-status-row">
            <p class="hub-status-text" data-hub-status aria-live="polite">
              Showing all <strong>{launchPackages.length}</strong> launch itineraries (Comfort tier highlighted)
            </p>
            <button type="button" class="reset-btn" data-hub-reset hidden>
              Reset filters
            </button>
          </div>
        </div>

        <!-- Package Cards Grid -->
        <div class="packages-grid" data-packages-grid>
          {launchPackages.map((pkg) => (
            <PackageCard pkg={pkg} />
          ))}
        </div>

        <!-- Empty state when duration + theme combination has no launch card -->
        <div class="empty-state" data-hub-empty hidden>
          <h3>No launch package matches that exact duration and style pair</h3>
          <p>
            Try resetting either the duration or the travel style filter, or inspect the 12 additional draft concepts below. Any route can be adapted to your dates.
          </p>
          <button type="button" class="btn btn-primary" data-hub-empty-reset>
            Show all {launchPackages.length} launch packages
          </button>
        </div>
      </div>
    </section>

    <!-- 3. Browse by Travel Theme Overview -->
    <section id="by-theme" class="hub-section hub-section-alt" aria-labelledby="themes-overview-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-eyebrow">02 · Browse by Motivation</p>
            <h2 id="themes-overview-heading">Which Sri Lanka journey fits how you travel?</h2>
          </div>
          <p class="section-subcopy">
            Select a theme to filter the launch catalogue above and compare routes built for that interest.
          </p>
        </div>

        <div class="theme-cards-grid">
          {themes.map((t) => {
            const matching = getPackagesByTheme(t.id);
            return (
              <article class="theme-overview-card">
                <div class="theme-card-top">
                  <h3>{t.label}</h3>
                  <span class="theme-count">{matching.length} {matching.length === 1 ? 'route' : 'routes'}</span>
                </div>
                <p>{t.blurb}</p>
                <ul class="theme-sample-links">
                  {matching.slice(0, 3).map((p) => (
                    <li>
                      <a href={`/packages/${p.slug}/`}>
                        {p.title} ({p.days}d/{p.nights}n) &rarr;
                      </a>
                    </li>
                  ))}
                </ul>
                <button
                  type="button"
                  class="theme-jump-btn"
                  data-jump-theme={t.id}
                >
                  Filter cards by {t.label}
                </button>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 4. How Pricing Works & Indicative Planning Budget Table -->
    <section id="pricing-guide" class="hub-section" aria-labelledby="pricing-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-eyebrow">03 · Transparent Price Basis</p>
            <h2 id="pricing-heading">How indicative planning budgets work</h2>
          </div>
          <p class="section-subcopy">
            Reviewed {REVIEW_DATE}. {PRICE_DISCLAIMER}
          </p>
        </div>

        <div class="pricing-layout">
          <div class="pricing-table-card">
            <div class="table-caption-bar">
              <strong>{PRICE_LABEL} by duration</strong>
              <span>{PRICE_BASIS_SHORT} · reviewed {REVIEW_DATE}</span>
            </div>
            <div class="table-scroll">
              <table class="budget-table">
                <thead>
                  <tr>
                    <th scope="col">Duration</th>
                    <th scope="col">Budget<br /><small>Simpler stays</small></th>
                    <th scope="col">Comfort<br /><small>Modest hotels / boutique guesthouses</small></th>
                    <th scope="col">Premium<br /><small>Upscale / boutique stays</small></th>
                  </tr>
                </thead>
                <tbody>
                  {durationBudgetMatrix.map((row) => (
                    <tr>
                      <th scope="row">{row.band}</th>
                      <td>{row.budget}</td>
                      <td><strong>{row.comfort}</strong></td>
                      <td>{row.premium}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <ul class="basis-points-list">
              {PRICE_BASIS_POINTS.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </div>

          <div class="inclusions-summary-card">
            <h3>Standard cost treatment across routes</h3>
            <p class="inclusions-intro">
              Every package detail page labels each cost line explicitly so nothing is hidden in fine print:
            </p>
            <ul class="standard-cost-list">
              {standardCosts.map((item) => (
                <li class="std-cost-item">
                  <span class={`std-pill std-pill-${item.status}`}>
                    {costStatusLabel[item.status]}
                  </span>
                  <div>
                    <strong>{item.label}</strong>
                    {item.note && <p>{item.note}</p>}
                  </div>
                </li>
              ))}
            </ul>

            <div class="official-sources-box">
              <h4>Official regulatory &amp; ticket references (checked {REVIEW_DATE})</h4>
              <ul>
                {officialLinks.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} &nearr;</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Seasonal Guidance -->
    <section id="seasonal-guidance" class="hub-section hub-section-alt" aria-labelledby="seasonal-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-eyebrow">04 · Month-Aware Planning</p>
            <h2 id="seasonal-heading">Matching your route to Sri Lanka’s two monsoons</h2>
          </div>
          <p class="section-subcopy">
            Sri Lanka is a year-round destination when your coast and wildlife parks are chosen for the month you travel. Weather is variable, so treat seasonal guidance as a planning aid rather than a guarantee.
          </p>
        </div>

        <div class="season-cards-grid">
          <article class="season-card">
            <span class="season-tag">December to April</span>
            <h3>South Coast, West Coast &amp; High Peaks</h3>
            <p>
              Generally drier and calmer along Galle, Unawatuna, Weligama, Mirissa, Tangalle and Bentota, as well as the central highlands and Adam’s Peak. Best fit for <em>Colombo, Galle &amp; the South Coast</em>, <em>Classic Island Journey</em>, and <em>Wild Landscapes &amp; Southern Coast</em>.
            </p>
          </article>

          <article class="season-card">
            <span class="season-tag">May to September</span>
            <h3>East Coast, Jaffna Peninsula &amp; Dry-Zone Tanks</h3>
            <p>
              Calmer seas shift to Trincomalee, Nilaveli and Pasikuda, while dry-season water levels draw elephants toward Minneriya and Kaudulla reservoirs. Best fit for <em>Northern Heritage &amp; Jaffna</em>, <em>North &amp; East Discovery</em>, and <em>North, East &amp; Cultural Heart</em>.
            </p>
          </article>

          <article class="season-card">
            <span class="season-tag">Year-Round Principles</span>
            <h3>Responsible Wildlife, Rail &amp; Heritage Etiquette</h3>
            <p>
              Wild animal sightings, clear mountain views and specific train seats are never guaranteed. We follow SLTDA wildlife guidelines (no crowding, baiting or in-water marine mammal interaction) and distinguish drivers from licensed site guides.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- 6. Held / Draft Portfolio (Remaining 12 Routes from the 24-Route Brief) -->
    <section id="draft-portfolio" class="hub-section" aria-labelledby="draft-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-eyebrow">05 · Planned &amp; Extended Inventory (12 Draft Concepts)</p>
            <h2 id="draft-heading">Additional routes &amp; 28–30 day stays available by custom quote</h2>
          </div>
          <p class="section-subcopy">
            Our research portfolio spans 24 distinct concepts. We launched with 12 complete itineraries above and hold the remaining 12 as draft concepts while supplier logistics, long-stay rates or specialist safety checks are finalised. You can still enquire about any of them below.
          </p>
        </div>

        <div class="drafts-grid">
          {plannedPackages.map((draft) => {
            const bandInfo = getBand(draft.band);
            return (
              <article class="draft-card">
                <div class="draft-top">
                  <span class="draft-badge">Draft #{draft.briefNo} · {bandInfo.label}</span>
                  <span class="draft-duration">{draft.days} days / {draft.nights} nights</span>
                </div>
                <h3>{draft.title}</h3>
                <p class="draft-route"><strong>Route:</strong> {draft.route}</p>
                <p class="draft-audience"><strong>For:</strong> {draft.audience}</p>
                <p class="draft-budget">
                  <strong>Indicative Comfort range:</strong> {formatRange(draft.budget.comfort)} <small>({PRICE_BASIS_SHORT})</small>
                </p>
                <p class="draft-reason">
                  <strong>Why held as draft:</strong> {draft.heldBecause}
                </p>
                <a
                  href="#enquiry"
                  class="draft-enquire-link"
                  data-enquire-draft={`${draft.title} — ${draft.days} days (Draft concept #${draft.briefNo})`}
                >
                  Enquire about this draft route &rarr;
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 7. Custom Quote Enquiry Form -->
    <div class="hub-section hub-section-enquiry">
      <div class="container">
        <PackageEnquiryForm />
      </div>
    </div>

    <!-- 8. Frequently Asked Questions & Image Ledger Note -->
    <section id="faq" class="hub-section" aria-labelledby="faq-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-eyebrow">06 · Practical Questions</p>
            <h2 id="faq-heading">Frequently asked questions</h2>
          </div>
        </div>

        <div class="faq-grid">
          {hubFaq.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>

        <aside class="hub-image-credit-note" aria-label="Hero image credit">
          <strong>Photography &amp; rights ledger:</strong> Hero photograph ({heroImage.subject}) by {heroImage.creator} via {heroImage.platform} (<a href={heroImage.licenseUrl} target="_blank" rel="noopener noreferrer">{heroImage.license}</a>, <a href={heroImage.sourceUrl} target="_blank" rel="noopener noreferrer">source</a>). Every package card and itinerary day uses only photographs documented in the project image ledgers.
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initPackagesHub() {
    const bandBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-band]'));
    const themeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-theme]'));
    const tierBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-select-tier]'));
    const jumpThemeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-jump-theme]'));
    const draftLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-enquire-draft]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-package-card]'));
    const statusEl = document.querySelector<HTMLElement>('[data-hub-status]');
    const resetBtn = document.querySelector<HTMLButtonElement>('[data-hub-reset]');
    const emptyBox = document.querySelector<HTMLElement>('[data-hub-empty]');
    const emptyResetBtn = document.querySelector<HTMLButtonElement>('[data-hub-empty-reset]');

    let activeBand = 'all';
    let activeTheme = 'all';
    let activeTier = 'comfort';

    function updateCards() {
      let visibleCount = 0;
      for (const card of cards) {
        const cardBand = card.dataset.band || '';
        const cardThemes = (card.dataset.themes || '').split(',');
        const matchBand = activeBand === 'all' || cardBand === activeBand;
        const matchTheme = activeTheme === 'all' || cardThemes.includes(activeTheme);
        const visible = matchBand && matchTheme;
        card.hidden = !visible;
        if (visible) visibleCount += 1;

        const tierRows = card.querySelectorAll<HTMLElement>('[data-card-tier]');
        tierRows.forEach((row) => {
          row.hidden = row.dataset.cardTier !== activeTier;
        });
      }

      const hasFilter = activeBand !== 'all' || activeTheme !== 'all';
      if (resetBtn) resetBtn.hidden = !hasFilter;
      if (emptyBox) emptyBox.hidden = visibleCount > 0;

      if (statusEl) {
        const tierLabel = activeTier.charAt(0).toUpperCase() + activeTier.slice(1);
        statusEl.innerHTML = `Showing <strong>${visibleCount}</strong> of ${cards.length} launch itineraries (${tierLabel} planning tier highlighted)`;
      }
    }

    function setBand(band: string) {
      activeBand = band;
      bandBtns.forEach((b) => {
        const current = b.dataset.filterBand === band;
        b.classList.toggle('is-active', current);
        b.setAttribute('aria-pressed', String(current));
      });
      updateCards();
    }

    function setTheme(theme: string) {
      activeTheme = theme;
      themeBtns.forEach((b) => {
        const current = b.dataset.filterTheme === theme;
        b.classList.toggle('is-active', current);
        b.setAttribute('aria-pressed', String(current));
      });
      updateCards();
    }

    function setTier(tier: string) {
      activeTier = tier;
      tierBtns.forEach((b) => {
        const current = b.dataset.selectTier === tier;
        b.classList.toggle('is-active', current);
        b.setAttribute('aria-pressed', String(current));
      });
      updateCards();
    }

    bandBtns.forEach((btn) => {
      btn.addEventListener('click', () => setBand(btn.dataset.filterBand || 'all'));
    });

    themeBtns.forEach((btn) => {
      btn.addEventListener('click', () => setTheme(btn.dataset.filterTheme || 'all'));
    });

    tierBtns.forEach((btn) => {
      btn.addEventListener('click', () => setTier(btn.dataset.selectTier || 'comfort'));
    });

    jumpThemeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTheme = btn.dataset.jumpTheme || 'all';
        setBand('all');
        setTheme(targetTheme);
        document.getElementById('catalogue')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    function resetAll() {
      setBand('all');
      setTheme('all');
    }

    resetBtn?.addEventListener('click', resetAll);
    emptyResetBtn?.addEventListener('click', resetAll);

    // Pre-fill enquiry dropdown when clicking a draft card CTA
    draftLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const draftVal = link.dataset.enquireDraft;
        const select = document.querySelector<HTMLSelectElement>('#enq-package');
        if (draftVal && select) {
          select.value = draftVal;
        }
      });
    });

    // Support footer hash anchors (e.g. #cultural-triangle-kandy, #tea-country-rail, #wildlife-south-coast, #island-highlights)
    function applyHashRoute() {
      const hash = window.location.hash.replace(/^#/, '').trim();
      if (!hash) return;

      const footerHashToSlug: Record<string, string> = {
        'cultural-triangle-kandy': 'cultural-triangle-first-taste',
        'tea-country-rail': 'tea-country-scenic-rail',
        'wildlife-south-coast': 'wildlife-and-coast-responsibly',
        'island-highlights': 'classic-island-journey',
      };

      const targetSlug = footerHashToSlug[hash] || hash;
      const targetCard = document.getElementById(targetSlug);
      if (targetCard && targetCard.hasAttribute('data-package-card')) {
        resetAll();
        setTimeout(() => {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 60);
      }
    }

    applyHashRoute();
    window.addEventListener('hashchange', applyHashRoute);
  }

  initPackagesHub();
</script>

<style>
  .packages-hub {
    background: var(--color-ivory, #F6F1E7);
    color: var(--color-charcoal, #263238);
    min-height: 100vh;
  }

  .container {
    width: min(100%, 84rem);
    margin-inline: auto;
    padding-inline: clamp(1.125rem, 4vw, 2.5rem);
  }

  /* Hero */
  .hub-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #072220;
    color: var(--color-ivory, #F6F1E7);
    padding: calc(5.2rem + clamp(2.5rem, 5vw, 4rem)) 0 clamp(2.75rem, 5vw, 4rem);
    border-bottom: 1px solid rgba(246, 241, 231, 0.14);
  }

  .hub-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hub-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    filter: brightness(0.78) contrast(1.03);
    display: block;
  }

  .hub-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(98deg, rgba(6, 28, 26, 0.92) 0%, rgba(8, 38, 36, 0.78) 55%, rgba(6, 28, 26, 0.62) 100%),
      linear-gradient(180deg, rgba(4, 18, 17, 0.55) 0%, transparent 40%, rgba(6, 28, 26, 0.9) 100%);
  }

  .hero-content {
    max-width: 48rem;
  }

  .hero-eyebrow {
