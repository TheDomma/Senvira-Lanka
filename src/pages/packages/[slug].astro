---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageItinerary from '../../components/packages/PackageItinerary.astro';
import PackageRouteSketch from '../../components/packages/PackageRouteSketch.astro';
import PackageEnquiryForm from '../../components/packages/PackageEnquiryForm.astro';
import PackageCard from '../../components/packages/PackageCard.astro';
import {
  commonFaq,
  costStatusLabel,
  formatRange,
  getBand,
  getPackageImage,
  getPackageUsedImages,
  getTheme,
  launchPackages,
  officialLinks,
  PRICE_BASIS_POINTS,
  PRICE_BASIS_SHORT,
  PRICE_DISCLAIMER,
  PRICE_LABEL,
  REVIEW_DATE,
  standardCosts,
  TIERS,
  type TravelPackage,
} from '../../data/packages';

export function getStaticPaths() {
  return launchPackages.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg },
  }));
}

export interface Props {
  pkg: TravelPackage;
}

const { pkg } = Astro.props;
const heroImg = getPackageImage(pkg.heroImage.id);
const bandInfo = getBand(pkg.band);
const primaryThemeInfo = getTheme(pkg.primaryTheme);
const routeLine = pkg.routeNote || pkg.route.join(' → ');

const mergedCosts = [...(pkg.extraCosts ?? []), ...standardCosts];
const includedCosts = mergedCosts.filter((c) => c.status === 'included');
const optionalCosts = mergedCosts.filter((c) => c.status === 'optional');
const excludedCosts = mergedCosts.filter((c) => c.status === 'excluded');

const allFaqs = [...(pkg.faq ?? []), ...commonFaq];
const usedImages = getPackageUsedImages(pkg);

const relatedPackages = launchPackages
  .filter(
    (other) =>
      other.slug !== pkg.slug &&
      (other.primaryTheme === pkg.primaryTheme ||
        other.band === pkg.band ||
        other.themes.some((t) => pkg.themes.includes(t))),
  )
  .slice(0, 3);

const pageTitle = `${pkg.title} (${pkg.days} Days) | Sri Lanka Itinerary | Senvira Lanka`;
const pageDescription = `${pkg.promise} ${pkg.days} days / ${pkg.nights} nights private land-only itinerary concept with day-by-day plan and transparent budget basis.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="pkg-detail-page" data-pkg-detail-page>
    <!-- 1. Hero Above the Fold -->
    <header class="detail-hero" data-hero-surface aria-labelledby="pkg-title">
      <div class="detail-hero-bg" aria-hidden="true">
        <Image
          src={heroImg.src}
          alt={heroImg.alt}
          class="detail-hero-img"
          widths={[960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          decoding="async"
        />
        <div class="detail-hero-overlay"></div>
      </div>

      <div class="container detail-hero-inner">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/packages/">Packages</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{pkg.title}</li>
          </ol>
        </nav>

        <p class="detail-eyebrow">
          {bandInfo.label} · {pkg.days} Days / {pkg.nights} Nights · {primaryThemeInfo.label}
        </p>

        <h1 id="pkg-title">{pkg.title}</h1>
        <p class="detail-promise">{pkg.promise}</p>

        <div class="detail-hero-actions">
          <a href="#enquiry" class="hero-cta-primary">
            <span>Request a confirmed quote</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href="#itinerary" class="hero-cta-secondary">
            Jump to day-by-day itinerary
          </a>
        </div>

        <p class="hero-photo-caption">
          Photo: {heroImg.creator} (<a href={heroImg.licenseUrl} target="_blank" rel="noopener noreferrer">{heroImg.license}</a>)
        </p>
      </div>
    </header>

    <!-- 2. First-Screen Facts & Transparent Price Basis Panel -->
    <section class="summary-strip" aria-label="Trip summary and indicative planning budget">
      <div class="container summary-strip-grid">
        <div class="facts-panel">
          <div class="fact-box">
            <span class="fact-kicker">Duration &amp; Route</span>
            <strong class="fact-main">{pkg.days} days / {pkg.nights} nights</strong>
            <span class="fact-sub">{routeLine}</span>
          </div>

          <div class="fact-box">
            <span class="fact-kicker">Suited To &amp; Style</span>
            <strong class="fact-main">{pkg.audience}</strong>
            <span class="fact-sub">
              Themes: {pkg.themes.map((t) => getTheme(t).label).join(', ')}
            </span>
          </div>

          <div class="fact-box">
            <span class="fact-kicker">Pace &amp; Physical Effort</span>
            <strong class="fact-main">{pkg.pace} pace · {pkg.effort.level} effort</strong>
            <span class="fact-sub">{pkg.effort.note}</span>
          </div>

          <div class="fact-box">
            <span class="fact-kicker">Seasonal Fit &amp; Caveat</span>
            <strong class="fact-main">{pkg.season.fit}</strong>
            <span class="fact-sub">{pkg.season.caveat}</span>
          </div>
        </div>

        <div class="budget-panel">
          <div class="budget-panel-top">
            <span class="budget-badge">{PRICE_LABEL}</span>
            <span class="budget-review">Reviewed {REVIEW_DATE}</span>
          </div>

          {pkg.quoteOnlyOnCard && pkg.quoteOnlyReason && (
            <p class="quote-only-banner">
              <strong>Route validation note:</strong> {pkg.quoteOnlyReason}
            </p>
          )}

          <div class="tier-ranges-grid">
            {TIERS.map((tier) => (
              <div class:list={['tier-range-col', { 'is-comfort': tier.id === 'comfort' }]}>
                <span class="tier-col-label">{tier.label}</span>
                <strong class="tier-col-val">{formatRange(pkg.budget[tier.id])}</strong>
                <small class="tier-col-note">{tier.assumption}</small>
              </div>
            ))}
          </div>

          <p class="budget-basis-line">
            <strong>Basis:</strong> {PRICE_BASIS_SHORT}. Accommodation/breakfast and core private ground transport assumed; most entry, safari/park/jeep, rail and optional activity fees excluded unless confirmed in a written quote.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Route Overview & Interactive Day-by-Day Itinerary -->
    <section id="itinerary" class="detail-section" aria-labelledby="itinerary-heading">
      <div class="container">
        <div class="detail-layout">
          <div class="detail-main-col">
            <div class="overview-card">
              <p class="section-eyebrow">01 · Route Overview</p>
              <h2 id="itinerary-heading">How this {pkg.days}-day journey is paced</h2>
              {pkg.overview.map((para) => (
                <p class="overview-para">{para}</p>
              ))}
            </div>

            <PackageItinerary pkg={pkg} />
          </div>

          <div class="detail-side-col">
            <PackageRouteSketch pkg={pkg} />

            {pkg.seasonalAlternatives.length > 0 && (
              <aside class="seasonal-alt-card" aria-labelledby="seasonal-alt-heading">
                <span class="side-eyebrow">Month &amp; Pacing Adjustments</span>
                <h3 id="seasonal-alt-heading">Seasonal &amp; route alternatives</h3>
                <div class="alt-list">
                  {pkg.seasonalAlternatives.map((alt) => (
                    <div class="alt-item">
                      <h4>{alt.title}</h4>
                      <p class="alt-when"><strong>When:</strong> {alt.when}</p>
                      <p class="alt-text">{alt.text}</p>
                      <p class="alt-impact"><strong>Impact:</strong> {alt.impact}</p>
                    </div>
                  ))}
                </div>
              </aside>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Practical Details: Lodging, Transport, Guides, Accessibility & Family -->
    <section id="practical-details" class="detail-section detail-section-alt" aria-labelledby="practical-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-eyebrow">02 · Practical Ground Realities</p>
            <h2 id="practical-heading">Accommodation, transport, guides &amp; suitability</h2>
          </div>
          <p class="section-subcopy">
            What is assumed in this planning concept and what we confirm with you before issuing a date-specific quote.
          </p>
        </div>

        <div class="practical-grid">
          <article class="practical-card">
            <h3>Lodging &amp; overnight bases</h3>
            <p>{pkg.practical.lodging}</p>
          </article>

          <article class="practical-card">
            <h3>Private transport &amp; transfers</h3>
            <p>{pkg.practical.transport}</p>
          </article>

          <article class="practical-card">
            <h3>Driver vs. licensed guides</h3>
            <p>{pkg.practical.guide}</p>
          </article>

          <article class="practical-card">
            <h3>Physical effort &amp; accessibility</h3>
            <p>{pkg.practical.access}</p>
          </article>

          <article class="practical-card">
            <h3>Children &amp; family travel</h3>
            <p>{pkg.practical.familyNote}</p>
          </article>

          <article class="practical-card">
            <h3>Seasonal &amp; wildlife caveats</h3>
            <p>{pkg.season.caveat}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- 5. Inclusions, Optional Extras & Exclusions -->
    <section id="inclusions" class="detail-section" aria-labelledby="inclusions-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-eyebrow">03 · Transparent Cost Treatment</p>
            <h2 id="inclusions-heading">What the indicative planning budget covers</h2>
          </div>
          <p class="section-subcopy">
            {PRICE_DISCLAIMER}
          </p>
        </div>

        <div class="costs-columns">
          <div class="cost-col cost-col-included">
            <div class="cost-col-header">
              <span class="std-pill std-pill-included">{costStatusLabel.included}</span>
              <h3>Assumed in planning range</h3>
            </div>
            <ul>
              {includedCosts.map((c) => (
                <li>
                  <strong>{c.label}</strong>
                  {c.note && <p>{c.note}</p>}
                </li>
              ))}
            </ul>
          </div>

          <div class="cost-col cost-col-optional">
            <div class="cost-col-header">
              <span class="std-pill std-pill-optional">{costStatusLabel.optional}</span>
              <h3>Optional extras (quoted on request)</h3>
            </div>
            <ul>
              {optionalCosts.map((c) => (
                <li>
                  <strong>{c.label}</strong>
                  {c.note && <p>{c.note}</p>}
                </li>
              ))}
            </ul>
          </div>

          <div class="cost-col cost-col-excluded">
            <div class="cost-col-header">
              <span class="std-pill std-pill-excluded">{costStatusLabel.excluded}</span>
              <h3>Excluded unless stated in quote</h3>
            </div>
            <ul>
              {excludedCosts.map((c) => (
                <li>
                  <strong>{c.label}</strong>
                  {c.note && <p>{c.note}</p>}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="basis-recap-box">
          <div>
            <h4>Summary of planning basis (reviewed {REVIEW_DATE})</h4>
            <ul>
              {PRICE_BASIS_POINTS.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </div>
          <div>
            <h4>Official references</h4>
            <ul>
              {officialLinks.map((l) => (
                <li>
                  <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} &nearr;</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Quote Enquiry Form -->
    <div class="detail-section detail-section-alt">
      <div class="container">
        <PackageEnquiryForm selectedPackage={pkg} />
      </div>
    </div>

    <!-- 7. FAQs & Image Credits Ledger -->
    <section id="faq" class="detail-section" aria-labelledby="detail-faq-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="section-eyebrow">04 · Practical Questions</p>
            <h2 id="detail-faq-heading">Questions about {pkg.title}</h2>
          </div>
        </div>

        <div class="faq-grid">
          {allFaqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>

        <details class="credits-ledger-details">
          <summary>Image rights &amp; attribution ledger ({usedImages.length} verified photos)</summary>
          <ul class="credits-list">
            {usedImages.map((img) => (
              <li>
                <strong>{img.subject}:</strong> Photo by {img.creator} via {img.platform} —{' '}
                <a href={img.licenseUrl} target="_blank" rel="noopener noreferrer">{img.license}</a>{' '}
                (<a href={img.sourceUrl} target="_blank" rel="noopener noreferrer">source</a>;{' '}
                recorded in <code>{img.ledger}</code>).
                {img.note ? ` ${img.note}` : ''}
              </li>
            ))}
          </ul>
        </details>
      </div>
    </section>

    <!-- 8. Related Packages -->
    {relatedPackages.length > 0 && (
      <section class="detail-section detail-section-alt" aria-labelledby="related-pkg-heading">
        <div class="container">
          <div class="section-header">
            <div>
              <p class="section-eyebrow">05 · Compare Starting Points</p>
              <h2 id="related-pkg-heading">Related Sri Lanka itineraries</h2>
            </div>
            <a href="/packages/" class="back-all-link">
              &larr; View all 12 launch itineraries
            </a>
          </div>

          <div class="related-grid">
            {relatedPackages.map((rel) => (
              <PackageCard pkg={rel} />
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  function initPackageDetailPage() {
    const page = document.querySelector<HTMLElement>('[data-pkg-detail-page]');
    if (!page) return;

    const modeBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-itinerary-mode]'));
    const dayPills = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-day-pill]'));
    const dayCards = Array.from(page.querySelectorAll<HTMLElement>('[data-day-card]'));
    const statusText = page.querySelector<HTMLElement>('[data-itinerary-status]');
    const stepperBar = page.querySelector<HTMLElement>('[data-focus-stepper]');
    const prevBtn = page.querySelector<HTMLButtonElement>('[data-step-prev]');
    const nextBtn = page.querySelector<HTMLButtonElement>('[data-step-next]');
    const showAllBtn = page.querySelector<HTMLButtonElement>('[data-step-show-all]');

    const sketchStopItems = Array.from(page.querySelectorAll<HTMLElement>('[data-sketch-stop]'));
    const sketchMarkers = Array.from(page.querySelectorAll<SVGElement>('[data-sketch-marker]'));
    const sketchSelectBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-sketch-select-day]'));
    const sketchCaption = page.querySelector<HTMLElement>('[data-sketch-active-caption]');

    if (!dayCards.length) return;

    let mode: 'all' | 'focus' = 'all';
    let selectedIdx = 0;

    function syncSketch(activeMapStop: string, activeDayLabel: string) {
      sketchStopItems.forEach((item) => {
        const isMatch = item.dataset.sketchStop === activeMapStop;
        item.classList.toggle('is-active', isMatch);
      });
      sketchMarkers.forEach((marker) => {
        const isMatch = marker.dataset.sketchMarker === activeMapStop;
        marker.classList.toggle('is-active', isMatch);
      });
      if (sketchCaption && activeMapStop) {
        const matchingItem = sketchStopItems.find((i) => i.dataset.sketchStop === activeMapStop);
        const stopName = matchingItem?.querySelector('strong')?.textContent || activeMapStop;
        sketchCaption.innerHTML = `Highlighted stop: <strong>${stopName}</strong> (${activeDayLabel})`;
      }
    }

    function updateView(scrollIntoView = false) {
      modeBtns.forEach((btn) => {
        const isCurrent = btn.dataset.itineraryMode === mode;
        btn.classList.toggle('is-active', isCurrent);
        btn.setAttribute('aria-pressed', String(isCurrent));
      });

      dayPills.forEach((pill, idx) => {
        const isCurrent = idx === selectedIdx;
        pill.classList.toggle('is-selected', isCurrent);
        pill.setAttribute('aria-pressed', String(isCurrent));
      });

      dayCards.forEach((card, idx) => {
        const isCurrent = idx === selectedIdx;
        card.classList.toggle('is-selected', isCurrent);
        card.hidden = mode === 'focus' && !isCurrent;
      });

      if (stepperBar) {
        stepperBar.hidden = mode !== 'focus';
      }
      if (prevBtn) {
        prevBtn.disabled = selectedIdx <= 0;
      }
      if (nextBtn) {
        nextBtn.disabled = selectedIdx >= dayCards.length - 1;
      }

      const activeCard = dayCards[selectedIdx];
      const activeDayLabel = activeCard?.dataset.dayLabel || `Stage ${selectedIdx + 1}`;
      const activeTitle = activeCard?.querySelector('.day-title')?.textContent || '';
      const activeMapStop = activeCard?.dataset.mapStop || '';

      if (statusText) {
        if (mode === 'focus') {
          statusText.textContent = `Focused on ${activeDayLabel} of ${dayCards.length} stages: ${activeTitle}`;
        } else {
          statusText.textContent = `Showing all ${dayCards.length} stages. Selected highlight: ${activeDayLabel} — ${activeTitle}`;
        }
      }

      syncSketch(activeMapStop, activeDayLabel);

      if (scrollIntoView && activeCard) {
        activeCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        mode = (btn.dataset.itineraryMode as 'all' | 'focus') || 'all';
        updateView(false);
      });
    });

    dayPills.forEach((pill, idx) => {
      pill.addEventListener('click', () => {
        selectedIdx = idx;
        updateView(mode === 'all');
      });

      pill.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const next = (idx + 1) % dayPills.length;
          selectedIdx = next;
          dayPills[next]?.focus();
          updateView(false);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = (idx - 1 + dayPills.length) % dayPills.length;
          selectedIdx = prev;
          dayPills[prev]?.focus();
          updateView(false);
        }
      });
    });

    sketchSelectBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetIdx = Number(btn.dataset.sketchSelectDay ?? '0');
        if (!Number.isNaN(targetIdx) && targetIdx >= 0 && targetIdx < dayCards.length) {
          selectedIdx = targetIdx;
          updateView(true);
        }
      });
    });

    prevBtn?.addEventListener('click', () => {
      if (selectedIdx > 0) {
        selectedIdx -= 1;
        updateView(true);
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (selectedIdx < dayCards.length - 1) {
        selectedIdx += 1;
        updateView(true);
      }
    });

    showAllBtn?.addEventListener('click', () => {
      mode = 'all';
      updateView(false);
    });
  }

  initPackageDetailPage();
</script>

<style>
  .pkg-detail-page {
    background: var(--color-ivory, #F6F1E7);
    color: var(--color-charcoal, #263238);
    min-height: 100vh;
  }

  .container {
    width: min(100%, 84rem);
    margin-inline: auto;
    padding-inline: clamp(1.125rem, 4vw, 2.5rem);
  }

  /* Hero */
  .detail-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #031514;
    color: var(--color-ivory, #F6F1E7);
    padding: calc(5.2rem + clamp(2.5rem, 5vw, 4rem)) clamp(1.125rem, 4vw, 2.5rem) clamp(2.5rem, 4.5vw, 3.5rem);
    border-bottom: 1px solid rgba(246, 241, 231, 0.12);
  }

  .detail-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .detail-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.96) contrast(1.02) brightness(0.82);
    transform: scale(1.02);
    display: block;
  }

  .detail-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 82% 18%, rgba(217, 154, 69, 0.14), transparent 34rem),
      linear-gradient(96deg, rgba(2, 16, 15, 0.9) 0%, rgba(4, 28, 26, 0.76) 52%, rgba(3, 20, 19, 0.62) 100%),
      linear-gradient(180deg, rgba(2, 14, 13, 0.6) 0%, transparent 38%, rgba(3, 20, 19, 0.92) 100%);
  }

  .breadcrumbs ol {
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: rgba(246, 241, 231, 0.76);
  }

  .breadcrumbs a {
    color: rgba(246, 241, 231, 0.9);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-gold-light, #E9C779);
    text-decoration: underline;
  }

  .detail-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 0.85rem;
    color: #f0d48d;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .detail-eyebrow::before {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #e9c66f;
    content: '';
  }

  .detail-hero h1 {
    margin: 0;
    max-width: 22ch;
    font: 500 var(--text-hero-subpage, clamp(2.15rem, 3.8vw, 3.25rem))/1.1 var(--font-serif);
    letter-spacing: -0.03em;
    color: #fbf8f0;
    text-wrap: balance;
  }

  .detail-promise {
    margin: 1rem 0 0;
    max-width: 52ch;
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    line-height: 1.7;
    color: rgba(250, 248, 240, 0.82);
  }

  .detail-hero-actions {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    background: var(--color-amber, #D99A45);
    color: #162220;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-cta-primary:hover {
    background: #e6a955;
  }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    border: 1px solid rgba(246, 241, 231, 0.3);
    background: rgba(10, 48, 46, 0.65);
    color: var(--color-ivory, #F6F1E7);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hero-cta-secondary:hover {
